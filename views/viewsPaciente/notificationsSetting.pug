doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SIGCMI - Configuración de Notificaciones
    link(rel="stylesheet", href="/patient/css/output.css")

  body(class="bg-slate-50 font-sans antialiased min-h-screen")

    //- 1. SIDEBAR FIJO
    include ../includes/sidebar

    //- 2. CONTENEDOR PRINCIPAL CON MARGEN IZQUIERDO PARA EL SIDEBAR
    div(class="pl-[314px] [@media(max-width:768px)]:pl-0 transition-all duration-300 flex flex-col min-h-screen")

      //- HEADER SUPERIOR
      header(class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center shadow-2xs")
        div
          h1(class="text-2xl font-bold text-slate-800") Portal del Paciente
          p(class="text-xs text-slate-500 mt-0.5")
            span(class="font-medium text-slate-700")
              script.
                const options = { year: 'numeric', month: 'long', day: 'numeric' };
                document.write(new Date().toLocaleDateString('es-CO', options));

      //- CONTENIDO PRINCIPAL
      main(class="flex-1 overflow-y-auto p-8 bg-slate-200")
        form(action="/paciente/notifications" method="POST")

          //- Tarjeta Contenedora Principal
          div(class="bg-slate-100 rounded-2xl border border-slate-200 shadow-2xs p-6 lg:p-8 max-w-5xl mx-auto")
            div(class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-8")

              //- =========================================================
              //- COLUMNA IZQUIERDA
              //- =========================================================
              div(class="space-y-8")

                //- ---------- Canales de Notificación ----------
                section(class="space-y-4")
                  div(class="flex items-center gap-2")
                    svg(class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                      path(stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z")
                    h2(class="text-lg font-bold text-slate-900") Canales de Notificación

                  //- Correo Electrónico
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div(class="flex items-center gap-3")
                      div(class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center")
                        svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                          path(stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75")
                      div
                        p(class="text-sm font-bold text-slate-800") Correo Electrónico
                        p(class="text-xs text-slate-500") Recibe notificaciones por email
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="email_channel" class="sr-only peer" checked=correo)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- SMS
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div(class="flex items-center gap-3")
                      div(class="w-9 h-9 rounded-lg bg-slate-200 text-slate-500 flex items-center justify-center")
                        svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                          path(stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z")
                      div
                        p(class="text-sm font-bold text-slate-800") SMS
                        p(class="text-xs text-slate-500") Recibe mensajes de texto
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="sms_channel" class="sr-only peer" checked=sms)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- WhatsApp
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div(class="flex items-center gap-3")
                      div(class="w-9 h-9 rounded-lg bg-green-50 text-green-600 flex items-center justify-center")
                        svg(class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24")
                          path(d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z")
                      div
                        p(class="text-sm font-bold text-slate-800") WhatsApp
                        p(class="text-xs text-slate-500") Recibe mensajes por WhatsApp
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="whatsapp_channel" class="sr-only peer" checked=whatsapp)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                //- ---------- Recordatorios de citas ----------
                section(class="space-y-4")
                  div(class="flex items-center gap-2")
                    svg(class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                      path(stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z")
                    h2(class="text-lg font-bold text-slate-900") Recordatorios de citas

                  //- Recordatorio 24 horas antes
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div(class="flex items-center gap-3")
                      div(class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center")
                        svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                          path(stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5")
                      div
                        p(class="text-sm font-bold text-slate-800") Recordatorio 24 horas antes
                        p(class="text-xs text-slate-500") Un día antes de tu cita
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="recordatorio_24h" class="sr-only peer" checked=recordatorio_24h)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- Recordatorio 1 hora antes
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div(class="flex items-center gap-3")
                      div(class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center")
                        svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                          path(stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z")
                      div
                        p(class="text-sm font-bold text-slate-800") Recordatorio 1 hora antes
                        p(class="text-xs text-slate-500") Una hora antes de tu cita
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="recordatorio_1h" class="sr-only peer" checked=recordatorio_1h)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

              //- =========================================================
              //- COLUMNA DERECHA
              //- =========================================================
              div(class="flex flex-col")

                //- ---------- Notificaciones de Eventos ----------
                section(class="space-y-4")
                  div(class="flex items-center gap-2")
                    div(class="w-6 h-6 rounded-md bg-indigo-500 text-white flex items-center justify-center flex-shrink-0")
                      svg(class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24")
                        path(d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z")
                    h2(class="text-lg font-bold text-slate-900") Notificaciones de Eventos

                  //- Confirmación de citas
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div
                      p(class="text-sm font-bold text-slate-800") Confirmación de citas
                      p(class="text-xs text-slate-500") Cuando se confirme una cita
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="evento_confirmacion" class="sr-only peer" checked=confirmacion_cita)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- Cancelación de citas
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div
                      p(class="text-sm font-bold text-slate-800") Cancelación de citas
                      p(class="text-xs text-slate-500") Cuando se cancele una cita
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="evento_cancelacion" class="sr-only peer" checked=cancelacion_cita)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- Reprogramación de citas
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div
                      p(class="text-sm font-bold text-slate-800") Reprogramación de citas
                      p(class="text-xs text-slate-500") Cuando se reprograme una cita
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="evento_reprogramacion" class="sr-only peer" checked=reprogramacion)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                  //- Nuevos diagnósticos
                  div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-200")
                    div
                      p(class="text-sm font-bold text-slate-800") Nuevos diagnósticos
                      p(class="text-xs text-slate-500") Cuando haya un nuevo diagnóstico
                    label(class="relative inline-flex items-center cursor-pointer")
                      input(type="checkbox" name="evento_diagnostico" class="sr-only peer" checked=nuevo_diagnostico)
                      div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

                //- ---------- Bloque inferior: info + botones ----------
                div(class="mt-auto pt-8 space-y-6")

                  //- Información importante
                  div(class="rounded-xl border border-indigo-100 bg-indigo-50 p-4")
                    div(class="flex items-center gap-2 mb-1.5")
                      svg(class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z")
                      p(class="text-sm font-bold text-indigo-900") Información importante
                    p(class="text-xs text-indigo-700/80 leading-relaxed") Las notificaciones te ayudan a estar informado sobre tus citas y diagnósticos. Puedes cambiar estas preferencias en cualquier momento.

                  //- Botones de acción
                  div(class="flex items-center justify-end gap-3")
                    a(href="/paciente/dashboard" class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl font-bold text-sm text-slate-700 bg-slate-200 hover:bg-slate-300 transition-colors") Cancelar
                    button(type="submit" class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl font-bold text-sm text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-sm") Guardar Cambios

          script(src="/patient/js/notifications.js")
