doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SIGCMI - Configuración de Notificaciones
    link(rel="stylesheet", href="/patient/css/output.css")

  body(class="bg-slate-50 font-sans antialiased min-h-screen")

    //- 1. SIDEBAR FIJO
    include ../includes/sidebar

    //- 2. CONTENEDOR PRINCIPAL CON MARGEN IZQUIERDO PARA EL SIDEBAR
    div(class="pl-[314px] [@media(max-width:768px)]:pl-0 transition-all duration-300 flex flex-col min-h-screen")
      
      //- HEADER SUPERIOR
      header(class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center shadow-2xs")
        div
          h1(class="text-2xl font-bold text-slate-800") Portal del Paciente
          p(class="text-xs text-slate-500 mt-0.5") 
            span(class="font-medium text-slate-700") 
              script.
                const options = { year: 'numeric', month: 'long', day: 'numeric' };
                document.write(new Date().toLocaleDateString('es-CO', options));

      //- Contenido principal dentro de tu vista actual (manteniendo tu sidebar y header intactos)
      main(class="flex-1 overflow-y-auto p-8")
        form(action="/paciente/notifications" method="POST")
    
          //- Tarjeta Contenedora Principal
          div(class="bg-white rounded-2xl border border-slate-200 shadow-2xs p-6 lg:p-8 max-w-4xl")
      
            //- Bloque 1: Canales de Notificación
            div(class="space-y-4")
              h2(class="text-lg font-bold text-slate-900") Canales de Notificación
              p(class="text-xs text-slate-500 mb-4") Elige por dónde deseas recibir las alertas del sistema.

              //- Correo Electrónico
              div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-50/50")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center")
                    svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                      path(stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75")
                  div
                    p(class="text-sm font-bold text-slate-800") Correo Electrónico
                    p(class="text-xs text-slate-500") Recibe notificaciones por email
                label(class="relative inline-flex items-center cursor-pointer")
                  input(type="checkbox" name="email_channel" class="sr-only peer" checked)
                  div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

              //- SMS
              div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-50/50")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center")
                    svg(class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8")
                      path(stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z")
                  div
                    p(class="text-sm font-bold text-slate-800") SMS
                    p(class="text-xs text-slate-500") Recibe mensajes de texto
                label(class="relative inline-flex items-center cursor-pointer")
                  input(type="checkbox" name="sms_channel" class="sr-only peer")
                  div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

              //- WhatsApp
              div(class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-50/50")
                div(class="flex items-center gap-3")
                  div(class="w-9 h-9 rounded-lg bg-green-50 text-green-600 flex items-center justify-center")
                    svg(class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24")
                      path(d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z")
                  div
                    p(class="text-sm font-bold text-slate-800") WhatsApp
                    p(class="text-xs text-slate-500") Recibe mensajes por WhatsApp
                label(class="relative inline-flex items-center cursor-pointer")
                  input(type="checkbox" name="whatsapp_channel" class="sr-only peer" checked)
                  div(class="w-11 h-6 bg-slate-300 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600")

          script(src="/patient/js/notifications.js")