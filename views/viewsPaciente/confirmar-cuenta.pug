doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")

        title= pagina + " | SIGCMI"

        link(rel="stylesheet", href="/paciente/css/output.css")
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    
    body(class="min-h-screen bg-gradient-to-br from-cyan-100 via-sky-50 to-teal-100 flex items-center justify-center p-4 sm:p-6")

        div(class="w-full max-w-sm sm:max-w-lg md:max-w-xl bg-white rounded-2xl md:rounded-3xl shadow-xl md:shadow-2xl overflow-hidden")

            div(class="bg-gradient-to-r from-cyan-700 to-teal-600 text-white text-center px-6 py-8 md:py-10")

                h1(class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-wide")
                    | SIGCMI

                p(class="mt-2 md:mt-3 text-cyan-100 text-sm sm:text-base md:text-lg")
                    | Sistema Integral de Gestión de Citas Médicas Inteligentes

            div(class="p-6 sm:p-8 md:p-10 text-center")

                if error

                    div(class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 mx-auto rounded-full bg-red-100 flex items-center justify-center mb-6 md:mb-8")
                        i(class="fa-solid fa-circle-xmark text-red-600 text-4xl sm:text-5xl md:text-6xl")

                else

                    div(class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 mx-auto rounded-full bg-green-100 flex items-center justify-center mb-6 md:mb-8")
                        i(class="fa-solid fa-circle-check text-green-600 text-4xl sm:text-5xl md:text-6xl")

                h2(class="text-2xl sm:text-3xl font-bold text-slate-800")
                    = pagina

                p(class="mt-4 md:mt-6 text-gray-600 text-base sm:text-lg leading-7 md:leading-8")
                    = mensaje

                if !error

                    a(
                        href="/auth/login"
                        class="mt-8 md:mt-10 inline-flex w-full sm:w-auto items-center justify-center gap-3 bg-teal-600 hover:bg-teal-700 transition duration-300 text-white font-semibold px-6 md:px-8 py-3 md:py-4 rounded-xl shadow-lg"
                    )
                        i(class="fa-solid fa-right-to-bracket")
                        | Iniciar Sesión

                else

                    a(
                        href="/auth/register"
                        class="mt-8 md:mt-10 inline-flex w-full sm:w-auto items-center justify-center gap-3 bg-red-600 hover:bg-red-700 transition duration-300 text-white font-semibold px-6 md:px-8 py-3 md:py-4 rounded-xl shadow-lg"
                    )
                        i(class="fa-solid fa-user-plus")
                        | Crear otra cuenta

            div(class="bg-gray-50 border-t py-4 md:py-6 text-center")

                p(class="text-gray-500 text-xs sm:text-sm")
                    | © 2026 SIGCMI · Todos los derechos reservados