
extends ./layout

block content
  .flex.min-h-screen.bg-slate-100.text-slate-800
    aside#patientSidebar(class="flex min-h-screen w-64 shrink-0 flex-col bg-indigo-600 p-3 text-white transition-all duration-300")
      .mb-7.flex.items-center.justify-between.gap-3
        a#sidebarBrand.text-2xl.font-bold.text-white(href="/paciente/dashboard") SIGCMI
        button#btnMenuPaciente.rounded-lg.bg-indigo-500.px-3.py-2.text-white(type="button" aria-label="Contraer menú" aria-expanded="true")
          span ☰

      .flex.flex-col.items-start.gap-2.border-b.border-indigo-400.pb-6
        .grid.h-12.w-12.place-items-center.rounded-full.bg-indigo-400.text-xl.text-white(aria-hidden="true") ♟
        .flex.flex-col.gap-1
          span.text-sm.text-indigo-100 Bienvenido
          strong.font-semibold #{paciente.nombre}
          small.text-sm.text-indigo-100 Paciente
        a.text-sm.font-medium.text-white.underline(href="/paciente/perfil") Ver Mi Perfil

      nav.mt-6.flex.flex-col.gap-2(aria-label="Navegación del paciente")
        a.flex.items-center.gap-3.rounded-lg.bg-indigo-500.p-3.font-medium.text-white(href="#misCitas")
          span.sidebar-icon(aria-hidden="true") ▦
          span.sidebar-label Mis Citas

        a(href="#misDiagnosticos" class="flex items-center gap-3 rounded-lg p-3 text-indigo-100 hover:bg-indigo-500")
          span.sidebar-icon(aria-hidden="true") ▤
          span.sidebar-label Mis Diagnósticos

        a(href="/paciente/notificaciones/configuracion" class="flex items-center gap-3 rounded-lg p-3 text-indigo-100 hover:bg-indigo-500")
          span.sidebar-icon(aria-hidden="true") ⚙
          span.sidebar-label Notificaciones

      .mt-auto.border-t.border-indigo-400.pt-5
        form(action="/auth/logout" method="POST")
          button(class="flex w-full items-center gap-3 rounded-lg p-3 text-left text-white hover:bg-indigo-500" type="submit")
            span.sidebar-icon(aria-hidden="true") ⇥
            span.sidebar-label Cerrar Sesión

    div(class="min-w-0 flex-1 p-4 md:p-8")
      header.mb-6.border-b.border-slate-200.pb-4
        h1.text-2xl.font-bold.text-slate-900 Portal del Paciente
        p.mt-2.text-slate-500= new Date().toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Bogota' })

      div(class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[minmax(0,1fr)_225px]")
        main#misCitas.rounded-lg.border.border-slate-200.bg-white.p-3.shadow-sm
          .rounded-md.border.border-slate-200.bg-blue-50.p-4
            h2.mb-4.text-lg.font-semibold Mis Citas

            if !citas || citas.length === 0
              .flex.min-h-64.flex-col.items-center.justify-center.py-10.text-center.text-slate-500
                span.text-3xl(aria-hidden="true") ▦
                p.mt-4 No tienes citas registradas.
            else
              .flex.flex-col.gap-4
                each cita in citas
                  article.flex.flex-wrap.items-center.gap-3.rounded-xl.border.border-slate-300.bg-white.p-3
                    .grid.h-10.w-10.shrink-0.place-items-center.rounded-lg.bg-blue-100.text-xl.text-indigo-800(aria-hidden="true") ▦

                    .min-w-0.flex-1
                      p.text-sm.font-semibold.text-slate-900 #{cita.fecha}
                      p.text-xs.text-slate-600 #{cita.hora}#{cita.consultorio ? ` - ${cita.consultorio}` : ''}
                      p.mt-1.text-xs.text-slate-800 #{cita.doctor}

                    .flex.flex-col.items-end.gap-2
                      span.rounded-full.bg-blue-100.px-3.py-1.text-xs.font-medium.text-blue-800 #{cita.estado}
                      a.text-xs.text-indigo-600(href=`/citas/${cita.id}/reprogramar`) Reprogramar
                      a.text-xs.text-red-600(href=`/citas/${cita.id}/cancelar`) Cancelar

        aside.flex.flex-col.gap-3
          section.flex.flex-col.gap-3.rounded-lg.border.border-slate-200.bg-white.p-4.shadow-sm
            button#btnNuevaCita(class="flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-3 py-4 font-semibold text-white hover:bg-indigo-700" type="button")
              span.text-xl(aria-hidden="true") +
              span Nueva Cita Web

            a(class="flex w-full items-center justify-center gap-2 rounded-lg bg-green-100 px-3 py-4 text-center font-semibold text-green-800 hover:bg-green-200" href="https://wa.me/" target="_blank" rel="noopener noreferrer")
              span(aria-hidden="true") ◉
              span Agendar Por WhatsApp

          section.rounded-lg.bg-indigo-600.p-3.text-white
            h2.mb-3.font-semibold
              span.mr-2(aria-hidden="true") ◷
              | Mi Próxima Cita

            if citas && citas.length > 0
              .flex.flex-col.gap-2.rounded-lg.bg-indigo-500.p-3
                strong.text-sm #{citas[0].fecha}
                b.text-sm #{citas[0].doctor}
                if citas[0].consultorio
                  small.text-xs.text-indigo-100 #{citas[0].consultorio}
            else
              .flex.flex-col.gap-2.rounded-lg.bg-indigo-500.p-3
                strong.text-sm No tienes citas próximas
                small.text-xs.text-indigo-100 Tus citas aparecerán aquí.

          section.rounded-lg.bg-indigo-50.p-3.text-sm.text-slate-600
            p Nuestro equipo está disponible para asistirte
            p.mt-4.break-words
              span.mr-2(aria-hidden="true") ☎
              | +57 313 745 8332
            p.mt-3.break-words
              span.mr-2(aria-hidden="true") ✉
              | soporte@sigcmi.com
            p.mt-3
              span.mr-2(aria-hidden="true") ◷
              | Lunes-Viernes 8:00-20:00

  script.
    (() => {
      const sidebar = document.getElementById('patientSidebar');
      const toggle = document.getElementById('btnMenuPaciente');
      const brand = document.getElementById('sidebarBrand');

      if (sidebar && toggle) {
        toggle.addEventListener('click', () => {
          const collapsed = sidebar.classList.contains('w-20');

          sidebar.classList.toggle('w-64', collapsed);
          sidebar.classList.toggle('w-20', !collapsed);

          sidebar.querySelectorAll('.sidebar-label').forEach((label) => {
            label.classList.toggle('hidden', !collapsed);
          });

          if (brand) {
            brand.classList.toggle('hidden', !collapsed);
          }

          toggle.setAttribute('aria-expanded', String(collapsed));
          toggle.setAttribute(
            'aria-label',
            collapsed ? 'Contraer menú' : 'Expandir menú'
          );
        });
      }

      const newAppointment = document.getElementById('btnNuevaCita');

      if (newAppointment) {
        newAppointment.addEventListener('click', () => {
          // Appointment scheduling is outside the current task scope.
        });
      }
    })();
