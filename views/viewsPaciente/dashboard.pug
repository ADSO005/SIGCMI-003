extends layout

block content
  .patient-app
    aside.patient-sidebar
      .sidebar-brand
        a.brand-name(href="/paciente/dashboard") SIGCMI
        button#btnMenuPaciente.menu-toggle(type="button" aria-label="Mostrar u ocultar menú" aria-expanded="true")
          span ☰
      .patient-profile
        .avatar(aria-hidden="true") ♟
        .profile-copy
          span.profile-welcome Bienvenido
          strong #{paciente.nombre}
          small Paciente
        a.profile-button(href="/paciente/perfil") Ver Mi Perfil
      nav.sidebar-nav(aria-label="Navegación del paciente")
        a.nav-item.active(href="#misCitas")
          span.nav-icon(aria-hidden="true") ▦
          | Mis Citas
        a.nav-item(href="#misDiagnosticos")
          span.nav-icon(aria-hidden="true") ▤
          | Mis Diagnósticos
        a.nav-item(href="/paciente/notificaciones/configuracion")
          span.nav-icon(aria-hidden="true") ⚙
          | Notificaciones
      .sidebar-footer
        form(action="/auth/logout" method="POST")
          button.logout-button(type="submit")
            span.nav-icon(aria-hidden="true") ⇥
            | Cerrar Sesión

    .patient-main
      header.page-header
        div
          h1 Portal del Paciente
          p= new Date().toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Bogota' })
      .dashboard-grid
        main.appointments-panel#misCitas
          .appointments-inner
            h2 Mis Citas
            if !citas || citas.length === 0
              .empty-appointments
                span.empty-icon(aria-hidden="true") ▦
                p No tienes citas registradas.
            else
              .appointment-list
                each cita in citas
                  article.appointment-card
                    .appointment-icon(aria-hidden="true") ▦
                    .appointment-info
                      p.appointment-date #{cita.fecha}
                      p.appointment-time #{cita.hora}#{cita.consultorio ? ` - ${cita.consultorio}` : ''}
                      p.appointment-doctor #{cita.doctor}
                    .appointment-actions
                      span(class=`status-pill status-${String(cita.estado || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}`) #{cita.estado}
                      a.reschedule-link(href=`/citas/${cita.id}/reprogramar`) Reprogramar
                      a.cancel-link(href=`/citas/${cita.id}/cancelar`) Cancelar
        aside.right-column
          section.action-panel#accionesCita
            button.new-appointment(type="button" id="btnNuevaCita")
              span.action-symbol(aria-hidden="true") +
              span Nueva Cita Web
            a.whatsapp-button(href="https://wa.me/" target="_blank" rel="noopener noreferrer")
              span.whatsapp-symbol(aria-hidden="true") ◉
              span Agendar Por WhatsApp
          section.next-appointment
            h2
              span(aria-hidden="true") ◷
              | Mi Próxima Cita
            if citas && citas.length > 0
              .next-appointment-details
                strong #{citas[0].fecha}
                b #{citas[0].doctor}
                small #{citas[0].consultorio}
            else
              .next-appointment-details
                strong No tienes citas próximas
                small Tus citas aparecerán aquí.
          section.help-panel#ayuda
            p Nuestro equipo está disponible para asistirte
            p.contact-line
              span(aria-hidden="true") ☎
              | +57 313 745 8332
            p.contact-line
              span(aria-hidden="true") ✉
              | soporte@sigcmi.com
            p.contact-line
              span(aria-hidden="true") ◷
              | Lunes-Viernes&nbsp; 8:00-20:00
  script.
    (() => {
      const sidebar = document.querySelector('.patient-sidebar');
      const toggle = document.getElementById('btnMenuPaciente');
      if (sidebar && toggle) {
        toggle.addEventListener('click', () => {
          const collapsed = sidebar.classList.toggle('is-collapsed');
          toggle.setAttribute('aria-expanded', String(!collapsed));
          toggle.setAttribute('aria-label', collapsed ? 'Mostrar menú' : 'Ocultar menú');
        });
      }
      const newAppointment = document.getElementById('btnNuevaCita');
      if (newAppointment) {
        newAppointment.addEventListener('click', () => {
          // The appointment scheduling flow is outside the current task scope.
        });
      }
    })();
