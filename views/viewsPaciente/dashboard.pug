
extends layout

block content
  .min-h-screen.bg-slate-50.text-slate-800(class="lg:flex")
    // BARRA LATERAL
    aside.flex.w-full.flex-col.border-r.border-slate-200.bg-white.p-5(class="lg:min-h-screen lg:w-64 lg:shrink-0 lg:p-6")
      a.flex.items-center.gap-3.rounded-xl.p-3(href="/paciente/dashboard")
        .flex.h-11.w-11.items-center.justify-center.rounded-xl.bg-indigo-600.text-xl.font-bold.text-white
          | S
        div
          strong.block.text-lg.font-bold.text-indigo-700 SIGCMI
          span.block.text-xs.text-slate-500 Portal del paciente

      .mt-8.rounded-xl.bg-indigo-50.p-4
        .flex.items-center.gap-3
          .flex.h-11.w-11.shrink-0.items-center.justify-center.rounded-full.bg-indigo-100.text-lg.font-bold.text-indigo-700
            i.icon-user
          div.min-w-0
            p.text-xs.text-slate-500 Mi perfil
            p.break-words.font-semibold.text-slate-800 #{paciente.nombre}

        a.mt-4.block.rounded-lg.bg-indigo-600.px-3.py-2.text-center.text-sm.font-semibold.text-white.transition(href="/paciente/perfil" class="hover:bg-indigo-700")
          | Ver mi perfil

      nav.mt-8.flex.flex-col.gap-2(aria-label="Navegación del paciente")
        a.flex.items-center.gap-3.rounded-xl.bg-indigo-600.px-4.py-3.font-semibold.text-white(href="/paciente/dashboard")
          i.icon-home
          | Inicio

        a.flex.items-center.gap-3.rounded-xl.px-4.py-3.text-slate-600.transition(href="#misCitas" class="hover:bg-indigo-50 hover:text-indigo-700")
          i.icon-calendar
          | Mis citas

        button.flex.items-center.gap-3.rounded-xl.px-4.py-3.text-left.text-slate-600(type="button" class="hover:bg-indigo-50 hover:text-indigo-700")
          i.icon-calendar-plus
          | Agendar cita

        button.flex.items-center.gap-3.rounded-xl.px-4.py-3.text-left.text-slate-600(type="button" class="hover:bg-indigo-50 hover:text-indigo-700")
          i.icon-stethoscope
          | Mis diagnósticos

      .mt-6.border-t.border-slate-200.pt-5(class="lg:mt-auto")
        form(action="/auth/logout" method="POST")
          button.flex.w-full.items-center.gap-3.rounded-xl.px-4.py-3.text-left.font-semibold.text-slate-600.transition(type="submit" class="hover:bg-rose-50 hover:text-rose-700")
            i.icon-logout
            | Cerrar sesión

    // CONTENIDO PRINCIPAL
    .min-w-0.flex-1
      header.flex.flex-wrap.items-center.justify-between.gap-4.border-b.border-slate-200.bg-white.p-5(class="sm:p-7")
        div
          p.text-sm.font-semibold.text-indigo-600 Portal del Paciente
          h1.mt-1.text-2xl.font-bold.tracking-tight.text-slate-900(class="sm:text-3xl")
            | ¡Bienvenido/a!
          p.mt-2.text-sm.text-slate-500
            | Hola, #{paciente.nombre}. Aquí puedes consultar tus citas médicas.

        .relative
          button#btnMenuPaciente.flex.items-center.justify-center.gap-2.rounded-xl.border.border-slate-200.bg-white.px-4.py-3.text-sm.font-semibold.text-slate-700(type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menuPaciente" class="hover:bg-indigo-50 hover:text-indigo-700")
            i.icon-menu
            | Menú

          nav#menuPaciente.absolute.right-0.top-14.z-50.hidden.min-w-48.flex-col.gap-1.rounded-xl.border.border-slate-200.bg-white.p-3.text-slate-800.shadow-xl(aria-label="Menú rápido")
            a.rounded-lg.p-3.transition(href="/paciente/dashboard" class="hover:bg-indigo-50") Inicio
            a.rounded-lg.p-3.transition(href="#misCitas" class="hover:bg-indigo-50") Mis citas
            a.rounded-lg.p-3.transition(href="/paciente/perfil" class="hover:bg-indigo-50") Mi perfil

      .grid.grid-cols-1.items-start.gap-6.p-4(class="xl:grid-cols-[minmax(0,1fr)_320px] sm:p-7")
        // COLUMNA CENTRAL
        main.flex.min-w-0.flex-col.gap-6
          section#misCitas.overflow-hidden.rounded-2xl.border.border-slate-200.bg-white.shadow-sm
            .flex.flex-wrap.items-center.justify-between.gap-3.p-5(class="sm:p-6")
              div
                h2.text-xl.font-bold.text-slate-900 Mis citas
                p.mt-1.text-sm.text-slate-500 Consulta el estado de tus citas médicas.
              span.inline-flex.items-center.rounded-full.bg-indigo-50.px-3.py-2.text-sm.font-semibold.text-indigo-700
                | #{citas.length} citas

            if !citas || citas.length === 0
              .mx-5.mb-5.rounded-xl.border.border-dashed.border-slate-300.bg-slate-50.p-8.text-center(class="sm:mx-6")
                .mx-auto.flex.h-14.w-14.items-center.justify-center.rounded-full.bg-indigo-50.text-2xl.text-indigo-600
                  i.icon-calendar
                h3.mt-4.font-semibold.text-slate-800 Aún no tienes citas
                p.mt-2.text-sm.text-slate-500
                  | Cuando tengas citas registradas, aparecerán aquí.
            else
              .overflow-x-auto
                table.w-full.text-left.text-sm
                  thead.bg-indigo-50.text-xs.uppercase.tracking-wide.text-indigo-800
                    tr
                      th.px-5.py-4.font-semibold(class="sm:px-6") Fecha y hora
                      th.px-5.py-4.font-semibold Médico
                      th.px-5.py-4.font-semibold Estado
                  tbody.divide-y.divide-slate-100
                    each cita in citas
                      tr.transition(class="hover:bg-indigo-50/50")
                        td.px-5.py-5.align-top(class="sm:px-6")
                          p.font-semibold.text-slate-800 #{cita.fecha}
                          p.mt-1.text-xs.text-slate-500 #{cita.hora}
                          p.mt-1.text-xs.text-slate-500 #{cita.consultorio}
                        td.px-5.py-5.align-top
                          p.font-medium.text-slate-800 #{cita.doctor}
                        td.px-5.py-5.align-top
                          span.inline-flex.whitespace-nowrap.rounded-full.bg-slate-100.px-3.py-1.text-xs.font-semibold.text-slate-700(class=`badge-${String(cita.estado).toLowerCase()}`)
                            | #{cita.estado}

        // COLUMNA DERECHA
        aside.flex.flex-col.gap-6
          section.rounded-2xl.border.border-slate-200.bg-white.p-5.shadow-sm
            .flex.items-center.gap-3
              .flex.h-12.w-12.items-center.justify-center.rounded-full.bg-indigo-100.text-xl.text-indigo-700
                i.icon-calendar
              div
                h2.font-bold.text-slate-900 Próxima cita
                p.text-xs.text-slate-500 Resumen de tus citas

            if citas && citas.length > 0
              .mt-5.rounded-xl.bg-indigo-50.p-4
                p.text-sm.font-semibold.text-indigo-900 #{citas[0].fecha}
                p.mt-1.text-sm.text-slate-600 #{citas[0].hora}
                p.mt-2.text-sm.text-slate-600 #{citas[0].doctor}
                p.mt-1.text-xs.text-slate-500 #{citas[0].consultorio}
            else
              p.mt-5.text-sm.text-slate-500 No tienes citas programadas.

          // BOTONES VISUALES
          .acciones
            button.btn-primario#btnNuevaCita(type="button")
              span +
              | Nueva Cita Web

            button.btn.btn-whatsapp(type="button")
              i.icon-whatsapp
              | Agendar por WhatsApp

          section.rounded-2xl.border.border-slate-200.bg-white.p-5.shadow-sm
            h2.font-bold.text-slate-900 ¿Necesitas ayuda?
            p.mt-2.text-sm.text-slate-600 Nuestro equipo está disponible para asistirte.
            p.mt-4.flex.items-center.gap-2.text-sm.text-slate-700
              i.icon-phone
              | 3137458332
            p.mt-2.break-words.text-sm.text-slate-700
              i.icon-email
              | herrerayulieth254@gmail.com
            p.mt-2.text-sm.text-slate-500
              i.icon-clock
              | Lunes a viernes, 8:00-20:00

  // MENÚ DESPLEGABLE
  script.
    const btnMenuPaciente = document.getElementById('btnMenuPaciente');
    const menuPaciente = document.getElementById('menuPaciente');

    if (btnMenuPaciente && menuPaciente) {
      btnMenuPaciente.addEventListener('click', () => {
        const abierto = btnMenuPaciente.getAttribute('aria-expanded') === 'true';

        btnMenuPaciente.setAttribute('aria-expanded', String(!abierto));
        menuPaciente.classList.toggle('hidden', abierto);
        menuPaciente.classList.toggle('flex', !abierto);
      });

      document.addEventListener('click', (event) => {
        if (!menuPaciente.contains(event.target) && !btnMenuPaciente.contains(event.target)) {
          menuPaciente.classList.add('hidden');
          menuPaciente.classList.remove('flex');
          btnMenuPaciente.setAttribute('aria-expanded', 'false');
        }
      });

      menuPaciente.querySelectorAll('a').forEach((enlace) => {
        enlace.addEventListener('click', () => {
          menuPaciente.classList.add('hidden');
          menuPaciente.classList.remove('flex');
          btnMenuPaciente.setAttribute('aria-expanded', 'false');
        });
      });
    }
