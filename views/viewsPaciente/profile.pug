extends ./layout

block content
  div(class="min-h-screen bg-blue-50 pb-12")
    // Bar de navegación superior (Encabezado azul)
    header(class="bg-indigo-700 text-white px-6 py-4 flex items-center justify-between shadow-md")
      a(href="/paciente/dashboard" class="flex items-center gap-2 text-lg font-medium hover:opacity-90")
        span ←
        span Mi Perfil

      a(href="/paciente/perfil/editar" class="text-sm font-semibold bg-indigo-800 hover:bg-indigo-900 px-4 py-2 rounded-lg transition")
        | Editar Perfil

    // Contenedor principal
    main(class="max-w-6xl mx-auto mt-8 px-4 grid grid-cols-1 md:grid-cols-2 gap-6")

      // ==========================================
      // COLUMNA IZQUIERDA
      // ==========================================
      div(class="flex flex-col gap-6")

        // Tarjeta de Avatar y Nombre
        div(class="bg-white rounded-2xl p-6 shadow-sm border border-blue-100 text-center flex flex-col items-center")
          div(class="w-24 h-24 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-4xl font-bold mb-4")
            | 👤
          h1(class="text-xl font-bold text-slate-800")
            | #{paciente.nombre || (paciente.nombres + ' ' + paciente.apellidos)}

        // Tarjeta: Información Personal y Cambiar Contraseña
        div(class="bg-white rounded-2xl p-6 shadow-sm border border-blue-100")

          // Subtítulo
          div(class="flex items-center gap-2 mb-4 text-indigo-600 font-semibold text-sm")
            span 👤
            span Información Personal

          // Campos de datos de lectura
          div(class="space-y-3")
            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 👤
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Nombres
                p(class="font-semibold text-slate-800") #{paciente.nombres || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 👤
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Apellidos
                p(class="font-semibold text-slate-800") #{paciente.apellidos || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") ✉
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Correo Electrónico
                p(class="font-semibold text-slate-800") #{paciente.correo || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 📞
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Teléfono
                p(class="font-semibold text-slate-800") #{paciente.telefono || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 📅
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Fecha de Nacimiento
                p(class="font-semibold text-slate-800") #{paciente.fechaNacimiento || 'No registrada'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 💳
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Tipo de Documento
                p(class="font-semibold text-slate-800") #{paciente.tipoDocumento || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 💳
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Número de Documento
                p(class="font-semibold text-slate-800") #{paciente.numeroDocumento || 'No registrado'}

          // Sección de Cambiar Contraseña incorporada abajo
          div(class="mt-6 pt-4 border-t border-slate-100")
            h2(class="text-xs font-bold text-slate-700 mb-1") Cambiar Contraseña ▾
            p(class="text-xs text-slate-400 mb-4")
              | La contraseña debe tener al menos 6 caracteres e incluir una combinación de números, letras y caracteres especiales(!@#$%).

            form(action="/paciente/perfil/cambiar-password" method="POST" class="space-y-3")
              input(
                type="password"
                name="passwordActual"
                placeholder="Contraseña actual*"
                class="w-full bg-blue-50 border border-blue-100 rounded-xl px-4 py-2 text-xs text-slate-700 placeholder-slate-400 outline-none"
              )
              input(
                type="password"
                name="passwordNueva"
                placeholder="Contraseña nueva*"
                class="w-full bg-blue-50 border border-blue-100 rounded-xl px-4 py-2 text-xs text-slate-700 placeholder-slate-400 outline-none"
              )
              input(
                type="password"
                name="confirmarPassword"
                placeholder="Repetir contraseña nueva*"
                class="w-full bg-blue-50 border border-blue-100 rounded-xl px-4 py-2 text-xs text-slate-700 placeholder-slate-400 outline-none"
              )

              button(
                type="submit"
                class="w-full bg-indigo-700 hover:bg-indigo-800 text-white text-xs font-semibold py-2 rounded-xl transition mt-2"
              ) Cambiar Contraseña


      // ==========================================
      // COLUMNA DERECHA
      // ==========================================
      div(class="flex flex-col gap-6")

        // Tarjeta: Información Médica
        div(class="bg-white rounded-2xl p-6 shadow-sm border border-blue-100")
          div(class="flex items-center gap-2 mb-4 text-red-500 font-semibold text-sm")
            span ❤️
            span Información Médica

          div(class="space-y-3")
            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 🩺
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Tipo de Sangre
                p(class="font-semibold text-slate-800") #{paciente.tipoSangre || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 🩺
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Alergias
                p(class="font-semibold text-slate-800") #{paciente.alergias || 'Ninguna'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 📋
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Condiciones Médicas
                p(class="font-semibold text-slate-800") #{paciente.condicionesMedicas || 'Ninguna'}

        // Tarjeta: Dirección de Residencia
        div(class="bg-white rounded-2xl p-6 shadow-sm border border-blue-100")
          div(class="flex items-center gap-2 mb-4 text-indigo-600 font-semibold text-sm")
            span 🏠
            span Dirección de Residencia

          div(class="space-y-3")
            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Dirección de Residencia
                p(class="font-semibold text-slate-800") #{paciente.direccion || 'No registrada'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Departamento
                p(class="font-semibold text-slate-800") #{paciente.departamento || 'No registrado'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Ciudad/Municipio
                p(class="font-semibold text-slate-800") #{paciente.ciudad || 'No registrada'}

        // Tarjeta: Contacto de Emergencia
        div(class="bg-white rounded-2xl p-6 shadow-sm border border-blue-100")
          div(class="flex items-center gap-2 mb-4 text-amber-500 font-semibold text-sm")
            span 📞
            span Contacto de Emergencia

          div(class="space-y-3")
            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 👤
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Nombres
                p(class="font-semibold text-slate-800")
                  | #{paciente.contactoEmergencia && paciente.contactoEmergencia.nombres ? paciente.contactoEmergencia.nombres : '(Nombres)'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 👤
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Apellidos
                p(class="font-semibold text-slate-800")
                  | #{paciente.contactoEmergencia && paciente.contactoEmergencia.apellidos ? paciente.contactoEmergencia.apellidos : '(Apellidos)'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") 📞
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Teléfono
                p(class="font-semibold text-slate-800")
                  | #{paciente.contactoEmergencia && paciente.contactoEmergencia.telefono ? paciente.contactoEmergencia.telefono : 'Ninguno'}

            div(class="flex items-center gap-3 bg-blue-50 p-3 rounded-xl border border-blue-100")
              span(class="text-indigo-500") ✉
              div(class="text-xs")
                p(class="text-slate-500 font-medium") Correo Electrónico
                p(class="font-semibold text-slate-800")
                  | #{paciente.contactoEmergencia && paciente.contactoEmergencia.correo ? paciente.contactoEmergencia.correo : 'usuario@sigcmi.com'}

        // Tarjeta: Seguridad y Privacidad
        div(class="bg-blue-200 rounded-2xl p-5 text-indigo-950 border border-blue-300")
          h3(class="text-xs font-bold mb-1") Seguridad y Privacidad
          p(class="text-xs text-indigo-900 leading-relaxed")
            | Tu información está protegida con los más altos estándares de seguridad. Cualquier modificación requiere confirmación de contraseña para garantizar que solo tú puedas realizar cambios.