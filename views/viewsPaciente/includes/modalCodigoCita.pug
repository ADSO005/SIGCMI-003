#modalCodigoCita(
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tituloCodigoCita"
)
  .w-full.max-w-md.rounded-2xl.bg-white.p-6.shadow-2xl
    h2#tituloCodigoCita.text-xl.font-bold.text-slate-900 Confirma tu identidad
    p#descripcionCodigoCita.mt-2.text-sm.text-slate-600 Ingresa el código de 6 dígitos enviado a tu correo.
    p#errorCodigoCita.mt-3.hidden.rounded-lg.bg-red-50.p-3.text-sm.text-red-700(role="alert")

    form#formCodigoCita.mt-5
      label(for="codigoCitaIdentidad").mb-2.block.text-sm.font-medium.text-slate-700 Código de verificación
      input#codigoCitaIdentidad.w-full.rounded-lg.border.border-slate-300.p-3.text-center.text-lg.tracking-widest(
        type="text"
        name="codigo"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        minlength="6"
        maxlength="6"
        required
      )
      .mt-5.flex.justify-end.gap-3
        button#cancelarCodigoCita.rounded-lg.bg-slate-200.px-4.py-2.font-medium.text-slate-700(type="button") Cancelar
        button#confirmarCodigoCita.rounded-lg.bg-indigo-600.px-4.py-2.font-semibold.text-white(type="submit") Confirmar

#avisoAccionCita(class="fixed bottom-4 left-1/2 z-50 hidden w-11/12 max-w-lg -translate-x-1/2 rounded-xl p-4 text-center text-sm shadow-lg" role="alert")
