#modalInactividad.fixed.inset-0.z-50.hidden.items-center.justify-center.p-4(
  role="dialog"
  aria-modal="true"
  aria-labelledby="tituloModalInactividad"
  aria-describedby="textoModalInactividad"
)
  .patient-idle-modal.w-full.max-w-md.rounded-2xl.bg-white.p-6.shadow-2xl
    h2#tituloModalInactividad.text-xl.font-bold.text-slate-800 ¿Sigues ahí?
    p#textoModalInactividad.mt-3.text-sm.leading-relaxed.text-slate-600
      | Llevas 10 minutos sin actividad. ¿Quieres continuar en el portal o salir de tu cuenta?

    .patient-idle-actions.mt-6.flex.justify-end.gap-3
      button#btnContinuarSesion.rounded-lg.bg-indigo-600.px-4.py-2.text-sm.font-semibold.text-white.transition(
        type="button"
        class="hover:bg-indigo-700"
      ) Sí, continuar

      button#btnSalirPorInactividad.rounded-lg.border.border-slate-300.bg-white.px-4.py-2.text-sm.font-medium.text-slate-700.transition(
        type="button"
        class="hover:bg-slate-50"
      ) Salir
