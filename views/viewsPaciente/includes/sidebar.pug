aside#sidebar.sidebar.group(
  class="fixed top-0 left-0 z-[1000] flex h-screen w-[314px] flex-col bg-[#465DE5] px-6 text-white [&.collapsed]:px-5 transition-all duration-300 ease-[ease] [&.collapsed]:w-[80px] [@media(max-width:768px)]:w-[260px] [@media(max-width:768px)]:-translate-x-full [@media(max-width:768px)]:transition-transform [@media(max-width:768px)]:ease-[cubic-bezier(0.4,0,0.2,1)] [@media(max-width:768px)]:[&.open]:translate-x-0"
)
  .logo(class="flex h-16 shrink-0 items-center justify-between px-2 group-[.collapsed]:justify-center group-[.collapsed]:px-0")
    span.logo-text(class="text-[28px] leading-none font-bold group-[.collapsed]:hidden") SIGCMI
    button#toggleBtn(
      class="flex h-10 w-10 shrink-0 items-center justify-center cursor-pointer border-0 bg-transparent text-[22px] text-white transition-transform duration-200 hover:scale-110"
      onclick="toggleSidebar()"
      aria-label="Abrir o cerrar menú"
    ) ☰

  hr.line-1(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60")

  .user(class="flex min-h-[134px] items-start gap-[14px] py-6 group-[.collapsed]:hidden")
    .avatar(class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/20")
      //- Icono de usuario inline
      svg(class="h-4 w-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z")
    div(class="min-w-0 flex-1")
      p.bienvenido-txt(class="text-[13px] leading-4 text-white/65") Bienvenido
      h4(class="text-[15px] leading-5 font-normal text-white") Joseph Gómez
      span(class="block text-[11px] leading-[14px] text-white/65") Paciente
      button.btn-ver-perfil(
        class="mt-3 cursor-pointer rounded-md border-0 bg-white/20 px-[10px] py-1 text-[13px] leading-4 text-white transition-colors hover:bg-white/30"
        onclick="alert('Ir a: Mi Perfil')"
      ) Ver Mi Perfil

  hr.line-2(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60 group-[.collapsed]:hidden")

  nav(class="flex flex-col pt-4")
    //- 1. Mis Citas
    a.nav-link(
      class="mb-[6px] flex h-9 items-center gap-3 rounded-lg px-2 py-2 text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0"
      href="/paciente/citas"
    )
      svg(class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5")
      .nav-item(class="group-[.collapsed]:hidden") Mis Citas

    //- 2. Mis Diagnosticos (Activo)
    a.nav-link.preActive(
      class="mb-[6px] flex h-9 items-center gap-3 rounded-lg px-2 py-2 text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.35)]"
      href="/paciente/historial-diagnosticos"
    )
      svg(class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z")
      .nav-item(class="group-[.collapsed]:hidden") Mis Diagnosticos

    //- 3. Notificaciones
    a.nav-link(
      class="mb-[6px] flex h-9 items-center gap-3 rounded-lg px-2 py-2 text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0"
      href="/paciente/notificaciones"
    )
      svg(class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0")
      .nav-item(class="group-[.collapsed]:hidden") Notificaciones

  hr.line-3(class="-mx-6 mt-auto w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60")

  .logout(
    class="flex min-h-[58px] shrink-0 cursor-pointer items-center justify-left gap-3 group-[.collapsed]:justify-center transition-opacity hover:opacity-75"
    onclick="cerrarSesion()"
  )
    svg(class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
      path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75")
    span.sesionlogout(class="text-[16px] text-white group-[.collapsed]:hidden") Cerrar Sesión