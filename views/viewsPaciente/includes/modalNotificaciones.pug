
#modalNotificaciones.fixed.inset-0.z-50.hidden.overflow-y-auto.p-4.bg-slate-900(class="bg-opacity-50" role="dialog" aria-modal="true" aria-labelledby="tituloNotificaciones")
  .flex.min-h-full.items-center.justify-center
    .w-full.max-w-2xl.overflow-hidden.rounded-2xl.bg-white.shadow-2xl
      // ENCABEZADO
      .flex.items-center.justify-between.gap-4.bg-indigo-600.p-5.text-white(class="sm:p-6")
        .flex.items-center.gap-3
          .flex.h-11.w-11.shrink-0.items-center.justify-center.rounded-xl(class="bg-white/15")
            i.icon-bell.text-xl
          div
            h2#tituloNotificaciones.text-xl.font-bold Preferencias de notificaciones
            p.mt-1.text-sm.text-indigo-100 Personaliza cómo deseas recibir avisos.

        button#cerrarNotificaciones.flex.h-10.w-10.shrink-0.items-center.justify-center.rounded-xl.text-white.transition(type="button" aria-label="Cerrar ventana" class="hover:bg-white/15")
          | ✕

      // CONTENIDO
      .notification-body.space-y-5.overflow-y-auto.p-5(class="sm:p-6 max-h-[65vh]")
        // CANALES
        section.notification-section.rounded-xl.border.border-slate-200.p-4
          .notification-section-title.mb-3.flex.items-center.gap-2
            .flex.h-9.w-9.items-center.justify-center.rounded-lg.bg-indigo-50.text-indigo-700
              i.icon-send
            div
              h3.font-bold.text-slate-900 Canales de comunicación
              p.text-sm.text-slate-500 Elige por qué medios quieres recibir avisos.

          .space-y-3
            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="notificacionCorreo" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Correo electrónico
                span.mt-1.block.text-xs.text-slate-500 Recibe notificaciones en tu correo.
              input#notificacionCorreo.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="correo")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="notificacionSms" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Mensaje de texto (SMS)
                span.mt-1.block.text-xs.text-slate-500 Recibe avisos mediante mensajes de texto.
              input#notificacionSms.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="sms")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="notificacionWhatsapp" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 WhatsApp
                span.mt-1.block.text-xs.text-slate-500 Recibe avisos por WhatsApp.
              input#notificacionWhatsapp.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="whatsapp")

        // RECORDATORIOS
        section.notification-section.rounded-xl.border.border-slate-200.p-4
          .notification-section-title.mb-3.flex.items-center.gap-2
            .flex.h-9.w-9.items-center.justify-center.rounded-lg.bg-sky-50.text-sky-700
              i.icon-clock
            div
              h3.font-bold.text-slate-900 Recordatorios de citas
              p.text-sm.text-slate-500 Recibe avisos antes de tu cita programada.

          .space-y-3
            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="recordatorio24h" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 24 horas antes
                span.mt-1.block.text-xs.text-slate-500 Te avisaremos un día antes de la cita.
              input#recordatorio24h.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="recordatorio_24h")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="recordatorio1h" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 1 hora antes
                span.mt-1.block.text-xs.text-slate-500 Te avisaremos una hora antes de la cita.
              input#recordatorio1h.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="recordatorio_1h")

        // AVISOS DE ACTIVIDAD
        section.notification-section.rounded-xl.border.border-slate-200.p-4
          .notification-section-title.mb-3.flex.items-center.gap-2
            .flex.h-9.w-9.items-center.justify-center.rounded-lg.bg-emerald-50.text-emerald-700
              i.icon-calendar
            div
              h3.font-bold.text-slate-900 Actividad de tus citas
              p.text-sm.text-slate-500 Selecciona los cambios sobre los que quieres recibir avisos.

          .space-y-3
            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="confirmacionCita" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Confirmación de cita
                span.mt-1.block.text-xs.text-slate-500 Cuando una cita sea confirmada.
              input#confirmacionCita.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="confirmacion_cita")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="cancelacionCita" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Cancelación de cita
                span.mt-1.block.text-xs.text-slate-500 Cuando una cita sea cancelada.
              input#cancelacionCita.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="cancelacion_cita")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="reprogramacion" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Reprogramación de cita
                span.mt-1.block.text-xs.text-slate-500 Cuando cambie la fecha u hora de una cita.
              input#reprogramacion.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="reprogramacion")

        // OTROS AVISOS
        section.notification-section.rounded-xl.border.border-slate-200.p-4
          .notification-section-title.mb-3.flex.items-center.gap-2
            .flex.h-9.w-9.items-center.justify-center.rounded-lg.bg-amber-50.text-amber-700
              i.icon-info
            div
              h3.font-bold.text-slate-900 Otros avisos
              p.text-sm.text-slate-500 Mantente al tanto de la información relevante.

          .space-y-3
            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="nuevoDiagnostico" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Nuevos diagnósticos
                span.mt-1.block.text-xs.text-slate-500 Cuando se registre información de diagnóstico.
              input#nuevoDiagnostico.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="nuevo_diagnostico")

            label.flex.cursor-pointer.items-center.justify-between.gap-4.rounded-xl.bg-slate-50.p-3.transition(for="actualizaciones" class="hover:bg-indigo-50")
              div
                span.block.font-medium.text-slate-800 Actualizaciones del sistema
                span.mt-1.block.text-xs.text-slate-500 Avisos importantes relacionados con el portal.
              input#actualizaciones.h-5.w-5.cursor-pointer.accent-indigo-600(type="checkbox" name="actualizaciones")

      // BOTONES
      .flex.flex-wrap.items-center.justify-end.gap-3.border-t.border-slate-200.bg-white.p-5(class="sm:px-6")
        button#cancelarNotificaciones.rounded-xl.border.border-slate-300.px-5.py-3.text-sm.font-semibold.text-slate-700.transition(type="button" class="hover:bg-slate-100")
          | Cancelar

        button#guardarNotificaciones.inline-flex.items-center.justify-center.gap-2.rounded-xl.bg-indigo-600.px-5.py-3.text-sm.font-semibold.text-white.transition(type="button" class="hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60")
          i.icon-check
          | Guardar Cambios
