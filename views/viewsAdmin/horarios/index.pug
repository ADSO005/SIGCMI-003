doctype html
-
    // Resumen de horarios por semana: agrupa los bloques guardados y junta los días con las mismas horas.
    const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
    const CORTO = { Lunes: "Lun", Martes: "Mar", Miercoles: "Mié", Jueves: "Jue", Viernes: "Vie", Sabado: "Sáb", Domingo: "Dom" };
    const ORDEN = Object.keys(CORTO);
    const pad = (n) => String(n).padStart(2, "0");
    const aTexto = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const hoyTexto = aTexto(new Date());
    const proximoLunes = (() => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + 8 - (d.getDay() || 7)); return aTexto(d); })();
    const etiquetaFecha = (t) => { const d = new Date(`${t}T00:00:00`); return `${d.getDate()} ${MESES[d.getMonth()]}`; };
    const resumenSemanas = (horarios = []) => {
        const porSemana = new Map();
        for (const h of horarios) {
            const desde = String(h.fecha_inicio).slice(0, 10);
            const hasta = String(h.fecha_fin).slice(0, 10);
            if (hasta < hoyTexto) continue;
            const clave = `${desde}|${hasta}`;
            if (!porSemana.has(clave)) porSemana.set(clave, { desde, hasta, filas: [] });
            porSemana.get(clave).filas.push(h);
        }
        return [...porSemana.values()].sort((a, b) => a.desde.localeCompare(b.desde)).map((s) => {
            const textos = ORDEN.map((nombre) => s.filas
                .filter((f) => f.dia_semana === nombre)
                .sort((a, b) => String(a.hora_inicio).localeCompare(String(b.hora_inicio)))
                .map((f) => `${String(f.hora_inicio).slice(0, 5)}–${String(f.hora_fin).slice(0, 5)}`)
                .join(" · "));
            const grupos = [];
            textos.forEach((t, i) => {
                const ultimo = grupos[grupos.length - 1];
                if (ultimo && ultimo.texto === t) ultimo.fin = i;
                else grupos.push({ inicio: i, fin: i, texto: t });
            });
            return {
                desde: s.desde,
                etiqueta: `${etiquetaFecha(s.desde)} – ${etiquetaFecha(s.hasta)}`,
                marca: s.desde <= hoyTexto && hoyTexto <= s.hasta ? "Esta semana" : s.desde === proximoLunes ? "Próxima semana" : "",
                lineas: grupos.map((g) => ({
                    dias: g.inicio === g.fin ? CORTO[ORDEN[g.inicio]] : `${CORTO[ORDEN[g.inicio]]}–${CORTO[ORDEN[g.fin]]}`,
                    texto: g.texto
                }))
            };
        });
    };
    const lunesActual = (() => { const d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return aTexto(d); })();
    const sumarDias = (t, n) => { const d = new Date(`${t}T00:00:00`); d.setDate(d.getDate() + n); return aTexto(d); };
    // Siempre devuelve la semana actual y la próxima, con o sin agenda.
    const semanasFijas = (horarios = []) => {
        const existentes = resumenSemanas(horarios);
        return [lunesActual, proximoLunes].map((desde) => {
            const semana = existentes.find((s) => s.desde === desde);
            if (semana) return { ...semana, abierta: true };
            return {
                desde,
                etiqueta: `${etiquetaFecha(desde)} – ${etiquetaFecha(sumarDias(desde, 6))}`,
                marca: desde === lunesActual ? "Esta semana" : "Próxima semana",
                lineas: [],
                abierta: false
            };
        });
    };
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")

        title SIGCMI - Horarios

        link(rel="stylesheet" href="/css/output.css")
        link(rel="stylesheet" href="/shared/css/session.css")

        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        )

    body(class="bg-slate-100 min-h-screen")

        div(class="flex min-h-screen")

            include ../components/sidebar.pug

            include ../components/sidebarOverlay.pug

            main(class="flex-1 min-w-0 px-4 md:px-8 xl:px-10 py-6")

                div(class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-8")

                    div
                        div(class="flex items-center gap-3")

                            div(class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-sm")
                                i(class="fa-solid fa-clock text-xl")

                            div
                                h1(class="text-2xl font-bold text-slate-800")
                                    | Horarios de atención

                                p(class="text-sm text-slate-500 mt-1")
                                    | Administra la disponibilidad de los médicos.

                div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-7")

                    div(class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm")

                        div(class="flex items-center justify-between")

                            div
                                p(class="text-sm text-slate-500")
                                    | Médicos

                                p(class="text-3xl font-bold text-slate-800 mt-1")
                                    = medicos.length

                            div(class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center")
                                i(class="fa-solid fa-user-doctor text-lg")

                    div(class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm")

                        - let totalHorarios = 0
                        each medico in medicos
                            - totalHorarios += resumenSemanas(medico.horarios).length

                        div(class="flex items-center justify-between")

                            div
                                p(class="text-sm text-slate-500")
                                    | Semanas con agenda

                                p(class="text-3xl font-bold text-slate-800 mt-1")
                                    = totalHorarios

                            div(class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center")
                                i(class="fa-solid fa-calendar-days text-lg")

                    div(class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm")

                        - let medicosActivos = medicos.filter(m => m.estado === true).length

                        div(class="flex items-center justify-between")

                            div
                                p(class="text-sm text-slate-500")
                                    | Médicos activos

                                p(class="text-3xl font-bold text-green-600 mt-1")
                                    = medicosActivos

                            div(class="w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center")
                                i(class="fa-solid fa-user-check text-lg")

                div(class="bg-white border border-slate-200 rounded-2xl p-4 mb-7 shadow-sm")

                    div(class="relative max-w-md")

                        i(class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400")

                        input(
                            id="buscarMedicoHorario"
                            type="text"
                            placeholder="Buscar médico o especialidad..."
                            class="w-full pl-11 pr-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                        )

                div(
                    id="contenedorMedicosHorarios"
                    class="grid grid-cols-1 xl:grid-cols-2 gap-6"
                )

                    if medicos.length

                        each medico in medicos

                            div(
                                class="tarjetaMedicoHorario bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden"
                                data-nombre=medico.nombre
                                data-especialidad=medico.especialidad
                            )

                                div(class="p-5 border-b border-slate-200")

                                    div(class="flex items-start justify-between gap-4")

                                        div(class="flex items-center gap-4")

                                            div(class="w-14 h-14 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0")
                                                i(class="fa-solid fa-user-doctor text-xl")

                                            div

                                                h2(class="text-lg font-bold text-slate-800")
                                                    = medico.nombre

                                                p(class="text-sm text-slate-500 mt-1")
                                                    = medico.especialidad

                                        if medico.estado

                                            span(class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold")
                                                span(class="w-2 h-2 rounded-full bg-green-500")
                                                | Activo

                                        else

                                            span(class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-100 text-red-700 text-xs font-semibold")
                                                span(class="w-2 h-2 rounded-full bg-red-500")
                                                | Inactivo

                                - const semanas = semanasFijas(medico.horarios)
                                div(class="p-5")

                                    div(class="flex items-center justify-between mb-4")

                                        div

                                            h3(class="font-semibold text-slate-800")
                                                | Agenda por semana

                                            p(class="text-xs text-slate-400 mt-1")
                                                | Toca una semana para editarla

                                        span(class="text-xs font-medium text-slate-500")
                                            | Semana actual y próxima

                                    div(class="space-y-3")

                                        each semana in semanas

                                            button(
                                                type="button"
                                                class=`btnGestionarHorario block h-[208px] w-full overflow-y-auto rounded-xl border p-4 text-left transition hover:border-[#335CD8] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#335CD8] ${semana.abierta ? "border-[#E2E8F0] bg-[#F4F8FF]" : "border-dashed border-[#E2E8F0] bg-white"}`
                                                data-medico-id=medico.id_medico
                                                data-medico-nombre=medico.nombre
                                                data-semana=semana.desde
                                                aria-label=`Editar la agenda del ${semana.etiqueta}`
                                            )

                                                span(class="flex flex-wrap items-center justify-between gap-2")

                                                    span(class="font-bold text-[#001B4D]")
                                                        i(class="fa-regular fa-calendar mr-2 text-[#335CD8]" aria-hidden="true")
                                                        = semana.etiqueta

                                                    span(class="rounded-full bg-[#335CD8]/10 px-2.5 py-1 text-xs font-semibold text-[#335CD8]")= semana.marca

                                                if semana.abierta

                                                    span(class="mt-3 block space-y-1.5")

                                                        each linea in semana.lineas

                                                            span(class="flex items-baseline gap-3 text-sm")

                                                                span(class="w-[84px] shrink-0 font-semibold text-slate-700")= linea.dias

                                                                if linea.texto
                                                                    span(class="text-slate-600")= linea.texto
                                                                else
                                                                    span(class="text-slate-400") Cerrado

                                                else

                                                    span(class="flex h-[120px] flex-col items-center justify-center text-center")

                                                        span(class="text-sm font-semibold text-slate-700") Sin agenda abierta

                                                        span(class="mt-1 text-xs text-slate-500") Toca para abrirla


                                div(class="px-5 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row gap-3")

                                    button(
                                        type="button"
                                        class="btnGestionarHorario flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-sm transition"
                                        data-medico-id=medico.id_medico
                                        data-medico-nombre=medico.nombre
                                    )
                                        i(class="fa-solid fa-sliders")
                                        | Gestionar horarios

                    else

                        div(class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl p-12 text-center")

                            div(class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400 mb-4")
                                i(class="fa-solid fa-user-doctor text-2xl")

                            h2(class="text-lg font-bold text-slate-800")
                                | No hay médicos disponibles

                            p(class="text-sm text-slate-500 mt-2")
                                | Los médicos registrados aparecerán aquí para gestionar sus horarios.

                div(
                    id="sinResultadosMedicos"
                    class="hidden bg-white border border-slate-200 rounded-2xl p-10 text-center"
                )

                    div(class="w-14 h-14 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-4")
                        i(class="fa-solid fa-magnifying-glass text-xl")

                    h2(class="font-bold text-slate-800")
                        | No se encontraron médicos

                    p(class="text-sm text-slate-500 mt-1")
                        | Intenta con otro nombre o especialidad.

        include ../components/modals/editorSemanaHorarios.pug
        
        script.
            window.medicosHorarios = !{JSON.stringify(medicos).replace(/</g, '\\u003c')}
        
        script(src="/admin/js/toggleSidebar.js")
        script(src="/admin/js/busqueda.js")
        script(src="/admin/js/horariosSemana.js")
