doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        title SIGCMI - Dashboard
        script(src="https://cdn.tailwindcss.com")
        link(rel="stylesheet" href="../admin/css/input.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css")
        script(src="https://cdn.jsdelivr.net/npm/chart.js")
    body(class="bg-white text-slate-800")

        div(class="flex min-h-screen")

            //- ============ SIDEBAR ============
            include components/sidebar.pug

            //- ============ OVERLAY ============
            include components/sidebarOverlay.pug
            //- ============ CONTENIDO ============
            main(
                id="mainContent"
                class="flex-1 min-w-0 px-4 md:px-8 xl:px-10 py-6"
            )

                //- Botón para abrir sidebar en móvil
                div(class="md:hidden mb-4")

                    button(
                        type="button"
                        onclick="toggleSidebar()"
                        class="p-3 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition"
                        aria-label="Abrir menú"
                    )
                        i(class="fa-solid fa-bars text-xl")

                div(class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-200")

                // Tarjetas
                include components/statsCards

                div(class="grid grid-cols-1 xl:grid-cols-3 gap-8 mt-6")
                    div(class="xl:col-span-2")
                        include components/appointmentsTable


                    div
                        h3(class="text-2xl font-bold mb-4") Acciones Rápidas

                        div(class="space-y-3")
                            button(
                                type="button"
                                id="btnNuevaCita"
                                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl"
                            ) + Nueva Cita
                            a(href="/admin/pacientes/nuevo" class="block w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-4 rounded-xl text-center") + Registrar Paciente
                            button(type="button" class="w-full bg-fuchsia-500 hover:bg-fuchsia-600 text-white font-bold py-4 rounded-xl") Gestionar Citas
                            button(type="button" class="w-full bg-violet-800 hover:bg-violet-900 text-white font-bold py-4 rounded-xl") Ver Metricas
                            button(type="button" class="w-full bg-cyan-500 hover:bg-cyan-600 text-white font-bold py-4 rounded-xl") Ver Calendario
                            button(type="button" class="w-full bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 rounded-xl") Enviar Recordatorios

                            div(class="bg-slate-50 rounded-xl px-5 py-4 mt-2")
                                p(class="font-bold")
                                    | WhatsApp
                                    span(class="text-emerald-600")  Activo
                                p(class="text-slate-500 text-sm")= `${stats.notificacionesHoy} notificaciones enviadas hoy`

                    // ===============================
                    // Gráfico de Estados
                    // ===============================

                div(class="bg-white rounded-2xl  p-6 mt-6 w-1/2 mx-auto")

                    h3(class="text-xl font-bold mb-5 flex items-center gap-2")
                        i(class="fa-solid fa-chart-pie text-indigo-600")
                        | Estado de las Citas
                    canvas(id="graficoEstados" height="260")
        

        // COMPONENTES
        include components/modals/nuevaCita.pug

        script(src="/admin/js/modals/nuevaCita.js")

        script(src="https://cdn.jsdelivr.net/npm/chart.js")

        script(src="/admin/js/stadistics.js")

        script(src="/admin/js/toggleSidebar.js")
            