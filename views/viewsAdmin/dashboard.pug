doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        title SIGCMI - Dashboard
        link(rel="stylesheet" href="/css/output.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css")
    body(class="bg-[#F4F8FF] text-[#001B4D]")

        div(class="flex min-h-screen")

            //- ============ SIDEBAR ============
            include components/sidebar.pug

            //- ============ OVERLAY ============
            include components/sidebarOverlay.pug
            //- ============ CONTENIDO ============
            main(
                id="mainContent"
                class="min-w-0 flex-1 px-4 py-5 sm:px-6 lg:px-8 xl:px-10"
            )

                //- Botón para abrir sidebar en móvil
                div(class="md:hidden mb-4")

                    button(
                        type="button"
                        onclick="toggleSidebar()"
                        class="min-h-11 rounded-xl bg-[#335CD8] px-4 py-3 text-white shadow-sm transition hover:bg-[#263F9D] focus-visible:outline"
                        aria-label="Abrir menú"
                    )
                        i(class="fa-solid fa-bars text-xl")

                div(class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-4 border-b border-slate-200")

                // Tarjetas
                include components/statsCards

                div(class="mt-5 grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,2fr)_minmax(220px,1fr)]")
                    div(class="min-w-0 lg:col-span-1")
                        include components/appointmentsTable


                    div
                        h3(class="text-2xl font-bold mb-4") Acciones Rápidas

                        div(class="space-y-3")
                            button(
                                type="button"
                                class="btnNuevaCita w-full bg-[#335CD8] hover:bg-[#263F9D] text-white font-bold py-4 rounded-xl"
                            ) + Nueva Cita
                            a(href="/admin/pacientes/nuevo" class="block w-full bg-[#00BC8D] hover:bg-emerald-700 text-white font-bold py-4 rounded-xl text-center") + Registrar Paciente
                            button(type="button" class="w-full bg-[#335CD8] hover:bg-[#263F9D] text-white font-bold py-4 rounded-xl") Gestionar Citas
                            button(type="button" class="w-full bg-[#263F9D] hover:bg-[#1C317B] text-white font-bold py-4 rounded-xl") Ver Metricas
                            button(type="button" class="w-full bg-[#00BC8D] hover:bg-emerald-700 text-white font-bold py-4 rounded-xl") Ver Calendario
                            button(type="button" class="w-full bg-[#335CD8] hover:bg-[#263F9D] text-white font-bold py-4 rounded-xl") Enviar Recordatorios

                            div(class="bg-slate-50 rounded-xl px-5 py-4 mt-2")
                                p(class="font-bold")
                                    | WhatsApp
                                    span(class="text-emerald-600")  Activo
                                p(class="text-slate-500 text-sm")= `${stats.notificacionesHoy} notificaciones enviadas hoy`

                    // ===============================
                    // Gráfico de Estados
                    // ===============================

                div(class="w-full max-w-2xl rounded-2xl border border-[#E2E8F0] bg-white p-5 shadow-sm mt-6 mx-auto")

                    h3(class="text-xl font-bold mb-5 flex items-center gap-2")
                        i(class="fa-solid fa-chart-pie text-indigo-600")
                        | Estado de las Citas
                    canvas(id="graficoEstados" height="260")
        

        // COMPONENTES
        include components/modals/nuevaCita.pug

        script(src="/admin/js/nuevaCita.js")

        script(src="https://cdn.jsdelivr.net/npm/chart.js")

        script(src="/admin/js/stadistics.js")

        script(src="/admin/js/toggleSidebar.js")
            