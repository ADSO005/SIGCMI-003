doctype html
html(lang="es")

    head

        meta(charset="UTF-8")

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title SIGCMI - WhatsApp

        link(rel="stylesheet" href="/css/output.css")
        link(rel="stylesheet" href="/shared/css/session.css")

        link(
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        )

    body(class="bg-slate-100 text-slate-800")

        div(class="flex min-h-screen")

            include ../components/sidebar.pug

            include ../components/sidebarOverlay.pug

            main(class="flex-1 min-w-0 px-4 md:px-8 xl:px-10 py-6")

                div(class="mb-8")

                    h1(class="text-2xl font-bold text-slate-800")
                        | WhatsApp Cloud API

                    p(class="text-sm text-slate-500 mt-1")
                        | Configura la conexión con Meta para enviar notificaciones y atender mensajes.

                if mensaje
                    div(class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm")= mensaje

                if error
                    div(class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm")= error

                div(class="grid grid-cols-1 xl:grid-cols-3 gap-6")

                    //- Credenciales
                    section(class="xl:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-6")

                        h2(class="text-lg font-semibold mb-4") Credenciales de Meta

                        form(method="POST" action="/admin/whatsapp/config" class="space-y-4")

                            div
                                label(for="phone_number_id" class="block text-sm font-medium mb-1") Phone Number ID
                                input#phone_number_id(
                                    type="text" name="phone_number_id" required
                                    value=config.phoneNumberId inputmode="numeric"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                )

                            div
                                label(for="waba_id" class="block text-sm font-medium mb-1") WhatsApp Business Account ID
                                input#waba_id(
                                    type="text" name="waba_id"
                                    value=config.wabaId inputmode="numeric"
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                )

                            div
                                label(for="access_token" class="block text-sm font-medium mb-1") Access Token (permanente)
                                input#access_token(
                                    type="password" name="access_token" autocomplete="off"
                                    placeholder=(config.tieneToken ? "Configurado — deja vacío para conservarlo" : "Pega el token")
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                )

                            div
                                label(for="app_secret" class="block text-sm font-medium mb-1") App Secret
                                input#app_secret(
                                    type="password" name="app_secret" autocomplete="off"
                                    placeholder=(config.tieneAppSecret ? "Configurado — deja vacío para conservarlo" : "Necesario para validar el webhook")
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                )

                            div
                                label(for="verify_token" class="block text-sm font-medium mb-1") Verify Token del webhook
                                input#verify_token(
                                    type="password" name="verify_token" autocomplete="off"
                                    placeholder=(config.tieneVerifyToken ? "Configurado — deja vacío para conservarlo" : "Vacío = se genera uno automáticamente")
                                    class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                )

                            div(class="grid grid-cols-2 gap-4")

                                div
                                    label(for="api_version" class="block text-sm font-medium mb-1") Versión de la API
                                    input#api_version(
                                        type="text" name="api_version" value=config.apiVersion
                                        class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    )

                                div
                                    label(for="codigo_pais" class="block text-sm font-medium mb-1") Código de país
                                    input#codigo_pais(
                                        type="text" name="codigo_pais" value=config.codigoPais
                                        class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                                    )

                            label(class="flex items-center gap-3 text-sm")
                                input(type="checkbox" name="activo" checked=config.activo class="w-4 h-4")
                                | Integración activa

                            button(
                                type="submit"
                                class="px-5 py-3 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700 transition"
                            ) Guardar configuración

                    aside(class="space-y-6")

                        //- Estado
                        section(class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6")

                            h2(class="text-lg font-semibold mb-3") Estado

                            p(class="text-sm")
                                span(class="font-medium") Integración:
                                |
                                if config.activo
                                    span(class="text-green-600") Activa
                                else
                                    span(class="text-slate-500") Inactiva

                            if config.nombreVerificado
                                p(class="text-sm mt-1") #{config.nombreVerificado} · #{config.numeroVisible}

                            if config.ultimaVerificacion
                                p(class="text-xs text-slate-500 mt-1") Última verificación: #{new Date(config.ultimaVerificacion).toLocaleString("es-CO")}

                            if config.ultimoError
                                p(class="text-xs text-red-600 mt-1")= config.ultimoError

                            form(method="POST" action="/admin/whatsapp/probar-conexion" class="mt-4")
                                button(
                                    type="submit"
                                    class="w-full px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-50 text-sm"
                                ) Probar conexión

                        //- Webhook
                        section(class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6")

                            h2(class="text-lg font-semibold mb-3") Webhook

                            p(class="text-xs text-slate-500 mb-2")
                                | En Meta → WhatsApp → Configuración, registra esta URL y suscríbete al campo messages.

                            code(class="block text-xs break-all bg-slate-100 rounded-lg p-3")= webhookUrl

                        //- Envío de prueba
                        section(class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6")

                            h2(class="text-lg font-semibold mb-3") Envío de prueba

                            form(method="POST" action="/admin/whatsapp/probar-envio" class="space-y-3")
                                input(
                                    type="tel" name="telefono" required placeholder="3001234567"
                                    class="w-full px-4 py-2 border border-slate-300 rounded-xl text-sm"
                                )
                                input(
                                    type="text" name="plantilla" placeholder="hello_world"
                                    class="w-full px-4 py-2 border border-slate-300 rounded-xl text-sm"
                                )
                                button(
                                    type="submit"
                                    class="w-full px-4 py-2 rounded-xl bg-green-600 text-white text-sm hover:bg-green-700"
                                ) Enviar plantilla de prueba
