div#modalNuevaEspecialidad(
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
)

    div(
        class="w-full max-w-lg rounded-2xl bg-white shadow-2xl"
    )

        //- Encabezado
        div(
            class="flex items-center justify-between border-b border-slate-200 px-6 py-4"
        )

            div

                h2(
                    class="text-xl font-bold text-slate-800"
                )
                    i(
                        class="fa-solid fa-stethoscope text-blue-600 mr-2"
                    )
                    | Nueva especialidad

                p(
                    class="text-sm text-slate-500 mt-1"
                )
                    | Registra una nueva especialidad médica.

            button#btnCerrarNuevaEspecialidad(
                type="button"
                class="w-9 h-9 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition"
            )
                i(class="fa-solid fa-xmark")


        //- Formulario
        form#formNuevaEspecialidad

            div(class="p-6 space-y-5")

                //- Nombre
                div

                    label(
                        for="especialidad_nombre"
                        class="block text-sm font-medium text-slate-700 mb-2"
                    )
                        | Nombre
                        span(class="text-red-500")
                            | *

                    input#especialidad_nombre(
                        type="text"
                        name="nombre"
                        maxlength="100"
                        required
                        placeholder="Ej. Cardiología"
                        class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    )


                //- Descripción
                div

                    label(
                        for="especialidad_descripcion"
                        class="block text-sm font-medium text-slate-700 mb-2"
                    )
                        | Descripción

                    textarea#especialidad_descripcion(
                        name="descripcion"
                        rows="4"
                        placeholder="Describe brevemente la especialidad..."
                        class="w-full px-4 py-3 border border-slate-300 rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"
                    )


            //- Botones
            div(
                class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4"
            )

                button#btnCancelarNuevaEspecialidad(
                    type="button"
                    class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition"
                )
                    | Cancelar

                button(
                    type="submit"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700 transition"
                )

                    i(class="fa-solid fa-floppy-disk")

                    | Guardar