div#modalEditarMedico(
    class="hidden fixed inset-0 z-50 items-center justify-center bg-slate-900/60 p-4"
)
    div(
        class="w-full max-w-4xl max-h-[90vh] overflow-y-auto bg-white rounded-2xl shadow-2xl"
    )

        //- ==========================================
        //- ENCABEZADO
        //- ==========================================

        div(
            class="flex items-center justify-between px-6 py-5 border-b border-slate-200"
        )
            div
                h2(
                    class="text-xl font-bold text-slate-800"
                )
                    | Editar médico

                p(
                    class="text-sm text-slate-500 mt-1"
                )
                    | Actualiza la información del médico.

            button#btnCerrarEditarMedico(
                type="button"
                class="w-10 h-10 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition"
            )
                i(class="fa-solid fa-xmark text-lg")

        //- ==========================================
        //- FORMULARIO
        //- ==========================================

        form#formEditarMedico(
            class="p-6"
        )

            input#editar_medico_id(
                type="hidden"
            )

            //- ======================================
            //- INFORMACIÓN PERSONAL
            //- ======================================

            div(class="mb-6")
                h3(
                    class="text-base font-semibold text-slate-800 mb-4 flex items-center gap-2"
                )
                    i(class="fa-solid fa-user text-blue-600")
                    | Información personal

                div(
                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                )

                    div
                        label(
                            for="editar_nombres"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Nombres *

                        input#editar_nombres(
                            type="text"
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_apellidos"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Apellidos *

                        input#editar_apellidos(
                            type="text"
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_tipo_documento"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Tipo de documento *

                        select#editar_tipo_documento(
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )
                            option(value="") Seleccionar
                            option(value="CC") Cédula de ciudadanía
                            option(value="CE") Cédula de extranjería
                            option(value="TI") Tarjeta de identidad
                            option(value="Pasaporte") Pasaporte

                    div
                        label(
                            for="editar_numero_documento"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Número de documento *

                        input#editar_numero_documento(
                            type="text"
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_correo"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Correo electrónico *

                        input#editar_correo(
                            type="email"
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_telefono"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Teléfono

                        input#editar_telefono(
                            type="text"
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

            //- ======================================
            //- INFORMACIÓN PROFESIONAL
            //- ======================================

            div(class="mb-6")
                h3(
                    class="text-base font-semibold text-slate-800 mb-4 flex items-center gap-2"
                )
                    i(class="fa-solid fa-user-doctor text-blue-600")
                    | Información profesional

                div(
                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                )

                    div
                        label(
                            for="editar_especialidad_id"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Especialidad *

                        select#editar_especialidad_id(
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )
                            option(value="") Seleccionar especialidad

                            if especialidades && especialidades.length
                                each especialidad in especialidades
                                    option(
                                        value=especialidad.id_especialidad
                                    )= especialidad.nombre

                    div
                        label(
                            for="editar_cedula_profesional"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Cédula profesional *

                        input#editar_cedula_profesional(
                            type="text"
                            required
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_anios_experiencia"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Años de experiencia

                        input#editar_anios_experiencia(
                            type="number"
                            min="0"
                            max="60"
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )

                    div
                        label(
                            for="editar_estado"
                            class="block text-sm font-medium text-slate-700 mb-2"
                        )
                            | Estado

                        select#editar_estado(
                            class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                        )
                            option(value="true") Activo
                            option(value="false") Inactivo

            //- ======================================
            //- BOTONES
            //- ======================================

            div(
                class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-5 border-t border-slate-200"
            )

                button#btnCancelarEditarMedico(
                    type="button"
                    class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition"
                )
                    | Cancelar

                button#btnGuardarEditarMedico(
                    type="submit"
                    class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold transition"
                )
                    i(class="fa-solid fa-floppy-disk mr-2")
                    | Guardar cambios