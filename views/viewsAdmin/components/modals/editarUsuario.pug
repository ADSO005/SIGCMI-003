//- ==========================================
//- MODAL EDITAR USUARIO
//- ==========================================

div(
    id="modalEditarUsuario"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4"
)

    div(
        class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto"
    )

        //- ==========================================
        //- HEADER
        //- ==========================================

        div(
            class="flex items-center justify-between px-6 py-5 border-b border-slate-200"
        )

            div

                h2(class="text-xl font-bold text-slate-900")
                    | Editar usuario

                p(class="text-sm text-slate-500 mt-1")
                    | Modifica la información del usuario.

            button(
                type="button"
                id="btnCerrarEditarUsuario"
                class="w-9 h-9 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-700"
            )
                i(class="fa-solid fa-xmark text-lg")


        //- ==========================================
        //- FORMULARIO
        //- ==========================================

        form(id="formEditarUsuario")

            input(
                type="hidden"
                id="editar_usuario_id"
            )

            div(class="p-6 space-y-5")

                //- Nombres y apellidos
                div(class="grid grid-cols-1 md:grid-cols-2 gap-4")

                    div

                        label(
                            for="editar_nombres"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Nombres *

                        input(
                            type="text"
                            id="editar_nombres"
                            name="nombres"
                            required
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )


                    div

                        label(
                            for="editar_apellidos"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Apellidos *

                        input(
                            type="text"
                            id="editar_apellidos"
                            name="apellidos"
                            required
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )


                //- Correo y teléfono
                div(class="grid grid-cols-1 md:grid-cols-2 gap-4")

                    div

                        label(
                            for="editar_correo"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Correo electrónico *

                        input(
                            type="email"
                            id="editar_correo"
                            name="correo"
                            required
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )


                    div

                        label(
                            for="editar_telefono"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Teléfono

                        input(
                            type="tel"
                            id="editar_telefono"
                            name="telefono"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )


                //- Documento
                div(class="grid grid-cols-1 md:grid-cols-2 gap-4")

                    div

                        label(
                            for="editar_tipo_documento"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Tipo de documento

                        select(
                            id="editar_tipo_documento"
                            name="tipo_documento"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )

                            option(value="")
                                | Seleccione

                            option(value="CC")
                                | Cédula de ciudadanía

                            option(value="TI")
                                | Tarjeta de identidad

                            option(value="CE")
                                | Cédula de extranjería


                    div

                        label(
                            for="editar_numero_documento"
                            class="block text-sm font-semibold text-slate-700 mb-2"
                        )
                            | Número de documento *

                        input(
                            type="text"
                            id="editar_numero_documento"
                            name="numero_documento"
                            required
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                        )


                //- Rol
                div

                    label(
                        for="editar_rol_id"
                        class="block text-sm font-semibold text-slate-700 mb-2"
                    )
                        | Rol *

                    select(
                        id="editar_rol_id"
                        name="rol_id"
                        required
                        class="w-full border border-slate-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    )

                        option(value="")
                            | Seleccione un rol

                        option(value="1")
                            | Administrador

                        option(value="2")
                            | Médico

                        option(value="3")
                            | Paciente


                //- Mensaje de error
                div(
                    id="errorEditarUsuario"
                    class="hidden bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm"
                )


                //- Mensaje de éxito
                div(
                    id="exitoEditarUsuario"
                    class="hidden bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg px-4 py-3 text-sm"
                )


            //- ==========================================
            //- FOOTER
            //- ==========================================

            div(
                class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 px-6 py-5 border-t border-slate-200 bg-slate-50"
            )

                button(
                    type="button"
                    id="btnCancelarEditarUsuario"
                    class="px-5 py-3 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold"
                )
                    | Cancelar

                button(
                    type="submit"
                    id="btnGuardarEditarUsuario"
                    class="px-5 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-semibold"
                )
                    i(class="fa-solid fa-floppy-disk mr-2")
                    | Guardar cambios