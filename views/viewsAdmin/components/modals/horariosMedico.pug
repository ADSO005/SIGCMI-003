div#modalHorariosMedico(
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
)
    div(
        class="w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl bg-white shadow-2xl"
    )

        // HEADER
        div(
            class="flex items-center justify-between border-b border-slate-200 px-6 py-4"
        )
            div
                h2(
                    class="text-xl font-bold text-slate-800"
                )
                    i(class="fa-solid fa-clock text-blue-600 mr-2")
                    | Gestionar horarios

                p#horarios_medico_nombre(
                    class="text-sm text-slate-500 mt-1"
                )
                    | Médico

            button#btnCerrarHorariosMedico(
                type="button"
                class="w-10 h-10 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition"
            )
                i(class="fa-solid fa-xmark")

        // CONTENIDO
        div(class="p-6")

            // BOTÓN NUEVO HORARIO
            div(class="flex justify-end mb-6")
                button#btnNuevoHorario(
                    type="button"
                    class="inline-flex items-center gap-2 px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold transition"
                )
                    i(class="fa-solid fa-plus")
                    | Agregar horario

            // LISTA DE HORARIOS
            div#listaHorariosMedico(class="space-y-4")

                div#sinHorariosMedico(
                    class="hidden text-center py-10 text-slate-500"
                )
                    i(class="fa-solid fa-calendar-xmark text-4xl mb-3")
                    p(class="font-medium")
                        | Este médico no tiene horarios registrados.

            // FORMULARIO
            div#formularioHorarioMedico(
                class="hidden mt-6 border border-slate-200 rounded-2xl p-6 bg-slate-50"
            )

                div(class="flex items-center justify-between mb-5")
                    div
                        h3(class="text-lg font-semibold text-slate-800")
                            | Nuevo horario
                        p(class="text-sm text-slate-500")
                            | Define el período y los días de atención.

                    button#btnCancelarNuevoHorario(
                        type="button"
                        class="text-slate-500 hover:text-slate-700"
                    )
                        i(class="fa-solid fa-xmark")

                form#formNuevoHorario

                    input#horario_medico_id(
                        type="hidden"
                    )

                    // FECHAS
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5")

                        div
                            label(
                                for="horario_fecha_inicio"
                                class="block text-sm font-medium text-slate-700 mb-2"
                            )
                                | Fecha de inicio
                                span(class="text-red-500") *

                            input#horario_fecha_inicio(
                                type="date"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                            )

                        div
                            label(
                                for="horario_fecha_fin"
                                class="block text-sm font-medium text-slate-700 mb-2"
                            )
                                | Fecha de fin
                                span(class="text-red-500") *

                            input#horario_fecha_fin(
                                type="date"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                            )

                    // DÍAS
                    div(class="mb-5")

                        label(
                            class="block text-sm font-medium text-slate-700 mb-3"
                        )
                            | Días de atención
                            span(class="text-red-500") *

                        div(class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2")

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Lunes"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Lunes

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Martes"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Martes

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Miercoles"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Miércoles

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Jueves"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Jueves

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Viernes"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Viernes

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Sabado"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Sábado

                            label(
                                class="flex items-center gap-2 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer"
                            )
                                input(
                                    type="checkbox"
                                    name="dias_semana"
                                    value="Domingo"
                                    class="diaHorario"
                                )
                                span(class="text-sm") Domingo

                    // HORAS
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6")

                        div
                            label(
                                for="horario_hora_inicio"
                                class="block text-sm font-medium text-slate-700 mb-2"
                            )
                                | Hora de inicio
                                span(class="text-red-500") *

                            input#horario_hora_inicio(
                                type="time"
                                min="07:00"
                                max="19:00"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                            )

                        div
                            label(
                                for="horario_hora_fin"
                                min="07:00"
                                max="19:00"
                                class="block text-sm font-medium text-slate-700 mb-2"
                            )
                                | Hora de fin
                                span(class="text-red-500") *

                            input#horario_hora_fin(
                                type="time"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none"
                            )

                    // BOTONES
                    div(class="flex justify-end gap-3")

                        button#btnCancelarHorario(
                            type="button"
                            class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold"
                        )
                            | Cancelar

                        button(
                            type="submit"
                            class="px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold"
                        )
                            i(class="fa-solid fa-floppy-disk mr-2")
                            | Guardar horario