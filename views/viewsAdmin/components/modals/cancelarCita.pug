// =====================================================
// MODAL CANCELAR CITA
// =====================================================

div(
    id="modalCancelarCita"
    class="hidden fixed inset-0 bg-slate-950/60 backdrop-blur-sm items-center justify-center z-[100] p-4"
)

    div(
        class="bg-white w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden"
    )

        // =================================================
        // ENCABEZADO
        // =================================================

        div(
            class="bg-red-600 text-white px-6 py-5 flex items-center justify-between"
        )

            div
                h2(class="text-xl font-bold")
                    i(class="fa-solid fa-calendar-xmark mr-2")
                    | Cancelar Cita

                p(
                    id="cancelarCitaNumero"
                    class="text-red-100 text-sm mt-1"
                ) Cita #-

            button(
                type="button"
                id="btnCerrarCancelarCita"
                class="text-white hover:text-red-200 text-2xl transition"
                title="Cerrar"
            )
                i(class="fa-solid fa-xmark")


        // =================================================
        // CONTENIDO
        // =================================================

        div(class="p-6")

            // Advertencia
            div(
                class="bg-red-50 border border-red-200 rounded-xl p-4 mb-5"
            )

                div(class="flex items-start gap-3")

                    div(
                        class="w-9 h-9 rounded-lg bg-red-100 text-red-600 flex items-center justify-center shrink-0"
                    )
                        i(class="fa-solid fa-triangle-exclamation")

                    div

                        p(
                            class="font-semibold text-red-800"
                        )
                            | ¿Desea cancelar esta cita?

                        p(
                            class="text-sm text-red-700 mt-1"
                        )
                            | Esta acción cambiará el estado de la cita a Cancelada.


            // =================================================
            // INFORMACIÓN DE LA CITA
            // =================================================

            div(
                class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-5"
            )

                div(
                    class="grid grid-cols-1 gap-4"
                )

                    div
                        p(
                            class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1"
                        ) Paciente

                        p(
                            id="cancelarPaciente"
                            class="font-semibold text-slate-800"
                        ) -

                    div
                        p(
                            class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1"
                        ) Médico

                        p(
                            id="cancelarMedico"
                            class="font-semibold text-slate-800"
                        ) -

                    div(
                        class="grid grid-cols-2 gap-4"
                    )

                        div
                            p(
                                class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1"
                            ) Fecha

                            p(
                                id="cancelarFecha"
                                class="font-medium text-slate-800"
                            ) -

                        div
                            p(
                                class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1"
                            ) Hora

                            p(
                                id="cancelarHora"
                                class="font-medium text-slate-800"
                            ) -


            // =================================================
            // MOTIVO
            // =================================================

            div

                label(
                    for="cancelarMotivo"
                    class="block text-sm font-semibold text-slate-700 mb-2"
                )
                    | Motivo de cancelación

                textarea(
                    id="cancelarMotivo"
                    rows="4"
                    maxlength="500"
                    required
                    placeholder="Ingrese el motivo de la cancelación..."
                    class="w-full border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500 resize-none"
                )


            // =================================================
            // ERROR
            // =================================================

            div(
                id="errorCancelarCita"
                class="hidden mt-4 bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3"
            )

                div(class="flex items-start gap-3")

                    i(class="fa-solid fa-circle-exclamation mt-1")

                    div

                        p(
                            class="font-semibold"
                        )
                            | No se puede cancelar la cita

                        p(
                            id="mensajeErrorCancelarCita"
                            class="text-sm mt-1"
                        )


            // =================================================
            // ÉXITO
            // =================================================

            div(
                id="exitoCancelarCita"
                class="hidden mt-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3"
            )

                i(class="fa-solid fa-circle-check mr-2")

                | La cita fue cancelada correctamente.


            // =================================================
            // BOTONES
            // =================================================

            div(
                class="flex justify-end gap-3 mt-6"
            )

                button(
                    type="button"
                    id="btnCancelarCancelarCita"
                    class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold hover:bg-slate-100 transition"
                )
                    | Volver

                button(
                    type="button"
                    id="btnConfirmarCancelarCita"
                    class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold transition"
                )

                    i(class="fa-solid fa-calendar-xmark mr-2")

                    | Cancelar Cita