// MODAL GESTIONAR HORARIOS
div(
    id="modalGestionarHorarios"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 px-4"
)
    div(
        class="bg-white w-full max-w-4xl max-h-[90vh] rounded-2xl shadow-2xl overflow-hidden"
    )

        // CABECERA
        div(class="flex items-center justify-between px-6 py-5 border-b border-slate-200")
            div(class="flex items-center gap-4")
                div(class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center")
                    i(class="fa-solid fa-user-doctor text-lg")

                div
                    h2(
                        id="modalNombreMedico"
                        class="text-xl font-bold text-slate-800"
                    )
                        | Gestionar horarios

                    p(
                        id="modalEspecialidadMedico"
                        class="text-sm text-slate-500 mt-1"
                    )
                        | Especialidad

            button(
                type="button"
                id="btnCerrarGestionHorarios"
                class="w-10 h-10 rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition"
            )
                i(class="fa-solid fa-xmark text-lg")

        // CONTENIDO
        div(class="p-6 overflow-y-auto max-h-[calc(90vh-180px)]")

            // ENCABEZADO DE HORARIOS
            div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5")

                div
                    h3(class="text-lg font-bold text-slate-800")
                        | Horarios registrados

                    p(
                        id="contadorHorariosModal"
                        class="text-sm text-slate-500 mt-1"
                    )
                        | 0 horarios

                button(
                    type="button"
                    id="btnAgregarHorarioModal"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-sm transition"
                )
                    i(class="fa-solid fa-plus")
                    | Agregar horario

            // SELECCIONAR MÉDICO PARA NUEVO HORARIO
            div(
                id="selectorMedicoNuevoHorario"
                class="hidden mb-6 p-5 bg-blue-50 border border-blue-200 rounded-2xl"
            )

                div(class="flex items-center gap-3 mb-4")

                    div(
                        class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center"
                    )
                        i(class="fa-solid fa-user-doctor")

                    div
                        h3(class="font-bold text-slate-800")
                            | Seleccionar médico

                        p(class="text-sm text-slate-500")
                            | Selecciona el médico al que deseas asignar el nuevo horario.

                select(
                    id="selectMedicoNuevoHorario"
                    class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                )
                    option(value="")
                        | Selecciona un médico
            // FORMULARIO NUEVO HORARIO
            div(
                id="formularioNuevoHorario"
                class="hidden mb-6 p-5 bg-slate-50 border border-slate-200 rounded-2xl"
            )

                div(class="flex items-center justify-between mb-5")

                    div(class="flex items-center gap-3")

                        div(
                            id="iconoEstadoFormularioHorario"
                            class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center"
                        )
                            i(class="fa-solid fa-plus")

                        div
                            h3(
                                id="tituloFormularioHorario"
                                class="font-bold text-slate-800"
                            )
                                | Nuevo horario

                            p(
                                id="descripcionFormularioHorario"
                                class="text-sm text-slate-500 mt-1"
                            )
                                | Configura el período y los días de atención.

                    button(
                        type="button"
                        id="btnCancelarNuevoHorario"
                        class="text-slate-400 hover:text-slate-600"
                    )
                        i(class="fa-solid fa-xmark text-lg")


                form#formNuevoHorario

                    input(
                        type="hidden"
                        id="horario_medico_id"
                    )


                    // FECHAS
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5")

                        div
                            label(
                                for="horario_fecha_inicio"
                                class="block text-sm font-semibold text-slate-700 mb-2"
                            )
                                | Fecha de inicio

                            input(
                                type="date"
                                id="horario_fecha_inicio"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                            )

                        div
                            label(
                                for="horario_fecha_fin"
                                class="block text-sm font-semibold text-slate-700 mb-2"
                            )
                                | Fecha de finalización

                            input(
                                type="date"
                                id="horario_fecha_fin"
                                required
                                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                            )


                    // Días y horarios de atención
                    div(class="space-y-4")

                        label(class="block text-sm font-semibold text-gray-700")
                            | Días y horarios de atención

                        // Lunes
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Lunes"
                                    id="diaLunes"
                                )
                                label(
                                    for="diaLunes"
                                    class="font-medium cursor-pointer"
                                ) Lunes

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Lunes"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Lunes"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Lunes"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Martes
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Martes"
                                    id="diaMartes"
                                )
                                label(
                                    for="diaMartes"
                                    class="font-medium cursor-pointer"
                                ) Martes

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Martes"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Martes"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Martes"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Miércoles
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Miercoles"
                                    id="diaMiercoles"
                                )
                                label(
                                    for="diaMiercoles"
                                    class="font-medium cursor-pointer"
                                ) Miércoles

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Miercoles"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Miercoles"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Miercoles"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Jueves
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Jueves"
                                    id="diaJueves"
                                )
                                label(
                                    for="diaJueves"
                                    class="font-medium cursor-pointer"
                                ) Jueves

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Jueves"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Jueves"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Jueves"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Viernes
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Viernes"
                                    id="diaViernes"
                                )
                                label(
                                    for="diaViernes"
                                    class="font-medium cursor-pointer"
                                ) Viernes

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Viernes"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Viernes"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Viernes"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Sábado
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Sabado"
                                    id="diaSabado"
                                )
                                label(
                                    for="diaSabado"
                                    class="font-medium cursor-pointer"
                                ) Sábado

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Sabado"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Sabado"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Sabado"
                                        min="07:00"
                                        max="19:00"
                                    )

                        // Domingo
                        div(class="diaHorarioContainer border rounded-lg p-4")
                            div(class="flex items-center gap-3")
                                input(
                                    type="checkbox"
                                    class="diaHorario"
                                    value="Domingo"
                                    id="diaDomingo"
                                )
                                label(
                                    for="diaDomingo"
                                    class="font-medium cursor-pointer"
                                ) Domingo

                            div(
                                class="horasDia hidden mt-3 grid grid-cols-1 md:grid-cols-2 gap-3"
                                data-dia="Domingo"
                            )
                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora inicio
                                    input(
                                        type="time"
                                        class="horaInicioDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Domingo"
                                        min="07:00"
                                        max="19:00"
                                    )

                                div
                                    label(class="block text-sm text-gray-600 mb-1") Hora fin
                                    input(
                                        type="time"
                                        class="horaFinDia w-full border rounded-lg px-3 py-2"
                                        data-dia="Domingo"
                                        min="07:00"
                                        max="19:00"
                                    )


                    // BOTONES
                    div(class="flex justify-end gap-3")

                        button(
                            type="button"
                            id="btnCancelarNuevoHorario2"
                            class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-100"
                        )
                            | Cancelar

                        button(
                            type="submit"
                            id="btnGuardarHorario"
                            class="px-5 py-2.5 bg-green-600 text-white rounded-xl font-semibold hover:bg-green-700 transition"
                        )
                            i(
                                id="iconoBotonHorario"
                                class="fa-solid fa-floppy-disk mr-2"
                            )
                            span(id="textoBotonHorario")
                                | Guardar horario

            // LISTA DE HORARIOS
            div(
                id="listaHorariosModal"
                class="space-y-3"
            )

            // SIN HORARIOS
            div(
                id="sinHorariosModal"
                class="hidden py-12 text-center"
            )
                div(class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400 mb-4")
                    i(class="fa-regular fa-calendar-xmark text-2xl")

                h3(class="font-bold text-slate-700")
                    | No hay horarios registrados

                p(class="text-sm text-slate-500 mt-1")
                    | Este médico todavía no tiene horarios configurados.

        // PIE
        div(class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end")
            button(
                type="button"
                id="btnCerrarGestionHorarios2"
                class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-xl font-semibold hover:bg-slate-100 transition"
            )
                | Cerrar