// =====================================================
// MODAL VER MÉDICO
// =====================================================

div#modalVerMedico(
    class="hidden fixed inset-0 z-50 items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
)

    div(
        class="bg-white w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-3xl shadow-2xl"
    )

        // ===============================
        // HEADER
        // ===============================

        div(
            class="flex items-center justify-between px-6 py-5 border-b border-slate-200"
        )

            div(class="flex items-center gap-4")

                div(
                    class="w-12 h-12 rounded-2xl bg-blue-100 flex items-center justify-center"
                )
                    i(class="fa-solid fa-user-doctor text-blue-600 text-xl")

                div

                    h2(
                        class="text-xl font-bold text-slate-800"
                    )
                        | Información del médico

                    p(
                        id="ver_medico_nombre"
                        class="text-sm text-slate-500 mt-1"
                    )
                        | Cargando...

            button#btnCerrarVerMedico(
                type="button"
                class="w-10 h-10 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition"
            )
                i(class="fa-solid fa-xmark text-lg")

        // ===============================
        // CONTENIDO
        // ===============================

        div(class="p-6 space-y-6")

            // ===============================
            // INFORMACIÓN PERSONAL
            // ===============================

            div

                h3(
                    class="text-sm font-bold text-slate-800 uppercase tracking-wide mb-4"
                )
                    | Información personal

                div(
                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                )

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Nombres y apellidos

                        p(
                            id="ver_medico_nombre_completo"
                            class="font-semibold text-slate-800"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Documento

                        p(
                            id="ver_medico_documento"
                            class="font-semibold text-slate-800"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Correo electrónico

                        p(
                            id="ver_medico_correo"
                            class="font-semibold text-slate-800 break-all"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Teléfono

                        p(
                            id="ver_medico_telefono"
                            class="font-semibold text-slate-800"
                        )
                            | N/A

            // ===============================
            // INFORMACIÓN PROFESIONAL
            // ===============================

            div

                h3(
                    class="text-sm font-bold text-slate-800 uppercase tracking-wide mb-4"
                )
                    | Información profesional

                div(
                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                )

                    div(
                        class="bg-blue-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-blue-600 mb-1")
                            | Especialidad

                        p(
                            id="ver_medico_especialidad"
                            class="font-semibold text-blue-800"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Cédula profesional

                        p(
                            id="ver_medico_cedula"
                            class="font-semibold text-slate-800"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Años de experiencia

                        p(
                            id="ver_medico_experiencia"
                            class="font-semibold text-slate-800"
                        )
                            | N/A

                    div(
                        class="bg-slate-50 rounded-xl p-4"
                    )

                        p(class="text-xs text-slate-500 mb-1")
                            | Estado

                        span(
                            id="ver_medico_estado"
                            class="inline-flex px-3 py-1 rounded-full text-xs font-medium"
                        )
                            | N/A

            // ===============================
            // REGISTRO
            // ===============================

            div(
                class="bg-slate-50 rounded-xl p-4"
            )

                p(class="text-xs text-slate-500 mb-1")
                    | Fecha de registro

                p(
                    id="ver_medico_fecha_registro"
                    class="font-semibold text-slate-800"
                )
                    | N/A
            //- ==============================
            //- HORARIOS DE ATENCIÓN
            //- ==============================
            div(class="mt-6")
                div(class="flex items-center gap-2 mb-4")
                    i(class="fa-solid fa-calendar-days text-blue-600")
                    h3(class="text-lg font-semibold text-slate-800")
                        | Horarios de atención

                div#ver_medico_horarios(class="space-y-3")
                    //- Los horarios se cargan mediante JavaScript
        // ===============================
        // FOOTER
        // ===============================

        div(
            class="flex justify-end px-6 py-4 border-t border-slate-200"
        )

            button#btnCerrarVerMedicoFooter(
                type="button"
                class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition"
            )
                | Cerrar