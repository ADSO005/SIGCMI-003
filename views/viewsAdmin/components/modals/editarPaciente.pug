// =====================================================
// MODAL EDITAR PACIENTE
// =====================================================

div#modalEditarPaciente(
    class="hidden fixed inset-0 z-50 items-center justify-center p-3 sm:p-5"
)

    // Fondo
    div(
        class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm"
    )

    // Contenedor
    div(
        class="relative w-full max-w-5xl max-h-[94vh] overflow-hidden rounded-2xl sm:rounded-3xl bg-white shadow-2xl flex flex-col"
    )

        // =================================================
        // HEADER
        // =================================================

        div(
            class="relative overflow-hidden bg-gradient-to-r from-indigo-600 via-violet-600 to-purple-600 px-5 py-6 sm:px-8"
        )

            div(
                class="absolute -right-10 -top-16 h-40 w-40 rounded-full bg-white/10"
            )

            div(
                class="absolute -bottom-20 left-1/3 h-48 w-48 rounded-full bg-white/5"
            )

            div(
                class="relative flex items-start justify-between gap-4"
            )

                div(class="flex items-center gap-4")

                    div(
                        class="flex h-12 w-12 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white ring-1 ring-white/20"
                    )
                        i(class="fa-solid fa-user-pen text-xl sm:text-2xl")

                    div
                        p(
                            class="text-xs font-medium uppercase tracking-wider text-indigo-100"
                        ) Gestión de pacientes

                        h2(
                            class="mt-1 text-xl sm:text-2xl font-bold text-white"
                        ) Editar paciente

                        p(
                            class="mt-1 text-sm text-indigo-100"
                        ) Actualiza la información del paciente

                button#btnCerrarEditarPaciente(
                    type="button"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-white/80 transition hover:bg-white/10 hover:text-white"
                    aria-label="Cerrar"
                )
                    i(class="fa-solid fa-xmark text-xl")

        // =================================================
        // FORMULARIO
        // =================================================

        form#formEditarPaciente(
            class="flex-1 overflow-y-auto px-5 py-6 sm:px-8"
        )

            input#editar_id_paciente(
                type="hidden"
            )

            // =============================================
            // DATOS PERSONALES
            // =============================================

            div(class="mb-7")

                div(class="mb-4 flex items-center gap-3")

                    div(
                        class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"
                    )
                        i(class="fa-solid fa-user")

                    div
                        h3(class="font-semibold text-slate-800")
                            | Información personal

                        p(class="text-xs text-slate-500")
                            | Datos básicos del paciente

                div(
                    class="grid grid-cols-1 gap-4 md:grid-cols-2"
                )

                    div
                        label(
                            for="editar_nombres"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Nombres *

                        input#editar_nombres(
                            type="text"
                            name="nombres"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div
                        label(
                            for="editar_apellidos"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Apellidos *

                        input#editar_apellidos(
                            type="text"
                            name="apellidos"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div
                        label(
                            for="editar_tipo_documento"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Tipo de documento *

                        select#editar_tipo_documento(
                            name="tipo_documento"
                            required
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )
                            option(value="") Selecciona una opción
                            option(value="CC") Cédula de ciudadanía
                            option(value="TI") Tarjeta de identidad
                            option(value="CE") Cédula de extranjería
                            option(value="Pasaporte") Pasaporte

                    div
                        label(
                            for="editar_numero_documento"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Número de documento *

                        input#editar_numero_documento(
                            type="text"
                            name="numero_documento"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

            // =============================================
            // CONTACTO
            // =============================================

            div(class="mb-7")

                div(class="mb-4 flex items-center gap-3")

                    div(
                        class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 text-blue-600"
                    )
                        i(class="fa-solid fa-address-book")

                    div
                        h3(class="font-semibold text-slate-800")
                            | Información de contacto

                        p(class="text-xs text-slate-500")
                            | Medios de contacto del paciente

                div(
                    class="grid grid-cols-1 gap-4 md:grid-cols-2"
                )

                    div
                        label(
                            for="editar_correo"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Correo electrónico *

                        input#editar_correo(
                            type="email"
                            name="correo"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div
                        label(
                            for="editar_telefono"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Teléfono *

                        input#editar_telefono(
                            type="tel"
                            name="telefono"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

            // =============================================
            // INFORMACIÓN MÉDICA
            // =============================================

            div(class="mb-7")

                div(class="mb-4 flex items-center gap-3")

                    div(
                        class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600"
                    )
                        i(class="fa-solid fa-heart-pulse")

                    div
                        h3(class="font-semibold text-slate-800")
                            | Información médica

                        p(class="text-xs text-slate-500")
                            | Información clínica básica

                div(
                    class="grid grid-cols-1 gap-4 md:grid-cols-2"
                )

                    div
                        label(
                            for="editar_fecha_nacimiento"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Fecha de nacimiento

                        input#editar_fecha_nacimiento(
                            type="date"
                            name="fecha_nacimiento"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div
                        label(
                            for="editar_tipo_sangre"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Tipo de sangre

                        select#editar_tipo_sangre(
                            name="tipo_sangre"
                            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )
                            option(value="") No especificado
                            option(value="A+") A+
                            option(value="A-") A-
                            option(value="B+") B+
                            option(value="B-") B-
                            option(value="AB+") AB+
                            option(value="AB-") AB-
                            option(value="O+") O+
                            option(value="O-") O-

                    div(class="md:col-span-2")

                        label(
                            for="editar_alergias"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Alergias

                        textarea#editar_alergias(
                            name="alergias"
                            rows="3"
                            class="w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                            placeholder="Indica las alergias conocidas..."
                        )

                    div(class="md:col-span-2")

                        label(
                            for="editar_condiciones_medicas"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Condiciones médicas

                        textarea#editar_condiciones_medicas(
                            name="condiciones_medicas"
                            rows="3"
                            class="w-full resize-none rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                            placeholder="Indica las condiciones médicas..."
                        )

            // =============================================
            // UBICACIÓN
            // =============================================

            div(class="mb-2")

                div(class="mb-4 flex items-center gap-3")

                    div(
                        class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-amber-600"
                    )
                        i(class="fa-solid fa-location-dot")

                    div
                        h3(class="font-semibold text-slate-800")
                            | Ubicación

                        p(class="text-xs text-slate-500")
                            | Información de residencia

                div(
                    class="grid grid-cols-1 gap-4 md:grid-cols-2"
                )

                    div
                        label(
                            for="editar_departamento"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Departamento

                        input#editar_departamento(
                            type="text"
                            name="departamento"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div
                        label(
                            for="editar_ciudad"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Ciudad

                        input#editar_ciudad(
                            type="text"
                            name="ciudad"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

                    div(class="md:col-span-2")

                        label(
                            for="editar_direccion"
                            class="mb-1.5 block text-sm font-medium text-slate-700"
                        ) Dirección

                        input#editar_direccion(
                            type="text"
                            name="direccion"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
                        )

        // =================================================
        // FOOTER
        // =================================================

        div(
            class="flex flex-col-reverse gap-3 border-t border-slate-100 bg-slate-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-8"
        )

            button#btnCancelarEditarPaciente(
                type="button"
                class="w-full rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 sm:w-auto"
            )
                i(class="fa-solid fa-xmark mr-2")
                | Cancelar

            button#btnGuardarEditarPaciente(
                type="submit"
                form="formEditarPaciente"
                class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            )
                i(class="fa-solid fa-floppy-disk mr-2")
                | Guardar cambios