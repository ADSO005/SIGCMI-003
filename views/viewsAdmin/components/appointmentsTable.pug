//- ==========================================
//- CITAS DE HOY (estilo dashboard médico)
//- ==========================================

section(class="overflow-hidden rounded-[22px] border border-slate-200 bg-white shadow-sm")

    div(class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-6 py-5")

        div
            h2(class="flex items-center gap-2 text-lg font-bold text-[#10285e]")
                i(class="fa-solid fa-calendar-day text-[#315bd7]")
                | Citas de Hoy

            p(class="mt-1 text-sm text-slate-500") Pacientes programados para la fecha actual

        if citasHoy.length
            span(class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-[#315bd7]")= citasHoy.length + " citas"

    if citasHoy.length

        div(class="overflow-x-auto")

            table(class="w-full min-w-[640px] text-left text-sm")

                thead(class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500")

                    tr
                        th(class="px-6 py-3 font-semibold") Hora
                        th(class="px-6 py-3 font-semibold") Paciente
                        th(class="px-6 py-3 font-semibold") Médico
                        th(class="px-6 py-3 font-semibold") Estado
                        th(class="px-6 py-3 text-center font-semibold") Acción

                tbody(class="divide-y divide-slate-100")

                    each cita in citasHoy

                        tr(class="transition-colors hover:bg-blue-50/50")

                            td(class="px-6 py-4 font-bold text-[#10285e]")= cita.hora

                            td(class="px-6 py-4")
                                div(class="flex items-center gap-3")
                                    span(class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-100 text-[#315bd7]")
                                        i(class="fa-solid fa-user")
                                    span(class="font-semibold text-slate-800")= cita.Paciente.Usuario.nombres + " " + cita.Paciente.Usuario.apellidos

                            td(class="px-6 py-4")
                                div(class="flex items-center gap-3")
                                    span(class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-violet-100 text-violet-600")
                                        i(class="fa-solid fa-user-doctor")
                                    span(class="font-semibold text-slate-800")= "Dr. " + cita.Medico.Usuario.nombres + " " + cita.Medico.Usuario.apellidos

                            td(class="px-6 py-4")
                                if cita.Estado.nombre == "Pendiente"
                                    span(class="inline-flex rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700") Pendiente
                                else if cita.Estado.nombre == "Confirmada"
                                    span(class="inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700") Confirmada
                                else if cita.Estado.nombre == "Cancelada"
                                    span(class="inline-flex rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700") Cancelada
                                else
                                    span(class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700")= cita.Estado.nombre

                            td(class="px-6 py-4 text-center")
                                button(
                                    type="button"
                                    title="Ver cita"
                                    class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600 transition hover:bg-slate-200"
                                )
                                    i(class="fa-solid fa-eye")

    else

        div(class="flex flex-col items-center justify-center px-6 py-14 text-center")
            i(class="fa-regular fa-calendar-xmark text-4xl text-slate-300")
            h3(class="mt-4 text-lg font-semibold text-[#10285e]") No hay citas programadas
            p(class="mt-1 text-sm text-slate-500") Cuando existan citas para hoy aparecerán aquí automáticamente.
