.appointments-card(class="min-w-0 overflow-x-auto rounded-2xl border border-[#E2E8F0] bg-white p-4 shadow-sm sm:p-6")

    .card-header(class="flex flex-wrap items-start justify-between gap-3 border-b border-[#E2E8F0] pb-4")

        .card-title

            h2
                i.fa-solid.fa-calendar-day
                |  Citas de Hoy

            p Pacientes programados para la fecha actual

        if citasHoy.length

            span.badge-total= citasHoy.length + " citas"
    
    if citasHoy.length
        
        table.appointments-table(class="min-w-[680px] w-full border-collapse text-left text-sm text-[#001B4D] [&_thead]:bg-[#F1FEF8] [&_th]:border-b [&_th]:border-[#E2E8F0] [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_td]:border-b [&_td]:border-[#E2E8F0] [&_td]:px-4 [&_td]:py-3 [&_tbody_tr:hover]:bg-[#F8FFFF]")

            thead

                tr

                    th Hora

                    th Paciente

                    th Médico

                    th Estado

                    th.text-center Acción

            tbody

                each cita in citasHoy

                    tr

                        td
                            strong= cita.hora

                        td

                            .table-user

                                .table-avatar

                                    i.fa-solid.fa-user

                                .table-info

                                    strong= cita.Paciente.Usuario.nombres + " " + cita.Paciente.Usuario.apellidos

                        td

                            .table-user

                                .table-avatar.doctor

                                    i.fa-solid.fa-user-doctor

                                .table-info

                                    strong= "Dr. " + cita.Medico.Usuario.nombres + " " + cita.Medico.Usuario.apellidos

                        td

                            if cita.Estado.nombre == "Pendiente"

                                span.status.pending Pendiente

                            else if cita.Estado.nombre == "Confirmada"

                                span.status.completed Confirmada

                            else if cita.Estado.nombre == "Cancelada"

                                span.status.cancelled Cancelada

                            else

                                span.status= cita.Estado.nombre

                        td.text-center

                            button.table-btn(type="button")

                                i.fa-solid.fa-eye

    else

        .empty-state

            i.fa-regular.fa-calendar-xmark

            h3 No hay citas programadas

            p Cuando existan citas para hoy aparecerán aquí automáticamente.