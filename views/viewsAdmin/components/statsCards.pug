mixin tarjetaResumen(titulo, valor, detalle, icono, claseIcono, claseBorde)
    article(class=`min-w-0 rounded-[22px] border border-[#E2E8F0] ${claseBorde} p-5 shadow-sm`)
        div(class="flex items-start gap-3")
            div(class=`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${claseIcono}`)
                i(class=`fa-solid ${icono} text-lg`)
            h3(class="min-w-0 text-base font-semibold leading-6 text-slate-950")= titulo
        p(class="mt-6 text-5xl font-bold leading-none tracking-tight text-slate-950")= valor
        p(class="mt-3 text-sm leading-5 text-slate-600")= detalle

section(aria-label="Resumen de citas" class="grid grid-cols-1 gap-4 min-[640px]:grid-cols-2 min-[1200px]:grid-cols-4")
    +tarjetaResumen("Citas Hoy", stats.citasHoy, "Programadas para hoy", "fa-calendar-check", "bg-[#335CD8]/10 text-[#335CD8]", "bg-white")
    +tarjetaResumen("Pacientes Activos", stats.pacientesActivos, "Pacientes con cuenta activa", "fa-users", "bg-[#059669]/10 text-[#059669]", "bg-[#F1FEF8]")
    +tarjetaResumen("Médicos Disponibles", stats.medicosDisponibles, "Médicos activos en el sistema", "fa-user-doctor", "bg-[#3C62BE]/10 text-[#3C62BE]", "bg-[#FAF9FF]")
    +tarjetaResumen("Tiempo Promedio Espera", `${stats.tiempoEspera} min`, "Por consulta", "fa-clock", "bg-[#00BC8D]/10 text-[#00BC8D]", "bg-[#F8FFFF]")
