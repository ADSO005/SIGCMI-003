//- ==========================================
//- TARJETAS DE RESUMEN (estilo dashboard médico)
//- ==========================================

mixin tarjetaResumen(titulo, valor, detalle, icono, claseIcono, claseBorde)
    article(class=`min-w-0 rounded-[22px] border ${claseBorde} bg-gradient-to-br from-white to-slate-50 p-5 shadow-sm`)
        div(class="flex items-start gap-3")
            div(class=`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${claseIcono}`)
                i(class=`fa-solid ${icono} text-lg`)
            h3(class="min-w-0 text-base font-semibold leading-6 text-slate-950")= titulo
        p(class="mt-6 text-5xl font-bold leading-none tracking-tight text-slate-950")= valor
        p(class="mt-3 text-sm leading-5 text-slate-600")= detalle

section(aria-label="Resumen de citas" class="grid grid-cols-1 gap-4 min-[640px]:grid-cols-2 min-[1200px]:grid-cols-4")
    +tarjetaResumen("Citas Hoy", stats.citasHoy, "Programadas para hoy", "fa-calendar-check", "bg-blue-100/80 text-[#315bd7]", "border-blue-200")
    +tarjetaResumen("Pacientes Activos", stats.pacientesActivos, "Pacientes con cuenta activa", "fa-users", "bg-emerald-100/80 text-emerald-600", "border-emerald-100")
    +tarjetaResumen("Médicos Disponibles", stats.medicosDisponibles, "Médicos activos en el sistema", "fa-user-doctor", "bg-violet-100/80 text-violet-600", "border-violet-100")
    +tarjetaResumen("Tiempo Promedio Espera", `${stats.tiempoEspera} min`, "Por consulta", "fa-clock", "bg-amber-100/80 text-amber-600", "border-amber-100")
