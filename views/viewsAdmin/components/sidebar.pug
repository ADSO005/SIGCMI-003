//- ==========================================
//- SIDEBAR ADMINISTRATIVO
//- Mismos estilos que el sidebar del portal médico (viewsMedico/includes/sidebar.pug).
//- Hooks de toggleSidebar.js: #sidebar con las clases "collapsed" (escritorio) y "open" (móvil).
//- ==========================================

dialog#logoutModal(
    aria-labelledby="logoutModalTitle"
    class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/60"
)
    div(class="p-6")
        h2#logoutModalTitle(class="text-xl font-bold text-[#10285e]")
            | Confirmar cierre de sesión

        p(class="mt-2 text-slate-600")
            | ¿Seguro que deseas cerrar tu sesión?

        div(class="mt-6 flex justify-end gap-3")
            button(
                type="button"
                onclick="document.getElementById('logoutModal').close()"
                class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-100"
            )
                | Cancelar

            form(action="/auth/logout" method="POST")
                button(
                    type="submit"
                    class="rounded-lg bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-700"
                )
                    | Sí, cerrar sesión


mixin enlaceAdmin(href, icono, texto)
    a.nav-link(
        href=href
        title=texto
        class="mb-2 flex h-12 shrink-0 items-center gap-3 rounded-xl px-3 py-2 text-[15px] font-medium text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.38)] [&.preActive]:!shadow-[inset_0_0_0_1px_rgba(255,255,255,0.14)]"
    )
        i(class=`${icono} w-[18px] shrink-0 text-center text-[17px]`)
        .nav-item(class="group-[.collapsed]:hidden")= texto

aside#sidebar.sidebar.group(
    class="sticky top-0 z-[1000] flex h-screen w-[290px] shrink-0 flex-col self-start overflow-hidden bg-gradient-to-b from-[#263c91] via-[#263f9e] to-[#1f367f] px-6 text-white shadow-xl font-[Arial,sans-serif] [&.collapsed]:px-5 transition-all duration-300 ease-[ease] [&.collapsed]:w-[80px] [@media(max-width:768px)]:fixed [@media(max-width:768px)]:left-0 [@media(max-width:768px)]:w-[280px] [@media(max-width:768px)]:-translate-x-full [@media(max-width:768px)]:transition-transform [@media(max-width:768px)]:ease-[cubic-bezier(0.4,0,0.2,1)] [@media(max-width:768px)]:[&.open]:translate-x-0"
)

    //- LOGO Y BOTÓN DE MENÚ
    .logo(class="flex h-[82px] shrink-0 items-center justify-between px-1 group-[.collapsed]:justify-center group-[.collapsed]:px-0")
        span.logo-text(class="flex items-center gap-3 text-[26px] leading-none font-bold tracking-wide group-[.collapsed]:hidden")
            svg(class="h-9 w-9 text-teal-300" viewBox="0 0 40 40" fill="none" aria-hidden="true")
                path(d="M20 3v34M3 20h34" stroke="currentColor" stroke-width="10" stroke-linecap="round")
                path(d="M20 9v22M9 20h22" stroke="#60a5fa" stroke-width="6" stroke-linecap="round")
            | SIGCMI
        button#toggleBtn(
            type="button"
            class="flex h-10 w-10 shrink-0 items-center justify-center cursor-pointer border-0 bg-transparent text-[22px] text-white transition-transform duration-200 hover:scale-110"
            onclick="toggleSidebar()"
            aria-label="Abrir o cerrar menú"
        ) ☰

    hr.line-1(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20")

    //- USUARIO
    .user(class="flex min-h-[120px] shrink-0 items-start gap-4 py-6 group-[.collapsed]:hidden")
        .avatar(class="mt-1 flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/40 bg-white/15 shadow-inner")
            img.avatar-img(
                class="h-8 w-8 brightness-0 invert"
                src="/medico/img/icono-medico-avatar.svg"
                alt="Avatar"
            )
        div(class="min-w-0 flex-1")
            p.bienvenido-txt(class="text-sm leading-5 text-blue-100") Bienvenido
            h4(class="truncate text-base leading-5 font-semibold text-white")= usuarios.nombre
            span(class="mt-1 inline-block rounded-full bg-white/15 px-2.5 py-1 text-xs leading-4 text-blue-50") Administrador

    hr.line-2(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20 group-[.collapsed]:hidden")

    //- NAVEGACIÓN (con scroll propio: son varios enlaces)
    nav(class="flex min-h-0 flex-1 flex-col overflow-y-auto pt-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden")
        +enlaceAdmin("/admin/dashboard", "fa-solid fa-house", "Dashboard")
        +enlaceAdmin("/admin/usuarios", "fa-solid fa-users", "Usuarios")
        +enlaceAdmin("/admin/pacientes", "fa-solid fa-heart-pulse", "Pacientes")
        +enlaceAdmin("/admin/medicos", "fa-solid fa-user-doctor", "Médicos")
        +enlaceAdmin("/admin/especialidades", "fa-solid fa-hospital", "Especialidades")
        +enlaceAdmin("/admin/citas", "fa-solid fa-calendar-check", "Citas")
        +enlaceAdmin("/admin/calendario", "fa-solid fa-calendar-days", "Calendario")
        +enlaceAdmin("/admin/horarios", "fa-solid fa-clock", "Horarios")
        +enlaceAdmin("/admin/diagnosticos", "fa-solid fa-stethoscope", "Diagnósticos")
        +enlaceAdmin("/admin/prescripciones", "fa-solid fa-pills", "Prescripciones")
        +enlaceAdmin("/admin/whatsapp", "fa-brands fa-whatsapp", "WhatsApp")
        +enlaceAdmin("/admin/reportes", "fa-solid fa-chart-column", "Reportes")

    hr.line-3(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20")

    //- CERRAR SESIÓN (pide confirmación)
    button(
        type="button"
        onclick="document.getElementById('logoutModal').showModal()"
        aria-haspopup="dialog"
        aria-controls="logoutModal"
        aria-label="Cerrar sesión"
        class="flex min-h-[68px] w-full shrink-0 cursor-pointer items-center gap-3 border-0 bg-transparent px-1 text-white group-[.collapsed]:justify-center transition-opacity hover:opacity-75"
    )
        img.log-out(
            class="h-7 w-7 shrink-0 brightness-0 invert"
            src="/medico/img/icono-salir.svg"
            alt=""
        )
        span.sesionlogout(class="text-[16px] text-white group-[.collapsed]:hidden") Cerrar sesión

//- Marca el enlace de la sección actual (misma clase preActive que el portal médico)
script.
    (function () {
        var ruta = window.location.pathname;
        document.querySelectorAll('#sidebar nav a').forEach(function (enlace) {
            var destino = enlace.getAttribute('href');
            var coincide = destino === '/admin/dashboard'
                ? ruta === destino
                : ruta === destino || ruta.indexOf(destino + '/') === 0;
            if (coincide) enlace.classList.add('preActive');
        });
    })();
