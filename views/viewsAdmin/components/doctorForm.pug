div(
    id="informacion_doctor"
    class="mb-10"
)

    div(class="flex items-center gap-3 mb-6")

        div(class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center")
            i(class="fa-solid fa-certificate text-indigo-600")

        div
            h3(class="text-xl font-bold text-slate-800")
                | Información Profesional 
        
    div(class="flex flex-col sm:flex-row gap-4")
        div(class="flex-1")
            label(
                for="numero_tarjeta_profesional"
                class="block text-sm font-semibold text-slate-700 mb-2"
            ) Tarjeta profesional *

            input(
                type="text"
                id="numero_tarjeta_profesional"
                name="numero_tarjeta_profesional"
                required
                maxlength="30"
                placeholder="Ingrese el número"
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
            )

        div(class="flex-1")
            label(
                for="anos_experiencia"
                class="block text-sm font-semibold text-slate-700 mb-2"
            ) Años de experiencia *

            input(
                type="number"
                id="anos_experiencia"
                name="anos_experiencia"
                required
                min="0"
                max="60"
                placeholder="Ej. 5"
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
            )