//- ==========================================
//- DATOS PROFESIONALES DEL MÉDICO (solo rol 2)
//- Los campos de esta sección se deshabilitan por JS cuando el rol no es médico.
//- ==========================================

div#seccion-medico(data-rol="2" class="hidden mb-10")

    +encabezadoSeccion("fa-solid fa-user-doctor", "bg-indigo-100", "text-indigo-600", "Información profesional", "Especialidad y datos de registro profesional")

    div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
        div(class="md:col-span-2")
            label(for="especialidad_id" class="block text-sm font-semibold text-slate-700 mb-2")
                | Especialidad
                |  *
            select#especialidad_id(
                name="especialidad_id"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-white"
            )
                option(value="") Seleccione una especialidad
                each especialidad in (especialidades || [])
                    - const marcada = String(especialidad.id_especialidad) === String(valores.especialidad_id ?? "")
                    option(value=especialidad.id_especialidad selected=marcada)= especialidad.nombre
            if !especialidades || !especialidades.length
                p(class="mt-2 text-sm text-amber-600")
                    | No hay especialidades registradas.
                    |
                    a(href="/admin/especialidades" class="underline") Crear especialidad

        +campoTexto("cedula_profesional", "Tarjeta o cédula profesional", "text", { requerido: true, maxlength: 50, placeholder: "Ingrese el número", valor: valores.cedula_profesional })
        +campoTexto("anios_experiencia", "Años de experiencia", "number", { min: 0, max: 60, placeholder: "Ej. 5", valor: valores.anios_experiencia })
