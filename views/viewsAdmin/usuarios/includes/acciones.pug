div(class="border-t border-slate-200 pt-6 flex flex-col sm:flex-row justify-end gap-3")

    a(
        href="/admin/usuarios"
        class="px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-center transition"
