//- Formulario para ingresar y validar el código temporal enviado por correo.
extends ../layouts/layout

block contenido

    main(class="min-h-screen bg-[#F4F8FF] flex items-center justify-center px-4")

        .bg-white.rounded-3xl.shadow-2xl.w-full.max-w-md.overflow-hidden

            .px-8.py-6.text-center(class="bg-[#263F9D]")

                h1.text-3xl.font-bold.text-white
                    | SIGCMI

                p.mt-2.text-blue-100
                    | Verificación de seguridad

            .p-8

                h2.text-2xl.font-bold.text-center.mb-3(class="text-[#001B4D]")
                    | Verifica tu código

                if mensaje
                    div(
                        id="mensajeExito"
                        class="mb-5 rounded-lg bg-[#F1FEF8] border border-[#059669]/30 px-4 py-3 text-[#059669] text-sm text-center"
                        role="status"
                    )
                        | #{mensaje}

                if error
                    div(
                        id="mensajeError"
                        class="mb-5 rounded-lg bg-red-100 border border-red-300 px-4 py-3 text-red-700 text-sm text-center"
                    )
                        | #{error}

                form(
                    action="/auth/verify-otp"
                    method="POST"
                    class="space-y-5"
                )

                    input(type="hidden" name="correo" value=correo || "")

                    div

                        label(
                            for="codigo"
                            class="block mb-2 text-sm font-semibold text-[#001B4D]"
                        )
                            | Código de verificación

                        input(
                            id="codigo"
                            name="codigo"
                            type="text"
                            inputmode="numeric"
                            maxlength="6"
                            minlength="6"
                            pattern="[0-9]{6}"
                            placeholder="Ingresa tu código"
                            required
                            class="w-full rounded-xl border border-[#E2E8F0] bg-slate-50 px-4 py-3 text-center tracking-widest text-lg text-slate-700 outline-none transition-all duration-200 focus:border-[#335CD8] focus:bg-white focus:ring-4 focus:ring-[#335CD8]/10"
                        )

                    div.mt-6.flex.gap-4.px-2

                        a(
                            href="/auth/recover-password"
                            class="w-full text-center bg-gray-300 hover:bg-gray-500 text-black font-semibold py-3 rounded-xl transition-colors  duration-200"
                        )
                            | Reenviar código

                        button(
                            type="submit"
                            class="w-full bg-[#335CD8] hover:bg-[#263F9D] text-white font-semibold py-3 rounded-xl transition-colors duration-200"
                        )
                            | Verificar código

    script(src="/auth/js/verify-otp.js" defer)


