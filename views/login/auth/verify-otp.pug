extends ../layouts/layout

block contenido

    main(class="min-h-screen bg-slate-100 flex items-center justify-center px-4")

        .bg-white.rounded-3xl.shadow-2xl.w-full.max-w-md.overflow-hidden

            .bg-blue-700.px-8.py-6.text-center

                h1.text-3xl.font-bold.text-white
                    | SIGCMI

                p.mt-2.text-blue-100
                    | Verificación de seguridad

            .p-8

                h2.text-2xl.font-bold.text-center.text-slate-800.mb-3
                    | Verifica tu código

                p.text-center.text-slate-500.mb-6
                    | Hemos enviado un código de 6 dígitos a tu correo electrónico.

                if error
                    div(
                        id="mensajeError"
                        class="mb-5 rounded-lg bg-red-100 border border-red-300 px-4 py-3 text-red-700 text-sm text-center"
                    )
                        | #{error}

                form(
                    action="/auth/verify-otp"
                    method="POST"
                    class="space-y-5"
                )

                    div

                        label(
                            for="codigo"
                            class="block mb-2 text-sm font-semibold text-slate-700"
                        )
                            | Código de verificación

                        input(
                            id="codigo"
                            name="codigo"
                            type="text"
                            inputmode="numeric"
                            maxlength="6"
                            minlength="6"
                            placeholder="Ingresa tu código"
                            required
                            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-center tracking-widest text-lg text-slate-700 outline-none transition-all duration-200 focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100"
                        )

                    div.mt-6.flex.gap-4.px-2

                        a(
                            href="/auth/recover-password"
                            class="w-full text-center bg-gray-300 hover:bg-gray-500 text-black font-semibold py-3 rounded-xl transition-colors  duration-200"
                        )
                            | Reenviar código

                        button(
                            type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition-colors duration-200"
                        )
                            | Verificar código


