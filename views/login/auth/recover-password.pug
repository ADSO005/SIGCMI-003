extends ../layouts/layout

block contenido
    main(class="min-h-screen bg-slate-100 flex items-center justify-center px-4 py-8")

        .bg-white.rounded-3xl.shadow-2xl.max-w-lg.w-full.overflow-hidden

            // Encabezado
            .bg-gradient-to-r.from-blue-700.to-blue-500.text-white.p-8.text-center

                h1.text-4xl.font-extrabold
                    | SIGCMI

                p.mt-2.opacity-90
                    | Sistema Integral de Gestión
                    br
                    | de Citas Médicas

            // Formulario
            .p-8

                h2.text-3xl.font-bold.text-center.text-slate-800.mb-2
                    | Recuperar contraseña

                p.text-center.text-gray-500.mb-8
                    | Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.

                form(
                    action="/auth/recover-password"
                    method="POST"
                    class="space-y-5"
                )

                    include ../partials/forms/inputEmail

                    button(
                        type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition-colors duration-200"
                    )
                        | Enviar enlace

                .mt-6.text-center

                    a(
                        href="/auth/login"
                        class="text-sm text-blue-600 hover:underline"
                    )
                        | ← Volver al inicio de sesión