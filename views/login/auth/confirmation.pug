extends ../layouts/layout

block contenido
    main(class="min-h-screen flex items-center justify-center bg-slate-100 px-4")

        .bg-white.rounded-2xl.shadow-xl.w-full.max-w-md.overflow-hidden

            .bg-blue-700.p-6.text-center
                h1.text-2xl.font-bold.text-white
                    | Confirmación de cuenta

            .p-8.text-center

                if error
                    div(
                        class="mb-6 rounded-lg bg-red-100 border border-red-300 px-4 py-3 text-red-700 text-sm"
                    )
                        | #{error}

                if mensaje
                    div(
                        class="mb-6 rounded-lg bg-green-100 border border-green-300 px-4 py-3 text-green-700 text-sm"
                    )
                        | #{mensaje}

                a(
                    href="/auth/login"
                    class="inline-block bg-blue-700 hover:bg-blue-800 text-white font-semibold px-6 py-3 rounded-lg transition"
                )
                    | Ir al inicio de sesión