//- Formulario para definir una contraseña nueva y confirmarla.
extends ../layouts/layout

block contenido

    main(class="min-h-screen flex items-center justify-center bg-slate-100.px-4")

        .bg-white.rounded-2xl.shadow-xl.w-full.max-w-md.overflow-hidden

            .bg-blue-700.px-8.py-6.relative
                h1.bg-blue-700.text-white.text-3xl.font-bold.text-center.mb-6
                    | Ingresa tu nueva contraseña

                a(
                    href="/auth/login"
                    class="absolute top-4 right-6 text-white text-4xl font-light hover:text-slate-200 transition"
                    aria-label="Cerrar"
                )
                    | ×

                if error
                    div(
                        id="mensajeError"
                        class="mb-5 rounded-lg bg-red-100 border border-red-300 px-4 py-3 text-red-700 text-sm"
                    )
                        | #{error}

            form.p-8(
                action=`/auth/reset-password`
                method="POST"
            )

                div.mb-5
                    label.block.text-slate-900.font-medium.mb-2(
                        for="password"
                    )
                        | Nueva contraseña

                    .relative
                        input#password(
                            type="password"
                            name="password"
                            autocomplete="new-password"
                            placeholder="Ingresa tu nueva contraseña"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 pr-12 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-200"
                            minlength="8"
                            maxlength="16"
                            required
                        )
                        button.password-toggle(
                            type="button"
                            class="absolute right-3 top-1/2 -translate-y-1/2 rounded-md p-2 text-slate-500 transition hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            data-password-toggle="password"
                            aria-label="Mostrar contraseña"
                            aria-pressed="false"
                            title="Mostrar contraseña"
                        )
                            svg.eye-icon.h-5.w-5(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true")
                                path(d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z")
                                circle(cx="12" cy="12" r="3")
                            svg.eye-slash-icon.hidden.h-5.w-5(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true")
                                path(d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8")
                                path(d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a16 16 0 0 1-3.1 3.9M6.2 6.2C3.8 7.9 2.5 12 2.5 12s3.5 7 9.5 7a10 10 0 0 0 3.1-.5")

                    .mt-2.space-y-2#passwordStrength(aria-live="polite")
                        .h-2.overflow-hidden.rounded-full.bg-slate-200
                            .h-full.w-0.rounded-full.transition-all.duration-300#passwordStrengthBar
                        p#passwordStrengthText.sr-only(aria-live="polite") Escribe una contraseña para ver su nivel.

                div.mb-6
                    label.block.text-slate-900.font-medium.mb-2(
                        for="password_confirmation"
                    )
                        | Confirmar contraseña

                    .relative
                        input#password_confirmation(
                            type="password"
                            name="password_confirmation"
                            autocomplete="new-password"
                            placeholder="Repite tu nueva contraseña"
                            class="w-full border border-slate-300 rounded-lg px-4 py-3 pr-12 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-200"
                            minlength="8"
                            maxlength="16"
                            required
                        )
                        button.password-toggle(
                            type="button"
                            class="absolute right-3 top-1/2 -translate-y-1/2 rounded-md p-2 text-slate-500 transition hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            data-password-toggle="password_confirmation"
                            aria-label="Mostrar contraseña"
                            aria-pressed="false"
                            title="Mostrar contraseña"
                        )
                            svg.eye-icon.h-5.w-5(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true")
                                path(d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z")
                                circle(cx="12" cy="12" r="3")
                            svg.eye-slash-icon.hidden.h-5.w-5(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true")
                                path(d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8")
                                path(d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a16 16 0 0 1-3.1 3.9M6.2 6.2C3.8 7.9 2.5 12 2.5 12s3.5 7 9.5 7a10 10 0 0 0 3.1-.5")

                    .mt-2.space-y-2#passwordMatch(aria-live="polite")
                        .h-2.overflow-hidden.rounded-full.bg-slate-200
                            .h-full.w-0.rounded-full.transition-all.duration-300#passwordMatchBar
                        p#passwordMatchText.sr-only(aria-live="polite") Confirma la contraseña para comprobar que coincida.

                button(
                    type="submit"
                    class="w-full bg-blue-700 hover:bg-blue-800 text-white font-medium py-3 rounded-lg transition duration-200"
                )
                    | Cambiar contraseña

    script(src="/auth/js/reset-password.js" defer)
