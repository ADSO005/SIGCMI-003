div
    label(
        for="correo"
        class="block mb-2 text-sm font-semibold text-[#001B4D]"
    )
        | Correo electrónico

    input(
        id="correo"
        name="correo"
        type="email"
        placeholder="correo@ejemplo.com"
        autocomplete="email"
        value=correo || ""
        required
        class="w-full rounded-xl border border-[#E2E8F0] bg-slate-50 px-4 py-3 text-slate-700 placeholder:text-slate-400 outline-none transition-all duration-200 focus:border-[#335CD8] focus:bg-white focus:ring-4 focus:ring-[#335CD8]/10"
    )
