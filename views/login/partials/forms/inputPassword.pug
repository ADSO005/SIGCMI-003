div
    label(
        for="password"
        class="block mb-2 text-sm font-semibold text-[#001B4D]"
    )
        | Contraseña

    .relative
        input(
            id="password"
            name="password"
            type="password"
            placeholder="••••••••••"
            autocomplete="current-password"
            required
            class="w-full rounded-xl border border-[#E2E8F0] bg-slate-50 px-4 py-3 pr-12 text-slate-700 placeholder:text-slate-400 outline-none transition-all duration-200 focus:border-[#335CD8] focus:bg-white focus:ring-4 focus:ring-[#335CD8]/10"
        )
        button#togglePassword(
            type="button"
            aria-label="Mostrar contraseña"
            aria-pressed="false"
            class="absolute inset-y-0 right-0 flex items-center px-4 text-slate-500 hover:text-[#335CD8] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#335CD8] rounded-r-xl"
        )
            svg.eye-icon.hidden(
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-5 w-5"
                aria-hidden="true"
            )
                path(d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z")
                circle(cx="12" cy="12" r="3")
            svg.eye-slash-icon(
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-5 w-5"
                aria-hidden="true"
            )
                path(d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8")
                path(d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a16 16 0 0 1-3.1 3.9M6.2 6.2C3.8 7.9 2.5 12 2.5 12s3.5 7 9.5 7a10 10 0 0 0 3.1-.5")
