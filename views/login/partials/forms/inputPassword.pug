div
    label(
        for="password"
        class="block mb-2 text-sm font-semibold text-slate-700"
    )
        | Contraseña

    input(
        id="password"
        name="password"
        type="password"
        placeholder="••••••••••"
        autocomplete="current-password"
        required
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-700 placeholder:text-slate-400 outline-none transition-all duration-200 focus:border-blue-600 focus:bg-white focus:ring-4 focus:ring-blue-100"
    )