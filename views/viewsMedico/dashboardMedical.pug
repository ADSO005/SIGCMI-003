extends layout/main

block content
  main#mainContent.main(
    class="min-h-screen w-[calc(100%-314px)] ml-[314px] float-none bg-white px-9 pb-7 [@media(max-width:768px)]:px-5 text-black transition-all duration-300 ease-[ease] [&.collapsed]:w-[calc(100%-80px)] [&.collapsed]:ml-[80px] [@media(max-width:768px)]:w-full [@media(max-width:768px)]:ml-0 [@media(max-width:768px)]:[&.collapsed]:w-full [@media(max-width:768px)]:[&.collapsed]:ml-0"
  )
    // VISTA: AGENDA
    section#agendaView.view.active(class="hidden opacity-0 transition-opacity duration-300 ease-[ease] [&.active]:block [&.active]:opacity-100")
      header(class="-mx-9 mb-12 flex min-h-[72px] items-center border-b border-[#d5d5d5] bg-white px-[18px] py-3 shadow-[0_4px_4px_rgba(0,0,0,0.18)] [@media(max-width:768px)]:-mx-5")
        div
          h1(class="text-[26px] leading-[30px] font-bold text-black [@media(max-width:768px)]:text-[24px]") Portal Médico
          span(class="block text-[13px] leading-[18px] text-black")= fechaDashboard
      include includes/dashboardMetrics.pug
      section.content(class="grid grid-cols-[minmax(0,2.27fr)_minmax(0,1fr)] items-start gap-4 [@media(max-width:768px)]:grid-cols-1")
        include includes/dailyAppointments.pug
        // ACCIONES RÁPIDAS
        .quick-actions(class="min-w-0 flex flex-col gap-3")
          .actions(class="bg-white p-4 rounded-[12px] border border-[#d5d5d5] flex flex-col gap-3 [&>h3]:text-black [&>h3]:text-[16px] [&>h3]:font-semibold [&>h3]:mb-0")
            h3 Acciones Rápidas
            button.btnActions.btnActionBlue(class="w-full min-h-9 px-3 py-2 text-[13px] leading-[18px] font-semibold border-0 rounded-[10px] text-white cursor-pointer transition-all duration-200 ease-[ease] hover:opacity-85 bg-[#465DE5]" onclick='abrirModal()') Gestionar Citas
            button.btnActions.btnActionGreen(class="w-full min-h-9 px-3 py-2 text-[13px] leading-[18px] font-semibold border-0 rounded-[10px] text-white cursor-pointer transition-all duration-200 ease-[ease] hover:opacity-85 bg-[#1bce60]" onclick='abrirModalHorarios()') Consultar Horarios
          .proxima-cita(class="bg-[#465DE5] rounded-[12px] p-3 text-white")
            .proxima-cita-header(class="flex items-center gap-2 text-[12px] font-semibold text-white mb-2 px-2")
              img.proxima-icon(class="h-5 w-5 brightness-0 invert" src='/medico/img/Icon.png' alt='Reloj')
              span Próxima Cita
            .proxima-detalle(class="rounded-[10px] bg-white/20 px-3 py-3")
              if proximaCita
                .proxima-hora(class="text-[20px] font-bold text-white leading-6 mb-1")= proximaCita.hora
                .proxima-paciente(class="text-[13px] font-semibold text-white")= proximaCita.paciente
                .proxima-motivo(class="text-[12px] leading-4 font-light text-white mt-1")= proximaCita.motivo
              else
                p(class="text-[13px] font-semibold text-white") No tienes más citas programadas para hoy
                p(class="text-[12px] leading-4 font-light text-white mt-1") Tu agenda está libre por el momento
    // fin agendaView

    section#pacientesView.view(class="hidden opacity-0 transition-opacity duration-300 ease-[ease] [&.active]:block [&.active]:opacity-100")
      header(class="-mx-9 mb-12 flex min-h-[72px] items-center border-b border-[#d5d5d5] bg-white px-[18px] py-3 shadow-[0_4px_4px_rgba(0,0,0,0.18)] [@media(max-width:768px)]:-mx-5")
        div
          h1(class="text-[26px] leading-[30px] font-bold text-black [@media(max-width:768px)]:text-[24px]") Portal Médico
          span(class="block text-[13px] leading-[18px] text-black")= fechaDashboard
      .pacientes-layout(class="grid grid-cols-[260px_minmax(0,1fr)] gap-5 h-[calc(100vh-180px)] [@media(max-width:1024px)]:grid-cols-1 [@media(max-width:1024px)]:h-auto")
        // COLUMNA IZQUIERDA: lista
        .pacientes-lista(class="min-h-0 self-start max-h-full flex flex-col overflow-y-auto rounded-lg border border-[#e2e2e2] bg-white [&>.sin-pacientes]:p-[15px] [&>.sin-pacientes]:text-center [&>.sin-pacientes]:text-[#666] [&>.sin-pacientes]:text-[14px] [&>p]:p-[14px] [&>p]:text-[13px] [&>p]:text-[#718096] [@media(max-width:1024px)]:max-h-[320px]")
          .pacientes-search-box(class="m-[14px] flex items-center gap-2 rounded border border-[#cbd0df] px-3 py-2 [&>input]:min-w-0 [&>input]:w-full [&>input]:border-0 [&>input]:outline-none [&>input]:text-[13px] [&>input]:text-[#4a5568] [&>input]:placeholder:text-[#929bb5]")
            span.search-icon(class="text-[13px] text-[#929bb5]") 🔍
            input(type='text' placeholder='Buscar paciente...' oninput='filtrarPacientes(this.value)')

          if pacientes && pacientes.length > 0
            each item in pacientes
              .paciente-item(
                class="flex items-center gap-[10px] border-b border-[#eeeeee] px-3 py-[14px] last:border-b-0 cursor-pointer transition-colors duration-200 hover:bg-[#f0f4ff] [&.activo]:bg-[#eef1fd] [&.activo]:border-l-[3px] [&.activo]:border-l-[#465DE5] [&>img]:h-9 [&>img]:w-9 [&>img]:shrink-0 [&>img]:p-1 [&>div]:min-w-0 [&>div]:flex-1 [&>div]:flex [&>div]:flex-col [&>div]:gap-[2px] [&_h4]:text-[13px] [&_h4]:font-semibold [&_h4]:text-[#1a202c] [&_span]:text-[11px] [&_span]:text-[#718096] [&>div>span]:flex [&>div>span]:items-center [&>div>span]:gap-1"
                data-id=item.paciente.id_paciente
                onclick='seleccionarPaciente(this)'
              )
                img(src='/medico/img/Group 16.png' alt='Paciente')
                div
                  h4= `${item.paciente.Usuario.nombres} ${item.paciente.Usuario.apellidos}`
                  span
                    img.NegroCalen(class="h-[15px] w-[15px] min-h-[15px] min-w-[15px] object-contain" src='/medico/img/CalendarNegro.png' alt='Imagen Calendario')
                    |  #{item.cantidadCitas} citas
                span.paciente-arrow(class="shrink-0 text-[18px]! text-[#a0aec0]!") ›

          else
            p No hay pacientes registrados.
        // COLUMNA DERECHA: detalle
        .paciente-detalle(class="min-w-0 min-h-0 flex flex-col gap-4 overflow-y-auto rounded-lg border border-[#e2e2e2] bg-white p-6 [@media(max-width:768px)]:p-4")
          .detalle-header(class="flex items-start gap-4 [@media(max-width:768px)]:flex-wrap")
            img.detalle-avatar(
              class="h-16 w-16 shrink-0 p-0 object-contain"
              src='/medico/img/Group 16.png'
              alt='Paciente'
            )

            .detalle-info(class="min-w-0 flex-1 [&>h2]:mb-1 [&>h2]:text-[22px] [&>h2]:leading-7 [&>h2]:font-semibold [&>h2]:text-[#171717] [&>p]:mb-[3px] [&>p]:text-[13px] [&>p]:text-[#4a5568] [&_a]:break-words [&_a]:text-[#555] [&_a]:underline")
              h2#detalleNombre Selecciona un paciente

              p
                | Email: 
                a#detalleCorreo(href='#') -

              p
                | Teléfono: 
                span#detalleTelefono -

            .detalle-meta(class="self-end text-right [&>p]:mb-[3px] [&>p]:text-[12px] [&>p]:text-[#4a5568] [@media(max-width:768px)]:w-full [@media(max-width:768px)]:text-left")
              p
                | Edad: 
                span#detalleEdad -

              p
                | Última Visita: 
                span#detalleUltimaVisita -

          .detalle-badges(class="flex flex-wrap gap-[10px]")
            span.badge.badge-blue(class="inline-flex items-center gap-1 rounded border border-[#d5d5d5] bg-white px-[14px] py-[6px] text-[12px] font-normal text-[#555] [&>img]:h-[14px] [&>img]:w-[14px] [&>img]:object-contain")
              img(
                src='/medico/img/CalendarPaciente.png'
                alt='Calendario'
              )
              |  Citas: 
              span#detalleCitas 0

            span.badge.badge-purple(class="inline-flex items-center gap-1 rounded border border-[#d5d5d5] bg-white px-[14px] py-[6px] text-[12px] font-normal text-[#555] [&>img]:h-[14px] [&>img]:w-[14px] [&>img]:object-contain")
              img(
                src='/medico/img/google-docs 2.png'
                alt='Diagnósticos'
              )
              |  Diagnósticos: 
              span#detalleDiagnosticos 0

          .historial(class="-mx-6 border-t border-[#dedede] px-6 pt-3 [&>h3]:mb-3 [&>h3]:text-[18px] [&>h3]:font-semibold [&>h3]:text-black [@media(max-width:768px)]:-mx-4 [@media(max-width:768px)]:px-4")
            h3 Historial Médico

            #historialPaciente(class="[&>.historial-card]:mb-3 [&>.historial-card]:rounded-[16px] [&>.historial-card]:border [&>.historial-card]:border-[#e2e2e2] [&>.historial-card]:p-3 [&_.historial-card>h4]:mb-1 [&_.historial-card>h4]:text-[14px] [&_.historial-card>h4]:font-medium [&_.historial-card>h4]:text-black [&_.historial-card>p]:mb-1 [&_.historial-card>p]:text-[12px] [&_.historial-card>p]:text-[#666] [&_.historial-card>p]:break-words [&_.historial-card>p.historial-fecha]:mb-[10px] [&_.historial-card>p.historial-fecha]:text-[11px] [&_.historial-card>p.historial-fecha]:text-[#888] [&_strong]:font-medium [&_strong]:text-black [&>p]:text-[13px] [&>p]:text-[#718096]")
              p Selecciona un paciente para consultar su historial.
