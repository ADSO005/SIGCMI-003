doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title SIGCMI - Portal Médico
    link(rel="stylesheet" href="/css/output.css")
    link(rel="stylesheet" href="/shared/css/session.css")
    block styles
  body.portal-medico(class="bg-[#f4f8ff] text-slate-900 font-[Arial,sans-serif] [&_*]:font-[Arial,sans-serif]")
    .container(class="relative w-full max-w-none")
      // Incluye la barra lateral
      include ../includes/sidebar.pug

      // Contenido dinámico de las vistas
      block content

    button#mobileSidebarToggle(
      type="button"
      aria-label="Abrir o cerrar el menú de navegación"
      aria-controls="sidebar"
      aria-expanded="false"
      aria-hidden="true"
      tabindex="-1"
      class="fixed bottom-4 right-4 z-[1000] flex h-12 w-12 items-center justify-center rounded-full border border-white/80 bg-[#315bd7] text-white shadow-lg opacity-0 pointer-events-none transition-all duration-200 min-[769px]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
      onclick="toggleSidebar()"
    )
      svg(class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
        path(d="M4 6h16M4 12h16M4 18h16")

    #sidebarOverlay.sidebar-overlay(
      class="hidden fixed inset-0 z-[999] bg-black/40 opacity-0 transition-opacity duration-300 ease-[ease] [@media(max-width:768px)]:[&.show]:block [@media(max-width:768px)]:[&.show]:opacity-100"
      onclick='cerrarSidebarMovil()'
    )

    // Incluye todos los modales
    include ../includes/modalGestion.pug
    include ../includes/modalHorarios.pug
    include ../includes/modalCierreConsulta.pug
    include ../../shared/session/modals.pug
    if typeof contextoConsulta !== "undefined" && contextoConsulta
      include ../includes/modalAtencion.pug

    script(src="/medico/js/dashboardMedical.js")
    script(src="/medico/js/diagnosticoMedical.js")
    block scripts
