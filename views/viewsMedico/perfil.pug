extends layout/main

block content
  main#mainContent.main(
    class="min-h-screen w-[calc(100%-290px)] ml-[290px] bg-[#f4f8ff] px-8 pb-10 text-slate-900 transition-all duration-300 [&.collapsed]:w-[calc(100%-80px)] [&.collapsed]:ml-[80px] [@media(max-width:768px)]:w-full [@media(max-width:768px)]:ml-0 [@media(max-width:768px)]:px-4"
  )
    header(class="-mx-8 mb-6 flex min-h-[112px] flex-wrap items-center justify-between gap-4 border-b border-blue-100 bg-white px-8 py-5 [@media(max-width:768px)]:-mx-4 [@media(max-width:768px)]:min-h-[90px] [@media(max-width:768px)]:px-4")
      button(type="button" aria-label="Abrir menú" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50 text-[#315bd7] min-[769px]:hidden" onclick="toggleSidebar()")
        svg(class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
          path(d="M4 6h16M4 12h16M4 18h16")
      div(class="min-w-0 flex-1")
        h1(class="text-3xl font-bold tracking-tight text-[#10285e] [@media(max-width:768px)]:text-2xl") Mi Perfil
        p(class="text-sm text-slate-600") Gestiona tu información personal, médica y de contacto
      if modoEdicion
        a(href="/medico/perfil" class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 no-underline hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-blue-700 [@media(max-width:480px)]:w-full [@media(max-width:480px)]:justify-center") Cancelar
      else
        a(href="/medico/perfil/editar" class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-[#315bd7] px-4 py-2.5 text-sm font-semibold text-white no-underline shadow-sm hover:bg-[#2748b2] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 [@media(max-width:480px)]:w-full [@media(max-width:480px)]:justify-center")
          svg(class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
            path(d="M12 20h9")
            path(d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z")
          | Editar Perfil

    if mensajeExito
      p(role="status" class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800")= mensajeExito
    if errorPerfil
      p(role="alert" class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800")= errorPerfil
    if errorPassword
      p(role="alert" class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800")= errorPassword

    div(class="grid grid-cols-1 items-start gap-6 xl:grid-cols-2")
      div(class="flex min-w-0 flex-col gap-6")
        section(class="rounded-3xl border border-blue-200 bg-gradient-to-br from-white to-blue-50 p-7 shadow-sm sm:p-8")
          div(class="flex flex-wrap items-center gap-5")
            div(class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-blue-100 bg-blue-100/80")
              img(class="h-12 w-12 brightness-0 saturate-100" src="/medico/img/icono-medico-avatar.svg" alt="")
            div(class="min-w-0 border-l border-blue-200 pl-5")
              h2(class="break-words text-2xl font-bold text-[#10285e]") #{usuarioPerfil.nombres} #{usuarioPerfil.apellidos}
              span(class="mt-2 inline-flex items-center gap-2 rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-800")
                svg(class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
                  path(d="M12 2 4 5v6c0 5 3.4 9.2 8 11 4.6-1.8 8-6 8-11V5l-8-3Z")
                  path(d="m9 12 2 2 4-4")
                | Médico
              p(class="mt-2 text-base font-medium text-slate-700")= perfilProfesional.especialidad

        section(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8")
          div(class="mb-5 flex items-center gap-3")
            svg(class="h-7 w-7 shrink-0 text-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              circle(cx="12" cy="8" r="4")
              path(d="M5 21v-2a7 7 0 0 1 14 0v2")
            h2(class="text-xl font-bold text-[#10285e]") Información personal

          if modoEdicion
            form(action="/medico/perfil/editar" method="POST" class="space-y-4")
              div(class="grid grid-cols-1 gap-4 sm:grid-cols-2")
                div
                  label(for="nombres" class="mb-1 block text-sm font-semibold text-slate-700") Nombres
                  input#nombres(name="nombres" type="text" maxlength="100" required autocomplete="given-name" value=usuarioPerfil.nombres class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
                div
                  label(for="apellidos" class="mb-1 block text-sm font-semibold text-slate-700") Apellidos
                  input#apellidos(name="apellidos" type="text" maxlength="100" required autocomplete="family-name" value=usuarioPerfil.apellidos class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
                div
                  label(for="correo" class="mb-1 block text-sm font-semibold text-slate-700") Correo electrónico
                  input#correo(name="correo" type="email" maxlength="150" required autocomplete="email" value=usuarioPerfil.correo class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
                div
                  label(for="telefono" class="mb-1 block text-sm font-semibold text-slate-700") Teléfono
                  input#telefono(name="telefono" type="tel" inputmode="tel" pattern="[+]?[0-9 ().-]*" title="Usa solo números, espacios y los signos + ( ) . -" maxlength="20" autocomplete="tel" value=usuarioPerfil.telefono class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
              div(class="rounded-xl border border-amber-200 bg-amber-50 p-4")
                label(for="passwordActualPerfil" class="mb-1 block text-sm font-semibold text-amber-950") Confirma tu contraseña actual para guardar
                input#passwordActualPerfil(name="passwordActual" type="password" required autocomplete="current-password" class="w-full rounded-lg border border-amber-300 bg-white px-3 py-2.5 text-sm text-slate-900 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
              div(class="grid grid-cols-1 gap-4 sm:grid-cols-2")
                div
                  span(class="mb-1 block text-sm font-semibold text-slate-700") Tipo de documento
                  p(class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600")= usuarioPerfil.tipoDocumento
                div
                  span(class="mb-1 block text-sm font-semibold text-slate-700") Número de documento
                  p(class="break-all rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600")= usuarioPerfil.numeroDocumento
              button(type="submit" class="rounded-xl bg-[#315bd7] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#2748b2] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700") Guardar cambios
          else
            dl(class="grid grid-cols-1 gap-3 sm:grid-cols-2")
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Nombres
                dd(class="mt-1 break-words text-sm font-semibold text-slate-800")= usuarioPerfil.nombres || "No registrado"
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Apellidos
                dd(class="mt-1 break-words text-sm font-semibold text-slate-800")= usuarioPerfil.apellidos || "No registrados"
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Correo electrónico
                dd(class="mt-1 break-all text-sm font-semibold text-slate-800")= usuarioPerfil.correo || "No registrado"
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Teléfono
                dd(class="mt-1 break-words text-sm font-semibold text-slate-800")= usuarioPerfil.telefono || "No registrado"
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Fecha de nacimiento
                dd(class="mt-1 text-sm font-semibold text-slate-600") No disponible en el perfil médico
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Tipo de documento
                dd(class="mt-1 text-sm font-semibold text-slate-800")= usuarioPerfil.tipoDocumento
              div(class="rounded-xl border border-blue-100 bg-blue-50/70 p-4 sm:col-span-2")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500") Número de documento
                dd(class="mt-1 break-all text-sm font-semibold text-slate-800")= usuarioPerfil.numeroDocumento

        section(class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8")
          div(class="mb-2 flex items-center gap-3")
            svg(class="h-7 w-7 shrink-0 text-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              rect(x="3" y="11" width="18" height="11" rx="2")
              path(d="M7 11V7a5 5 0 0 1 10 0v4")
            h2(class="text-xl font-bold text-[#10285e]") Cambiar contraseña
          p(class="mb-5 text-sm leading-6 text-slate-600") Usa al menos 6 caracteres con letras, números y un carácter especial.
          form(action="/medico/perfil/cambiar-password" method="POST" class="space-y-3")
            div
              label(for="passwordActual" class="mb-1 block text-sm font-semibold text-slate-700") Contraseña actual
              input#passwordActual(name="passwordActual" type="password" required autocomplete="current-password" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
            div
              label(for="passwordNueva" class="mb-1 block text-sm font-semibold text-slate-700") Contraseña nueva
              input#passwordNueva(name="passwordNueva" type="password" minlength="6" maxlength="72" required autocomplete="new-password" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
            div
              label(for="confirmarPassword" class="mb-1 block text-sm font-semibold text-slate-700") Repetir contraseña nueva
              input#confirmarPassword(name="confirmarPassword" type="password" minlength="6" maxlength="72" required autocomplete="new-password" class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-100")
            button(type="submit" class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#315bd7] px-5 py-3 text-sm font-semibold text-white hover:bg-[#2748b2] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 sm:w-auto") Cambiar contraseña

      div(class="flex min-w-0 flex-col gap-6")
        section(class="rounded-3xl border border-emerald-200 bg-gradient-to-br from-white to-emerald-50 p-6 shadow-sm sm:p-8")
          div(class="mb-5 flex items-center gap-3")
            svg(class="h-7 w-7 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              path(d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z")
            h2(class="text-xl font-bold text-[#10285e]") Información profesional
          dl(class="space-y-3")
            div(class="grid grid-cols-1 gap-2 rounded-xl border border-emerald-100 bg-white/80 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:gap-3")
              dt(class="text-sm font-semibold text-slate-700") Especialidad
              dd(class="break-words text-sm text-slate-800")= perfilProfesional.especialidad
            div(class="grid grid-cols-1 gap-2 rounded-xl border border-emerald-100 bg-white/80 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:gap-3")
              dt(class="text-sm font-semibold text-slate-700") Cédula profesional
              dd(class="break-words text-sm text-slate-800")= perfilProfesional.cedulaProfesional
            div(class="grid grid-cols-1 gap-2 rounded-xl border border-emerald-100 bg-white/80 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:gap-3")
              dt(class="text-sm font-semibold text-slate-700") Años de experiencia
              dd(class="break-words text-sm text-slate-800")= perfilProfesional.aniosExperiencia === null ? "No registrados" : perfilProfesional.aniosExperiencia
          p(class="mt-4 text-xs leading-5 text-slate-600") La especialidad y los datos profesionales son de solo lectura en este perfil.

        section(class="rounded-3xl border border-violet-200 bg-gradient-to-br from-white to-violet-50 p-6 shadow-sm sm:p-8")
          div(class="mb-5 flex items-center gap-3")
            svg(class="h-7 w-7 shrink-0 text-violet-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              path(d="M3 10.5 12 3l9 7.5")
              path(d="M5 9.5V21h14V9.5M9 21v-7h6v7")
            h2(class="text-xl font-bold text-[#10285e]") Dirección de residencia
          dl(class="grid grid-cols-1 gap-3 sm:grid-cols-2")
            each etiqueta in ["Dirección", "Departamento", "Ciudad o municipio"]
              div(class="rounded-xl border border-violet-100 bg-white/80 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500")= etiqueta
                dd(class="mt-1 text-sm text-slate-600") No registrada en el perfil médico

        section(class="rounded-3xl border border-emerald-200 bg-gradient-to-br from-white to-emerald-50 p-6 shadow-sm sm:p-8")
          div(class="mb-5 flex items-center gap-3")
            svg(class="h-7 w-7 shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              path(d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.4 2.8a2 2 0 0 1-.6 1.7L7.6 9.5a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 1.7-.6l2.8.4a2 2 0 0 1 1.6 1.9Z")
            h2(class="text-xl font-bold text-[#10285e]") Contacto de emergencia
          dl(class="grid grid-cols-1 gap-3 sm:grid-cols-2")
            each etiqueta in ["Nombres", "Apellidos", "Teléfono", "Correo electrónico"]
              div(class="rounded-xl border border-emerald-100 bg-white/80 p-4")
                dt(class="text-xs font-semibold uppercase tracking-wide text-slate-500")= etiqueta
                dd(class="mt-1 break-words text-sm text-slate-600") No registrado en el perfil médico

        section(class="rounded-3xl border border-blue-200 bg-gradient-to-br from-blue-50 to-indigo-100 p-6 shadow-sm sm:p-8")
          div(class="flex items-start gap-4")
            svg(class="h-8 w-8 shrink-0 text-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
              path(d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z")
              path(d="m9 12 2 2 4-4")
            div
              h2(class="mb-2 text-xl font-bold text-[#10285e]") Seguridad y privacidad
              p(class="text-sm leading-6 text-slate-700") Los cambios de datos personales requieren confirmar tu contraseña actual. La información profesional se presenta según los datos asociados a tu perfil médico.

block append scripts
  script(src="/medico/js/perfilMedical.js")
