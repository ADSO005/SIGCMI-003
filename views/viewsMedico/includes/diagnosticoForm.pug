mixin campoDiagnostico(nombre, etiqueta, largo=false, requerido=false)
  div(class="min-w-0" class=largo ? "sm:col-span-2" : "")
    label(for=`diagnostico-${nombre}` class="mb-1 block text-sm font-semibold text-slate-700")= etiqueta
    if largo
      textarea(id=`diagnostico-${nombre}` name=nombre data-label=etiqueta required=requerido maxlength="65535" rows="3" class="block min-w-0 w-full resize-y rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900 focus:border-[#465DE5]")
    else
      input(id=`diagnostico-${nombre}` name=nombre data-label=etiqueta type="text" inputmode=nombre === "frecuencia_cardiaca" ? "numeric" : nombre === "presion_arterial" ? "text" : "decimal" maxlength=nombre === "presion_arterial" ? "20" : undefined placeholder=nombre === "presion_arterial" ? "120/80" : undefined class="block min-w-0 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900 focus:border-[#465DE5]")

form#formDiagnostico(data-cita=contextoConsulta.id_cita data-estado-completada=estadoCompletadaId novalidate class="mt-4 min-w-0")
  p#mensajeDiagnostico(role="status" aria-live="polite" tabindex="-1" class="mb-3 text-sm text-slate-700 [overflow-wrap:anywhere]") Cargando diagnóstico…
  button#reintentarDiagnostico(type="button" hidden class="mb-3 rounded-lg border border-[#465DE5] px-3 py-2 text-sm text-[#465DE5]") Reintentar carga
  fieldset#camposDiagnostico(disabled class="min-w-0 space-y-4")
    legend(class="sr-only") Registro de diagnóstico
    fieldset(class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 sm:p-5")
      legend(class="px-1 text-base font-semibold text-slate-800") Signos vitales · opcionales
      div(class="grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-2")
        +campoDiagnostico("temperatura", "Temperatura (°C)")
        +campoDiagnostico("presion_arterial", "Presión arterial")
        +campoDiagnostico("altura", "Altura (m)")
        +campoDiagnostico("peso", "Peso (kg)")
        +campoDiagnostico("frecuencia_cardiaca", "Frecuencia cardiaca (lpm)")
    fieldset(class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 sm:p-5")
      legend(class="px-1 text-base font-semibold text-slate-800") Registro clínico
      div(class="grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-2")
        +campoDiagnostico("sintomas", "Síntomas · opcional", true)
        +campoDiagnostico("diagnostico", "Diagnóstico · obligatorio", true, true)
        +campoDiagnostico("tratamiento", "Tratamiento · opcional", true)
        +campoDiagnostico("notas_adicionales", "Notas adicionales · opcional", true)
  section#seccionMedicamentos(aria-labelledby="tituloMedicamentos" class="mt-4 min-w-0 rounded-xl border border-slate-200 bg-white p-4 sm:p-5")
    h3#tituloMedicamentos(class="mb-2 text-base font-semibold text-slate-800") Medicamentos
    p#estadoMedicamentos(role="status" aria-live="polite" class="mb-3 text-sm text-slate-600") Guarda primero un diagnóstico para registrar la decisión sobre medicamentos.
    fieldset#camposMedicamentos(disabled class="min-w-0 space-y-4")
      legend(class="sr-only") Decisión sobre medicamentos
      div(class="flex min-w-0 flex-col gap-2 sm:flex-row sm:gap-6")
        label(class="flex items-center gap-2 text-sm text-slate-700")
          input#decisionRequiere(type="radio" name="decision_medicamentos" value="Requiere" class="accent-[#2D5FB9]")
          | Requiere medicamentos
        label(class="flex items-center gap-2 text-sm text-slate-700")
          input#decisionNoRequiere(type="radio" name="decision_medicamentos" value="No requiere" class="accent-[#2D5FB9]")
          | No requiere medicamentos
      p#ayudaDecisionMedicamentos(class="text-xs text-slate-500") La decisión permanece Pendiente hasta que la guardes.
      div#formNuevoMedicamento(hidden class="grid min-w-0 grid-cols-1 gap-3 rounded-lg border border-slate-200 bg-slate-50 p-3 sm:grid-cols-2")
        div(class="min-w-0")
          label(for="nuevoNombreMedicamento" class="mb-1 block text-sm font-semibold text-slate-700") Nombre
          input#nuevoNombreMedicamento(type="text" maxlength="150" autocomplete="off" class="block min-w-0 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900")
        div(class="min-w-0")
          label(for="nuevaDosisMedicamento" class="mb-1 block text-sm font-semibold text-slate-700") Dosis
          input#nuevaDosisMedicamento(type="text" maxlength="100" autocomplete="off" class="block min-w-0 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900")
        div(class="min-w-0")
          label(for="nuevaFrecuenciaMedicamento" class="mb-1 block text-sm font-semibold text-slate-700") Frecuencia
          input#nuevaFrecuenciaMedicamento(type="text" maxlength="100" autocomplete="off" class="block min-w-0 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900")
        div(class="min-w-0")
          label(for="nuevaDuracionMedicamento" class="mb-1 block text-sm font-semibold text-slate-700") Duración
          input#nuevaDuracionMedicamento(type="text" maxlength="100" autocomplete="off" class="block min-w-0 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-900")
        button#agregarMedicamento(type="button" class="w-fit rounded-lg border border-[#2D5FB9] bg-white px-3 py-2 text-sm font-semibold text-[#2D5FB9] hover:bg-blue-50 sm:col-span-2") Agregar a la lista
      ul#medicamentosPendientes(aria-label="Medicamentos pendientes de guardar" class="space-y-2")
      div
        h4(class="mb-2 text-sm font-semibold text-slate-700") Medicamentos guardados
        p#sinMedicamentosGuardados(class="text-sm text-slate-500") Aún no hay medicamentos guardados.
        ul#medicamentosGuardados(aria-label="Medicamentos ya guardados" class="space-y-2")
    button#guardarMedicamentos(type="button" disabled class="mt-4 rounded-lg bg-[#2D5FB9] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50") Guardar decisión y medicamentos
    button#revisarMedicamentos(type="button" hidden class="mt-3 w-full rounded-lg border border-amber-600 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900") Consultar estado actual
    button#confirmarRevisionMedicamentos(type="button" hidden class="mt-2 w-full rounded-lg border border-[#2D5FB9] bg-white px-3 py-2 text-sm font-semibold text-[#2D5FB9]") Revisé el estado actual; conservar mis cambios
  button#consultarVersionDiagnostico(type="button" hidden class="mt-3 w-full rounded-lg border border-[#465DE5] bg-white px-3 py-2 text-sm font-semibold text-[#465DE5]") Consultar versión más reciente
  section#versionRecienteDiagnostico(hidden aria-labelledby="tituloVersionDiagnostico" class="mt-4 min-w-0 rounded-lg border border-amber-200 bg-amber-50 p-3 [overflow-wrap:anywhere]")
    h5#tituloVersionDiagnostico(class="text-sm font-semibold text-slate-900") Versión más reciente · solo lectura
    p(class="mt-2 text-xs text-slate-700") Tus cambios permanecen en el formulario. Cargar esta versión los reemplazará únicamente si lo confirmas.
    dl#detalleVersionDiagnostico(class="mt-3 space-y-2 text-sm text-slate-800")
    button#cargarVersionDiagnostico(type="button" class="mt-3 w-full rounded-lg border border-amber-700 bg-white p-2 text-sm font-semibold text-amber-900") Reemplazar mi formulario con esta versión
    button#ocultarVersionDiagnostico(type="button" class="mt-2 w-full rounded-lg border border-slate-300 bg-white p-2 text-sm text-slate-700") Conservar mis cambios y ocultar versión
