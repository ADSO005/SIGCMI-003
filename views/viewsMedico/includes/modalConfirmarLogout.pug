dialog#modalConfirmarLogout(
  aria-labelledby="tituloConfirmarLogout"
  aria-describedby="descripcionConfirmarLogout"
  class="m-auto max-h-[90dvh] w-[calc(100%-24px)] max-w-[460px] overflow-hidden rounded-2xl border border-blue-100 bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-black/50 [&[open]]:flex [&[open]]:flex-col"
)
  header(class="flex items-center gap-3 bg-gradient-to-r from-[#263c91] to-[#315bd7] px-5 py-4 text-white sm:px-6")
    div(class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15")
      svg(class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
        path(d="M10 17l5-5-5-5")
        path(d="M15 12H3")
        path(d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6")
    h2#tituloConfirmarLogout(class="text-lg font-bold sm:text-xl") Cerrar sesión
  div(class="p-5 sm:p-6")
    p#descripcionConfirmarLogout(class="text-sm leading-6 text-slate-600") ¿Estás seguro de que deseas cerrar sesión?
    div(class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end")
      button#cancelarLogout(type="button" class="min-h-11 rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700") Cancelar
      button#confirmarLogout(type="button" class="min-h-11 rounded-xl bg-[#315bd7] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#2748b2] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 disabled:cursor-not-allowed disabled:opacity-60") Cerrar sesión
