#modalHorarios.modal-overlay(class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/30 [&.abierto]:flex" onclick='cerrarModalHorariosFuera(event)')
  section(class="w-[600px] max-w-[95vw] max-h-[90vh] overflow-auto rounded-2xl border border-[#E2E8F0] bg-white p-5 text-[#001B4D] shadow-2xl sm:p-7 [&>h2]:mb-2 [&>h2]:text-xl [&>h2]:font-bold [&>p]:mb-5 [&>p]:text-sm [&>p]:text-slate-600" onclick='event.stopPropagation()')
