#modalHorarios.modal-overlay(class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/40 p-3 [&.abierto]:flex" onclick='cerrarModalHorariosFuera(event)' onkeydown='if (event.key === "Escape") cerrarModalHorarios()')
  section(role="dialog" aria-modal="true" aria-labelledby="tituloAgendaSemanal" aria-describedby="subtituloAgendaSemanal" class="flex w-full max-w-[780px] max-h-[90dvh] min-w-0 flex-col overflow-hidden rounded-2xl bg-white text-slate-800 shadow-xl" onclick='event.stopPropagation()')
    header(class="flex shrink-0 items-start gap-3 bg-[#465DE5] p-4 text-white sm:p-6")
      span(class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/15" aria-hidden="true")
        svg(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
          rect(x="3" y="5" width="18" height="16" rx="2")
          path(d="M16 3v4M8 3v4M3 11h18")
      div(class="min-w-0 flex-1")
        h2#tituloAgendaSemanal(class="text-xl font-bold sm:text-2xl") Mi agenda semanal
        p#subtituloAgendaSemanal(class="mt-1 text-xs text-white/90 sm:text-sm") Horarios asignados por administración
        span(class="mt-2 inline-block rounded-full border border-white/30 px-2 py-0.5 text-xs") Solo lectura
      button#cerrarAgendaSemanal(type="button" onclick="cerrarModalHorarios()" aria-label="Cerrar agenda semanal" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-2xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white") ×
    div(class="min-h-0 overflow-y-auto overscroll-contain p-4 sm:p-6")
      nav(aria-label="Navegación semanal" class="mb-4 flex items-center justify-between gap-2")
        button#semanaAnteriorHorario(type="button" disabled onclick="cambiarSemanaHorarios(-1)" aria-label="Semana anterior" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-xl text-[#465DE5] hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ‹
        p#rangoSemanaHorario(class="min-w-0 text-center text-sm font-semibold text-slate-800 sm:text-base" aria-live="polite")
        button#semanaSiguienteHorario(type="button" disabled onclick="cambiarSemanaHorarios(1)" aria-label="Semana siguiente" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-xl text-[#465DE5] hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ›
      #diasSemanaHorario(class="grid grid-cols-7 gap-1 sm:gap-2" aria-label="Días de la semana")
      p(class="mt-3 text-xs text-slate-600") El punto azul indica horarios aprobados. Las demás asignaciones conservan su estado.
      p#estadoCargaHorarios(class="mt-5 text-sm text-slate-700" role="status" aria-live="polite")
      #listaHorariosMedico(class="mt-4 grid gap-3 sm:grid-cols-2" aria-busy="false")
    footer(class="shrink-0 border-t border-slate-100 bg-slate-50 px-4 py-3 sm:px-6")
      p(class="text-xs leading-5 text-slate-600") Los horarios son asignados y administrados por administración.
