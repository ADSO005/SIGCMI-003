    p Consulta los horarios registrados por administración.
    #listaHorariosMedico(role='status' aria-live='polite' class='rounded-xl bg-[#F8FFFF] p-4')
    button(type='button' onclick='cerrarModalHorarios()' class='rounded-lg bg-[#335CD8] px-5 py-3 font-semibold text-white transition hover:bg-[#263F9D] focus-visible:outline') Cerrar
