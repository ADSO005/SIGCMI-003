#modalHorarios.modal-overlay(class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/40 p-3 [&.abierto]:flex" onclick='cerrarModalHorariosFuera(event)' onkeydown='if (event.key === "Escape") cerrarModalHorarios()')
  section(role="dialog" aria-modal="true" aria-labelledby="tituloAgendaSemanal" aria-describedby="subtituloAgendaSemanal" class="flex w-full max-w-[960px] max-h-[92dvh] min-w-0 flex-col overflow-hidden rounded-2xl bg-white text-slate-800 shadow-xl" onclick='event.stopPropagation()')
    header(class="grid shrink-0 grid-cols-[32px_minmax(0,1fr)_32px] items-center gap-x-2 gap-y-1 bg-linear-to-r from-[#2D5FB9] to-[#3F7ACF] px-4 py-3 text-white sm:grid-cols-[40px_minmax(0,1fr)_auto_36px] sm:gap-x-3 sm:px-6 sm:py-4")
      span(class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 sm:h-10 sm:w-10" aria-hidden="true")
        svg(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
          rect(x="3" y="5" width="18" height="16" rx="2")
          path(d="M16 3v4M8 3v4M3 11h18")
      div(class="min-w-0")
        h2#tituloAgendaSemanal(class="text-base font-bold sm:text-xl") Mi agenda semanal
        p#subtituloAgendaSemanal(class="mt-1 text-[11px] text-white/90 sm:text-xs") Horarios asignados por administración
      span(class="col-start-2 row-start-2 justify-self-start rounded-full bg-white/15 px-2 py-0.5 text-[10px] font-medium sm:col-start-3 sm:row-start-1 sm:px-3 sm:py-1 sm:text-xs") Solo lectura
      button#cerrarAgendaSemanal(type="button" onclick="cerrarModalHorarios()" aria-label="Cerrar agenda semanal" class="col-start-3 row-start-1 flex h-8 w-8 items-center justify-center rounded-lg text-2xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:col-start-4 sm:h-9 sm:w-9") ×
    div(class="min-h-0 overflow-y-auto overscroll-contain bg-[#F5F7FC] p-4 sm:p-5")
      div(class="grid min-w-0 items-start gap-5 md:grid-cols-[300px_minmax(0,1fr)]")
        section(aria-label="Calendario mensual" class="min-w-0 rounded-2xl border border-slate-200/70 bg-white p-4 shadow-sm")
          nav(aria-label="Navegación mensual" class="mb-4 flex items-center justify-between gap-2")
            p#mesHorario(class="text-sm font-semibold capitalize text-slate-800" aria-live="polite")
            div(class="flex gap-1")
              button#mesAnteriorHorario(type="button" disabled onclick="cambiarMesHorarios(-1)" aria-label="Mes anterior" class="flex h-10 w-10 items-center justify-center rounded-lg text-xl text-slate-500 hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ‹
              button#mesSiguienteHorario(type="button" disabled onclick="cambiarMesHorarios(1)" aria-label="Mes siguiente" class="flex h-10 w-10 items-center justify-center rounded-lg text-xl text-slate-500 hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ›
          div(class="mb-1 grid grid-cols-7 text-center text-[11px] font-medium text-slate-500" aria-hidden="true")
            each label in ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"]
              span(class="py-1")= label
          #diasSemanaHorario(class="grid grid-cols-7 gap-1" aria-label="Fechas del mes")
          div(class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-slate-100 pt-3 text-[10px] text-slate-600")
            span(class="inline-flex items-center gap-1")
              span(class="h-1.5 w-1.5 rounded-full bg-[#465DE5]" aria-hidden="true")
              | Con horarios
            span(class="inline-flex items-center gap-1")
              span(class="h-1.5 w-1.5 rounded-full bg-slate-300" aria-hidden="true")
              | Sin horarios
            span(class="inline-flex items-center gap-1")
              span(class="h-3 w-3 rounded border border-[#465DE5]" aria-hidden="true")
              | Hoy
          nav(aria-label="Navegación semanal" class="mt-4 flex items-center justify-between gap-1 border-t border-slate-100 pt-3")
            button#semanaAnteriorHorario(type="button" disabled onclick="cambiarSemanaHorarios(-1)" aria-label="Semana anterior" class="flex h-10 w-9 shrink-0 items-center justify-center rounded-lg text-xl text-[#465DE5] hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ‹
            div(class="min-w-0 text-center")
              p(class="text-[10px] text-slate-500") Semana seleccionada
              p#rangoSemanaHorario(class="mt-1 text-xs font-medium leading-5 text-slate-700" aria-live="polite")
            button#semanaSiguienteHorario(type="button" disabled onclick="cambiarSemanaHorarios(1)" aria-label="Semana siguiente" class="flex h-10 w-9 shrink-0 items-center justify-center rounded-lg text-xl text-[#465DE5] hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") ›
        section(aria-labelledby="tituloDetalleHorario" class="min-w-0")
          div(class="flex items-center justify-between gap-2")
            h3#tituloDetalleHorario(class="text-sm font-semibold text-slate-800") Horarios de atención
            button#vistaSemanaHorario(type="button" disabled onclick="verSemanaHorarios()" class="min-h-10 shrink-0 rounded-lg px-3 text-xs font-medium text-[#465DE5] hover:bg-indigo-50 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-[#465DE5]") Ver semana
          p#estadoCargaHorarios(class="mt-1 text-xs leading-5 text-slate-600" role="status" aria-live="polite")
          #listaHorariosMedico(class="mt-3 grid gap-3" aria-busy="false")
    footer(class="flex shrink-0 items-center justify-between gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-6")
      p(class="max-w-[520px] text-[11px] leading-4 text-slate-500") Los horarios son asignados y administrados por administración.
      button(type="button" onclick="cerrarModalHorarios()" class="min-h-10 shrink-0 rounded-xl bg-[#465DE5] px-6 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#465DE5]") Cerrar
