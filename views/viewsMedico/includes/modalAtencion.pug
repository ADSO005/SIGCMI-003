dialog#modalAtencion(aria-modal="true" aria-labelledby="tituloAtencionMedica" class="m-auto max-h-[92dvh] w-[calc(100%-24px)] max-w-[960px] min-w-0 overflow-hidden rounded-2xl border-0 bg-white p-0 text-slate-800 shadow-xl backdrop:bg-black/40 [&[open]]:flex [&[open]]:flex-col")
  header(class="flex shrink-0 items-center justify-between gap-3 bg-linear-to-r from-[#2D5FB9] to-[#3F7ACF] px-4 py-3 text-white sm:px-6 sm:py-4")
    div(class="min-w-0")
      h2#tituloAtencionMedica(class="text-lg font-bold sm:text-xl") Atención médica
      p#estadoGuardadoDiagnostico(role="status" aria-live="polite" class="mt-1 text-xs text-white/90") Cargando diagnóstico…
    button#cerrarAtencionSuperior(type="button" aria-label="Cerrar atención médica" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-2xl hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white disabled:opacity-50") ×
  div#cuerpoAtencion(class="min-h-0 min-w-0 overflow-y-auto overscroll-contain bg-[#F5F7FC] p-4 sm:p-5")
    section#contextoConsulta(aria-labelledby="tituloDatosConsulta" class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 [overflow-wrap:anywhere] sm:p-5")
      h3#tituloDatosConsulta(class="mb-3 text-base font-semibold text-slate-800") Datos de la consulta
      dl(class="grid min-w-0 grid-cols-1 gap-3 text-sm sm:grid-cols-2")
        div(class="min-w-0")
          dt(class="text-xs text-slate-500") Paciente
          dd(class="font-semibold text-slate-900")= contextoConsulta.paciente
        div(class="min-w-0")
          dt(class="text-xs text-slate-500") Fecha y hora
          dd(class="text-slate-800")= `${contextoConsulta.fecha} · ${contextoConsulta.hora.slice(0, 5)}`
        div(class="min-w-0 sm:col-span-2")
          dt(class="text-xs text-slate-500") Motivo
          dd(class="whitespace-pre-wrap text-slate-700")= contextoConsulta.motivo
        div
          dt(class="text-xs text-slate-500") Estado
          dd(class="font-semibold text-emerald-800") En Curso
    include diagnosticoForm.pug
  footer(class="flex shrink-0 flex-wrap justify-end gap-3 border-t border-slate-200 bg-white px-4 py-3 sm:px-6")
    button#cerrarAtencion(type="button" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50") Cerrar
    button#guardarDiagnostico(type="submit" form="formDiagnostico" disabled class="rounded-lg bg-[#2D5FB9] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50") Guardar borrador
    button#finalizarConsulta(type="button" data-estado-id=estadoCompletadaId disabled class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:opacity-50") Finalizar consulta
    if !estadoCompletadaId
      p(role="alert" class="w-full text-right text-sm text-rose-700") No se pudo cargar el estado de finalización. Actualiza la agenda.
