mixin dashboardMetricIcon(kind, size = "h-9 w-9")
  svg(class=`${size} shrink-0 ${kind === "check" ? "text-emerald-600" : "text-[#465DE5]"}` viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
    if kind === "patients"
      circle(cx="9" cy="7" r="3")
      path(d="M3 21v-3a6 6 0 0 1 12 0v3H3ZM16 4a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v3h-3")
    else if kind === "clock"
      circle(cx="12" cy="12" r="9")
      path(d="M12 7v5l3 2")
    else if kind === "check"
      circle(cx="12" cy="12" r="10" fill="currentColor" stroke="none")
      path(d="m7 12 3 3 7-7" stroke="white" stroke-width="2")
    else
      rect(x="3" y="5" width="18" height="16" rx="2")
      path(d="M7 3v4M17 3v4M3 10h18")
      if kind === "today"
        path(d="m8 15 3 3 5-5")

mixin dashboardSummaryCard(title, icon, key, value, description)
  article(class="min-w-0 rounded-[22px] border border-slate-200 bg-white p-5 shadow-sm")
    div(class="flex min-h-12 items-start gap-3")
      +dashboardMetricIcon(icon)
      h3(class="min-w-0 text-base font-semibold leading-6 text-slate-950")= title
    div(class="mt-6 pl-12")
      p(class="text-5xl font-bold leading-none tracking-tight text-slate-950" data-metric=key)= value
      p(class="mt-3 text-sm leading-5 text-slate-600")= description

section.cards(aria-label="Resumen de citas médicas" class="mb-6 grid grid-cols-1 gap-4 min-[640px]:grid-cols-2 min-[1440px]:grid-cols-4")
  article(class="min-w-0 rounded-[22px] border border-[#6385FF] bg-linear-to-br from-white to-blue-50 p-5 shadow-sm")
    div(class="flex items-start gap-3")
      +dashboardMetricIcon("today")
      h3(class="min-w-0 flex-1 text-base font-semibold leading-6 text-slate-950") Citas de hoy
      span(class="shrink-0 rounded-full bg-indigo-100 px-2 py-1 text-xs font-semibold text-indigo-900") Hoy
    div(class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1")
      p(class="text-5xl font-bold leading-none tracking-tight text-slate-950" data-metric="todayTotal")= dashboardMetrics.todayTotal
      p(class="text-sm text-slate-700") citas programadas
    div(role="progressbar" aria-label="Proporción de citas completadas hoy" aria-valuemin="0" aria-valuemax="100" aria-valuenow=dashboardMetrics.progressPercent aria-valuetext=`${dashboardMetrics.todayCompleted} de ${dashboardMetrics.todayTotal} citas completadas` class="mt-4 h-3 overflow-hidden rounded-full bg-slate-200")
      div(class="h-full rounded-full bg-emerald-500" style={ width: `${dashboardMetrics.progressPercent}%` })
    div(class="mt-5 grid grid-cols-2 divide-x divide-blue-200")
      div(class="flex min-w-0 items-start gap-2 pr-2")
        +dashboardMetricIcon("check", "h-6 w-6")
        div(class="min-w-0")
          p(class="text-2xl font-bold leading-6 text-slate-950" data-metric="todayCompleted")= dashboardMetrics.todayCompleted
          p(class="mt-1 text-[11px] leading-4 text-slate-800") Completadas
      div(class="flex min-w-0 items-start gap-2 pl-3")
        +dashboardMetricIcon("clock", "h-6 w-6")
        div(class="min-w-0")
          p(class="text-2xl font-bold leading-6 text-slate-950" data-metric="todayRemaining")= dashboardMetrics.todayRemaining
          p(class="mt-1 text-[11px] leading-4 text-slate-800") Por atender
  +dashboardSummaryCard("Pacientes atendidos este mes", "patients", "monthlyPatients", dashboardMetrics.monthlyPatients, "Pacientes únicos atendidos")
  +dashboardSummaryCard("Consultas de esta semana", "calendar", "weeklyAppointments", dashboardMetrics.weeklyAppointments, "Sin incluir canceladas")
  +dashboardSummaryCard("Tiempo promedio de consulta", "clock", "averageMinutes", dashboardMetrics.averageMinutes === null ? "—" : `${dashboardMetrics.averageMinutes} min`, dashboardMetrics.averageMinutes === null ? "Sin datos de duración real" : "Duración clínica real promedio")
