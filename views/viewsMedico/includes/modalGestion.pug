//- Agenda de consulta; las citas se filtran por médico en el servidor.
- const agenda = typeof citasAgenda === "undefined" ? [] : citasAgenda
#modalGestionCitas.modal-overlay(class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/40 p-3 [&.abierto]:flex" onclick="cerrarModalFuera(event)" onkeydown="gestionarTecladoCitas(event)")
  .modal-gc(role="dialog" aria-modal="true" aria-labelledby="tituloGestionCitas" aria-describedby="modalSubtitulo" tabindex="-1" class="flex max-h-[92dvh] w-full max-w-[780px] min-w-0 flex-col overflow-hidden rounded-[14px] bg-white text-slate-800 shadow-xl" onclick="event.stopPropagation()")
    header(class="flex shrink-0 items-center justify-between gap-3 bg-[#465DE5] px-4 py-4 sm:px-6")
      div(class="min-w-0")
        h2#tituloGestionCitas(class="text-xl font-bold text-white") Gestión de Citas
        p#modalSubtitulo(class="mt-1 text-xs text-white/90" aria-live="polite")= `Total de citas: ${agenda.length}`
      button#cerrarGestionCitas(type="button" aria-label="Cerrar agenda de citas" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-xl text-white hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white" onclick="cerrarModal()") ✕
    #listaCitas(class="grid min-h-0 min-w-0 flex-1 grid-cols-1 content-start gap-3 overflow-y-auto overscroll-contain p-4 sm:grid-cols-2 sm:p-6")
      each cita in agenda
        article.cita-card(data-fecha=cita.fecha data-estado=cita.estado class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 [overflow-wrap:anywhere]")
          div(class="mb-3 flex flex-wrap items-center justify-between gap-2")
            time(datetime=cita.fecha class="text-sm font-semibold text-slate-800")= cita.fecha
            - const colorEstado = cita.estado === "Cancelada" ? "bg-rose-50 text-rose-800" : ["Completada", "En Curso"].includes(cita.estado) ? "bg-emerald-50 text-emerald-800" : "bg-indigo-50 text-indigo-800"
            span(class=`rounded-full px-2 py-1 text-xs font-semibold ${colorEstado}`)= cita.estado
          dl(class="space-y-2 text-sm")
            div
              dt(class="text-xs text-slate-500") Hora
              dd(class="font-semibold text-[#465DE5]")= cita.hora.slice(0, 5)
            div
              dt(class="text-xs text-slate-500") Paciente
              dd(class="font-semibold text-slate-800")= cita.paciente
            div
              dt(class="text-xs text-slate-500") Motivo de consulta
              dd(class="text-slate-700 whitespace-pre-wrap")= cita.motivo
      p#estadoListaCitas(role="status" aria-live="polite" hidden=agenda.length > 0 class="col-span-full py-8 text-center text-sm text-slate-600") No tienes citas registradas.
    footer(class="flex shrink-0 items-center justify-between gap-3 border-t border-slate-100 bg-slate-50 px-4 py-3 sm:px-6")
      p(class="text-xs text-slate-600") Agenda de solo consulta
      button(type="button" class="shrink-0 rounded-lg bg-[#465DE5] px-4 py-2 text-sm font-semibold text-white hover:opacity-90" onclick="cerrarModal()") Cerrar
