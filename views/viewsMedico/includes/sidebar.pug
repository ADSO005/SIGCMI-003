aside#sidebar.sidebar.group(
  class="fixed top-0 left-0 z-[1000] flex h-screen w-[290px] flex-col overflow-hidden bg-gradient-to-b from-[#263c91] via-[#263f9e] to-[#1f367f] px-6 text-white shadow-xl [&.collapsed]:px-5 transition-all duration-300 ease-[ease] [&.collapsed]:w-[80px] [@media(max-width:768px)]:w-[280px] [@media(max-width:768px)]:-translate-x-full [@media(max-width:768px)]:transition-transform [@media(max-width:768px)]:ease-[cubic-bezier(0.4,0,0.2,1)] [@media(max-width:768px)]:[&.open]:translate-x-0"
)
  .logo(class="flex h-[82px] shrink-0 items-center justify-between px-1 group-[.collapsed]:justify-center group-[.collapsed]:px-0")
    span.logo-text(class="flex items-center gap-3 text-[26px] leading-none font-bold tracking-wide group-[.collapsed]:hidden")
      svg(class="h-9 w-9 text-teal-300" viewBox="0 0 40 40" fill="none" aria-hidden="true")
        path(d="M20 3v34M3 20h34" stroke="currentColor" stroke-width="10" stroke-linecap="round")
        path(d="M20 9v22M9 20h22" stroke="#60a5fa" stroke-width="6" stroke-linecap="round")
      | SIGCMI
    button#toggleBtn(
      class="flex h-10 w-10 shrink-0 items-center justify-center cursor-pointer border-0 bg-transparent text-[22px] text-white transition-transform duration-200 hover:scale-110"
      onclick="toggleSidebar()"
      aria-label="Abrir o cerrar menú"
    ) ☰

  hr.line-1(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20")

  .user(class="flex min-h-[150px] items-start gap-4 py-6 group-[.collapsed]:hidden")
    .avatar(class="mt-1 flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/40 bg-white/15 shadow-inner")
      img.avatar-img(
        class="h-8 w-8 brightness-0 invert"
        src="/medico/img/icono-medico-avatar.svg"
        alt="Avatar médico"
      )
    div(class="min-w-0 flex-1")
      p.bienvenido-txt(class="text-sm leading-5 text-blue-100") Bienvenido
      h4(class="text-base leading-5 font-semibold text-white")= nombreMedico
      span(class="mt-1 inline-block rounded-full bg-white/15 px-2.5 py-1 text-xs leading-4 text-blue-50")= especialidadMedico
      button.btn-ver-perfil(
        class="mt-3 cursor-pointer rounded-lg border border-white/15 bg-white/15 px-3 py-1.5 text-xs font-medium leading-4 text-white transition-colors hover:bg-white/25"
        onclick="alert('Ir a: Mi Perfil')"
      ) Ver Mi Perfil

  hr.line-2(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20 group-[.collapsed]:hidden")

  nav(class="flex flex-col pt-4")
    a.nav-link.preActive(
      class="mb-2 flex h-12 items-center gap-3 rounded-xl px-3 py-2 text-[15px] font-medium text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.38)] [&.preActive]:!shadow-[inset_0_0_0_1px_rgba(255,255,255,0.14)]"
      href="#"
      onclick="cambiarVista(event,'agendaView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-agenda.svg"
        alt="Agenda"
      )
      .nav-item(class="group-[.collapsed]:hidden") Agenda

    a.nav-link(
      class="mb-2 flex h-12 items-center gap-3 rounded-xl px-3 py-2 text-[15px] font-medium text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.38)] [&.preActive]:!shadow-[inset_0_0_0_1px_rgba(255,255,255,0.14)]"
      href="#"
      onclick="cambiarVista(event,'pacientesView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-pacientes.svg"
        alt="Mis Pacientes"
      )
      .nav-item(class="group-[.collapsed]:hidden") Mis Pacientes

  hr.line-3(class="-mx-6 mt-auto w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20")

  form.logout(action="/auth/logout" method="POST")
    button(
      type="submit"
      aria-label="Cerrar sesión"
      class="flex min-h-[68px] w-full shrink-0 cursor-pointer items-center gap-3 border-0 bg-transparent px-1 text-white group-[.collapsed]:justify-center transition-opacity hover:opacity-75"
    )
      img.log-out(
        class="h-7 w-7 shrink-0 brightness-0 invert"
        src="/medico/img/icono-salir.svg"
        alt=""
      )
      span.sesionlogout(class="text-[16px] text-white group-[.collapsed]:hidden") Cerrar sesión
