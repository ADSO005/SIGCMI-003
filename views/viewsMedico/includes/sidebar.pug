aside#sidebar.sidebar.group(
  class="fixed top-0 left-0 z-[1000] flex h-screen w-[290px] flex-col overflow-hidden px-6 text-white shadow-xl [&.collapsed]:px-5 transition-all duration-300 ease-[ease] [&.collapsed]:w-[80px] [@media(max-width:768px)]:w-[280px] [@media(max-width:768px)]:-translate-x-full [@media(max-width:768px)]:transition-transform [@media(max-width:768px)]:ease-[cubic-bezier(0.4,0,0.2,1)] [@media(max-width:768px)]:[&.open]:translate-x-0"
  style="background:linear-gradient(180deg,#071b68 0%,#0b3294 54%,#09267a 100%);border-radius:0;"
)
  svg.sidebar-wave(aria-hidden="true" viewBox="0 0 290 220" preserveAspectRatio="none" style="position:absolute;top:78px;left:0;width:100%;height:220px;pointer-events:none;z-index:0;")
    path(d="M0 0h290v76c-34-8-73-4-114 18-62 33-111 46-176 13V0Z" fill="#1247b3" opacity=".58")
    path(d="M0 66c54 45 101 62 164 42 51-16 81-42 126-36" fill="none" stroke="#0d56cc" stroke-width="42" opacity=".78")
    path(d="M0 77c56 44 102 57 163 37 50-16 82-42 127-36" fill="none" stroke="#1686ff" stroke-width="16" opacity=".92")
  .logo(class="relative z-10 flex h-[82px] shrink-0 items-center justify-between px-1 group-[.collapsed]:justify-center group-[.collapsed]:px-0")
    img.logo-text(src="/medico/img/logo-sigcmi-blanco.png" alt="SIGCMI" class="max-w-full object-contain group-[.collapsed]:hidden" style="width:180px;height:auto")
    button#toggleBtn(
      class="flex h-10 w-10 shrink-0 items-center justify-center cursor-pointer border-0 bg-transparent text-[22px] text-white transition-transform duration-200 hover:scale-110"
      onclick="toggleSidebar()"
      aria-label="Abrir o cerrar menú"
    )
      svg(class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
        path(d="M4 6h16M4 12h16M4 18h16")

  .user(class="relative z-10 flex min-h-[150px] items-start gap-4 py-6 group-[.collapsed]:hidden")
    .avatar(class="mt-1 flex h-16 w-16 shrink-0 items-center justify-center rounded-full border border-white/40 bg-white/20 shadow-inner")
      img.avatar-img(
        class="h-9 w-9 brightness-0 invert"
        src="/medico/img/icono-medico-avatar.svg"
        alt="Avatar médico"
      )
    div(class="min-w-0 flex-1")
      p.bienvenido-txt(class="text-base leading-5 text-blue-100") Bienvenido
      h4(class="text-lg leading-6 font-bold text-white")= nombreMedico
      span(class="mt-2 inline-block rounded-full bg-white/20 px-3 py-1.5 text-sm leading-5 text-blue-50")= especialidadMedico
      a.btn-ver-perfil(
        href="/medico/perfil"
        aria-current=perfilActivo ? "page" : undefined
        class=`mt-3 inline-flex rounded-xl border border-white/30 px-4 py-2 text-sm font-semibold leading-5 text-white no-underline transition-colors hover:bg-white/25 ${perfilActivo ? "bg-white/25" : "bg-white/15"}`
      ) Ver Mi Perfil

  hr.line-2(class="relative z-10 -mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20 group-[.collapsed]:hidden")

  nav(class="relative z-10 mt-6 flex flex-col pt-4")
    if perfilActivo
      a.nav-link(class="mb-2 flex h-14 items-center gap-4 rounded-2xl px-4 py-2 text-base font-semibold text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0" href="/medico/dashboard")
        img(class="h-6 w-6 shrink-0 brightness-0 invert" src="/medico/img/icono-agenda.svg" alt="")
        .nav-item(class="group-[.collapsed]:hidden") Agenda
      a.nav-link(class="mb-2 flex h-14 items-center gap-4 rounded-2xl px-4 py-2 text-base font-semibold text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0" href="/medico/dashboard#pacientesView")
        img(class="h-6 w-6 shrink-0 brightness-0 invert" src="/medico/img/icono-pacientes.svg" alt="")
        .nav-item(class="group-[.collapsed]:hidden") Mis Pacientes
    else
      a.nav-link.preActive(
        class="mb-2 flex h-14 items-center gap-4 rounded-2xl bg-[#315bd7] px-4 py-2 text-base font-semibold text-white no-underline shadow-lg transition-colors hover:bg-[#315bd7] group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0"
        href="#"
        onclick="cambiarVista(event,'agendaView',this)"
      )
        img(class="h-6 w-6 shrink-0 brightness-0 invert" src="/medico/img/icono-agenda.svg" alt="")
        .nav-item(class="group-[.collapsed]:hidden") Agenda
      a.nav-link(
        class="mb-2 flex h-14 items-center gap-4 rounded-2xl px-4 py-2 text-base font-semibold text-white no-underline transition-colors hover:bg-white/10 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0"
        href="#"
        onclick="cambiarVista(event,'pacientesView',this)"
      )
        img(class="h-6 w-6 shrink-0 brightness-0 invert" src="/medico/img/icono-pacientes.svg" alt="")
        .nav-item(class="group-[.collapsed]:hidden") Mis Pacientes

  hr.line-3(class="relative z-10 -mx-6 mt-auto w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/20")

  form#formLogout.logout(class="relative z-10" action="/auth/logout" method="POST")
    button(
      type="submit"
      aria-label="Cerrar sesión"
      class="flex min-h-[68px] w-full shrink-0 cursor-pointer items-center gap-4 border-0 bg-transparent px-2 text-white group-[.collapsed]:justify-center transition-opacity hover:opacity-75"
    )
      img.log-out(
        class="h-8 w-8 shrink-0 brightness-0 invert"
        src="/medico/img/icono-salir.svg"
        alt=""
      )
      span.sesionlogout(class="text-lg font-semibold text-white group-[.collapsed]:hidden") Cerrar sesión
