aside#sidebar.sidebar.group(
  class="fixed top-0 left-0 z-[1000] flex h-screen w-[314px] flex-col bg-[#465DE5] px-6 text-white [&.collapsed]:px-5 transition-all duration-300 ease-[ease] [&.collapsed]:w-[80px] [@media(max-width:768px)]:w-[260px] [@media(max-width:768px)]:-translate-x-full [@media(max-width:768px)]:transition-transform [@media(max-width:768px)]:ease-[cubic-bezier(0.4,0,0.2,1)] [@media(max-width:768px)]:[&.open]:translate-x-0"
)
  .logo(class="flex h-16 shrink-0 items-center justify-between px-2 group-[.collapsed]:justify-center group-[.collapsed]:px-0")
    span.logo-text(class="text-[28px] leading-none font-bold group-[.collapsed]:hidden") SIGCMI
    button#toggleBtn(
      class="flex h-10 w-10 shrink-0 items-center justify-center cursor-pointer border-0 bg-transparent text-[22px] text-white transition-transform duration-200 hover:scale-110"
      onclick="toggleSidebar()"
      aria-label="Abrir o cerrar menú"
    ) ☰

  hr.line-1(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60")

  .user(class="flex min-h-[134px] items-start gap-[14px] py-6 group-[.collapsed]:hidden")
    .avatar(class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/20")
      img.avatar-img(
        class="h-5 w-5 brightness-0 invert"
        src="/medico/img/icono-medico-avatar.svg"
        alt="Avatar médico"
      )
    div(class="min-w-0 flex-1")
      p.bienvenido-txt(class="text-[13px] leading-4 text-white/65") Bienvenido
      h4(class="text-[15px] leading-5 font-normal text-white") montoyajuanes11
      span(class="block text-[11px] leading-[14px] text-white/65") Médico General
      button.btn-ver-perfil(
        class="mt-3 cursor-pointer rounded-md border-0 bg-white/20 px-[10px] py-1 text-[13px] leading-4 text-white transition-colors hover:bg-white/30"
        onclick="alert('Ir a: Mi Perfil')"
      ) Ver Mi Perfil

  hr.line-2(class="-mx-6 w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60 group-[.collapsed]:hidden")

  nav(class="flex flex-col pt-4")
    a.nav-link.preActive(
      class="mb-[6px] flex h-9 items-center gap-2 rounded-lg px-2 py-2 text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.35)]"
      href="#"
      onclick="cambiarVista(event,'agendaView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-agenda.svg"
        alt="Agenda"
      )
      .nav-item(class="group-[.collapsed]:hidden") Agenda

    a.nav-link(
      class="mb-[6px] flex h-9 items-center gap-2 rounded-lg px-2 py-2 text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 group-[.collapsed]:gap-0 [&.preActive]:!bg-[rgba(94,156,245,0.35)]"
      href="#"
      onclick="cambiarVista(event,'pacientesView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-pacientes.svg"
        alt="Mis Pacientes"
      )
      .nav-item(class="group-[.collapsed]:hidden") Mis Pacientes

  hr.line-3(class="-mx-6 mt-auto w-[calc(100%+48px)] shrink-0 border-0 border-t border-white/60")

  .logout(
    class="flex min-h-[58px] shrink-0 cursor-pointer items-center justify-left gap-3 group-[.collapsed]:justify-center transition-opacity hover:opacity-75"
    onclick="cerrarSesion()"
  )
    img.log-out(
      class="h-7 w-7 shrink-0 brightness-0 invert"
      src="/medico/img/icono-salir.svg"
      alt="Cerrar sesión"
    )
    span.sesionlogout(class="text-[16px] text-white group-[.collapsed]:hidden") Cerrar Sesión