extends ../layout/main

block append styles
  link(rel="stylesheet" href="/medico/css/dashboardMedical.css")

block content
  main#mainContent.main
    // VISTA: AGENDA
    section#agendaView.view.active
      header.header   
        div
          h1 Portal Médico
          span.fecha-header 3 de Abril del 2026
      section.cards
        .card
          p Citas Hoy
          .card-body
            .card-left
              h2 48
              span.card-sub 2 completadas
            .card-icon.icono-azul
              img(src='/medico/img/blueCalendar.png' alt='Citas')
        .card
          p Pacientes Activos
          .card-body
            .card-left
              h2 48
              span.card-sub +3 este mes
            .card-icon.icono-verde
              img(src='/medico/img/usderGreen.png' alt='Pacientes')
        .card
          p Consultas Esta Semana
          .card-body
            .card-left
              h2 48
              span.card-sub Promedio: 9/día
            .card-icon.icono-morado
              img(src='/medico/img/historyUser.png' alt='Consultas')
        .card
          p Tiempo Promedio
          .card-body
            .card-left
              h2 48
              span.card-sub Por consulta
            .card-icon.icono-naranja
              img(src='/medico/img/clockUserADMIN.png' alt='Tiempo')
      section.content
        // AGENDA DEL DÍA
        .appointments
          h3 Mi Agenda de hoy
          // Cita 1: Completada
          .appointment.estado-completada
            .left
              span.hour 09:00
              div
                h4 María González
                p Consulta de rutina
            .right
              span.state.greenState Completado
          // Cita 2: En curso
          #cita2.appointment.estado-encurso
            .left
              span.hour.hour-encurso 10:25
              div
                h4 María González
                p Consulta post-operatoria
            .right
              span.state.yellowState En curso
            .btn-full-row
              button.btn-consulta.btn-finalizar(onclick="finalizarConsulta('cita2')")
                | Finalizar
                | Consulta
          // Cita 3: Pendiente
          #cita3.appointment.estado-pendiente
            .left
              span.hour 10:00
              div
                h4 María González
                p Consulta post-operatoria
            .right
              span.state.greyState Pendiente
            .btn-full-row
              button.btn-consulta.btn-iniciar(onclick="iniciarConsulta('cita3')") Iniciar Consulta
        // ACCIONES RÁPIDAS
        .actions
          h3 Acciones Rápidas
          button.btnActions.btnActionBlue(onclick='abrirModal()') Gestionar Citas
          button.btnActions.btnActionGreen(onclick='abrirModalHorarios()') Configurar Horarios
          .proxima-cita
            .proxima-cita-header
              img.proxima-icon(src='/medico/img/Icon.png' alt='Reloj')
              span Próxima Cita
            .proxima-hora 11:00 AM
            .proxima-paciente Ana Rodríguez
            .proxima-motivo Medicina interna
    // fin agendaView

    section#pacientesView.view
      header.header
        div
          h1 Mis Pacientes
          span.fecha-header 3 de Abril del 2026
      .pacientes-layout
        // COLUMNA IZQUIERDA: lista
        .pacientes-lista
          .pacientes-search-box
            span.search-icon 🔍
            input(type='text' placeholder='Buscar paciente...' oninput='filtrarPacientes(this.value)')

          if pacientes && pacientes.length > 0
            each item in pacientes
              .paciente-item(
                data-id=item.paciente.id_paciente
                onclick='seleccionarPaciente(this)'
              )
                img(src='/medico/img/Group 16.png' alt='Paciente')
                div
                  h4= `${item.paciente.Usuario.nombres} ${item.paciente.Usuario.apellidos}`
                  span
                    img.NegroCalen(src='/medico/img/CalendarNegro.png' alt='Imagen Calendario')
                    |  #{item.cantidadCitas} citas
                span.paciente-arrow ›

          else
            p No hay pacientes registrados.
        // COLUMNA DERECHA: detalle
        .paciente-detalle
          .detalle-header
            img.detalle-avatar(
              src='/medico/img/Group 16.png'
              alt='Paciente'
            )

            .detalle-info
              h2#detalleNombre Selecciona un paciente

              p
                | Email: 
                a#detalleCorreo(href='#') -

              p
                | Teléfono: 
                span#detalleTelefono -

            .detalle-meta
              p
                | Edad: 
                span#detalleEdad -

              p
                | Última Visita: 
                span#detalleUltimaVisita -

          .detalle-badges
            span.badge.badge-blue
              img(
                src='/medico/img/CalendarPaciente.png'
                alt='Calendario'
              )
              |  Citas: 
              span#detalleCitas 0

            span.badge.badge-purple
              img(
                src='/medico/img/google-docs 2.png'
                alt='Diagnósticos'
              )
              |  Diagnósticos: 
              span#detalleDiagnosticos 0

          .historial
            h3 Historial Médico

            #historialPaciente
              p Selecciona un paciente para consultar su historial.
block scripts
  script(src="/medico/js/dashboardMedical.js")