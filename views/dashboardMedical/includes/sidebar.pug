aside#sidebar.sidebar.group(
  class="fixed top-0 left-0 z-[1000] flex h-screen w-[350px] flex-col bg-[#465DE5] p-5 text-white transition-all duration-300 [&.collapsed]:w-[80px]"
)
  .logo(class="flex items-center justify-between")
    span.logo-text(class="ml-[13px] text-[28px] font-bold group-[.collapsed]:hidden") SIGCMI
    button#toggleBtn(
      class="mb-5 cursor-pointer border-0 bg-transparent text-[28px] text-white transition-transform duration-200 hover:scale-110"
      onclick="toggleSidebar()"
      aria-label="Abrir o cerrar menú"
    ) ☰

  hr.line-1(class="-mx-5 mb-[15px] w-[calc(100%+40px)] border-0 border-t border-white/25")

  .user(class="mb-[15px] grid grid-cols-3 gap-1 group-[.collapsed]:hidden")
    .avatar(class="mb-[6px] flex h-[52px] w-[52px] items-center justify-center rounded-full bg-white/20")
      img.avatar-img(
        class="h-[28px] w-[28px] brightness-0 invert"
        src="/medico/img/icono-medico-avatar.svg"
        alt="Avatar médico"
      )
    div
      p.bienvenido-txt(class="text-[11px] uppercase tracking-[0.5px] text-white/65") Bienvenido
      h4(class="text-[13px] font-semibold text-white") montoyajuanes11
      span(class="text-[11px] text-white/65") Médico General
      button.btn-ver-perfil(
        class="mt-2 cursor-pointer rounded-md border border-white/35 bg-white/20 px-[14px] py-[5px] text-[12px] text-white transition-colors hover:bg-white/30"
        onclick="alert('Ir a: Mi Perfil')"
      ) Ver Mi Perfil

  hr.line-2(class="-mx-5 mb-[15px] w-[calc(100%+40px)] border-0 border-t border-white/25")

  nav(class="flex flex-col")
    a.nav-link.preActive(
      class="mb-[6px] flex h-[42px] items-center gap-[10px] rounded-lg p-[10px] text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 [&.preActive]:!bg-[rgba(94,156,245,0.35)]"
      href="#"
      onclick="cambiarVista(event,'agendaView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-agenda.svg"
        alt="Agenda"
      )
      .nav-item(class="group-[.collapsed]:hidden") Agenda

    a.nav-link(
      class="mb-[6px] flex h-[42px] items-center gap-[10px] rounded-lg p-[10px] text-[14px] text-white no-underline transition-colors hover:bg-white/15 group-[.collapsed]:w-10 group-[.collapsed]:mx-auto group-[.collapsed]:justify-center group-[.collapsed]:px-0 [&.preActive]:!bg-[rgba(94,156,245,0.35)]"
      href="#"
      onclick="cambiarVista(event,'pacientesView',this)"
    )
      img(
        class="h-[18px] w-[18px] shrink-0 brightness-0 invert"
        src="/medico/img/icono-pacientes.svg"
        alt="Mis Pacientes"
      )
      .nav-item(class="group-[.collapsed]:hidden") Mis Pacientes

  hr.line-3(class="!-mx-5 !mt-auto !w-[calc(100%+40px)] border-0 border-t border-white/25")

  .logout(
    class="mt-3 flex cursor-pointer items-center gap-2 transition-opacity hover:opacity-75"
    onclick="cerrarSesion()"
  )
    img.log-out(
      class="h-5 w-5 brightness-0 invert"
      src="/medico/img/icono-salir.svg"
      alt="Cerrar sesión"
    )
    span.sesionlogout(class="text-[14px] text-white/85 group-[.collapsed]:hidden") Cerrar Sesión