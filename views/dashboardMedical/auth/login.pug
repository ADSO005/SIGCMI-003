
extends ../layout/layout

block contenido
  main(class="min-h-screen bg-slate-100 flex items-center justify-center px-4 py-6 relative")

    //- Tarjeta Principal de Login
    div(class="bg-white rounded-3xl shadow-2xl max-w-lg w-full overflow-hidden")

      //- Encabezado
      div(class="p-4 text-center bg-blue-700")
        h1(class="text-4xl font-extrabold text-white") SIGCMI
        p(class="mt-2 text-white")
          | Sistema Integral de Gestión
          br
          | de Citas Médicas

      //- Formulario de Login
      div(class="p-8")
        h2(class="text-3xl font-bold text-center text-slate-800 mb-2") Iniciar Sesión
        p(class="text-center text-gray-500 mb-6") Ingresa a tu cuenta para continuar

        form(action="/login" method="POST" class="space-y-5")

          //- Correo electrónico
          div
            label(
              for="email"
              class="block text-sm font-medium text-slate-700 mb-2"
            ) Correo electrónico

            input(
              type="email"
              id="email"
              name="email"
              placeholder="correo@ejemplo.com"
              required
              autocomplete="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
            )

          //- Contraseña
          div
            label(
              for="password"
              class="block text-sm font-medium text-slate-700 mb-2"
            ) Contraseña

            input(
              type="password"
              id="password"
              name="password"
              placeholder="Ingresa tu contraseña"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
            )

          //- Botón iniciar sesión
          button(
            type="submit"
            class="w-full py-3 bg-blue-700 hover:bg-blue-800 text-white font-semibold rounded-xl transition duration-200"
          ) Iniciar Sesión

        //- Recuperar contraseña
        div(class="mt-6 text-center")
          button#openModalBtn(
            type="button"
            class="text-sm text-blue-600 hover:underline cursor-pointer"
          ) ¿Olvidaste tu contraseña?

        //- Registro
        div(class="mt-4 text-center")
          p(class="text-sm text-gray-500")
            | ¿No tienes una cuenta?
            a(
              href="/auth/register"
              class="ml-1 text-blue-600 font-semibold hover:underline"
            ) Regístrate

  //- Botón Flotante WhatsApp
  a(
    href="https://wa.me/573001234567?text=Hola,%20necesito%20ayuda."
    target="_blank"
    rel="noopener noreferrer"
    class="flex fixed bottom-6 right-6 w-16 h-16 bg-green-500 hover:bg-green-600 rounded-full shadow-lg items-center justify-center transition-all duration-300 hover:scale-110 z-40"
  )
    img(
      src="/img/WhatsApp.svg.png"
      alt="WhatsApp"
      class="w-8 h-8"
    )

  //- Modal recuperar contraseña
  div#recoverModal(
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4"
  )
    div(
      class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden"
    )

      //- Cabecera
      div(
        class="bg-indigo-600 px-5 py-4 flex justify-between items-center"
      )
        h3(class="text-sm font-semibold text-white") Recuperar Contraseña

        button#closeModalBtn(
          type="button"
          class="text-white text-xs font-bold cursor-pointer hover:opacity-80"
        ) X

      //- Formulario
      form(
        action="/auth/recover-password"
        method="POST"
        class="p-5 space-y-4"
      )
        p(class="text-xs text-gray-500 leading-relaxed")
          | Ingresa tu correo electrónico y te enviaremos un código de verificación para restablecer tu contraseña.

        div
          input(
            type="email"
            name="email"
            placeholder="correo@ejemplo.com"
            required
            class="w-full px-3 py-2 text-sm border border-gray-300 rounded-xl bg-blue-50 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          )

        div(class="flex items-center justify-end space-x-2 pt-2")
          button#cancelModalBtn(
            type="button"
            class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs font-medium rounded-xl cursor-pointer"
          ) Cancelar

          button(
            type="submit"
            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-xl cursor-pointer"
          ) Enviar Código

  script(src="/medico/js/recoverPassword.js")
